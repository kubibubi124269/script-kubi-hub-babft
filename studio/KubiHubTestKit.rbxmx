 end
 function UI:create(class,props,parent)
  local o=Instance.new(class);for k,v in pairs(props) do if k=='PlaceholderText' or k=='Text' and class~='TextBox' then v=self:t(v)end;o[k]=v end;self.order=self.order+1;if o:IsA('GuiObject') then o.LayoutOrder=self.order end;o.Parent=parent;return o
 end
 function UI:t(text)return M.Locale.text(self.app.language,text)end
 function UI:bind(signal,fn,list)
  local c=self.app.runtime:connect(signal,fn,'GUI');if list then self.listConnections[#self.listConnections+1]=c end;return c
 end
 function UI:corner(o,r)self:create('UICorner',{CornerRadius=UDim.new(0,r)},o)end
 function UI:isPress(i)return i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch end
 function UI:rememberPosition()
  local c=workspace.CurrentCamera;if c then self.app.config.data.ui.x=math.clamp(self.frame.AbsolutePosition.X/c.ViewportSize.X,0,.95);self.app.config.data.ui.y=math.clamp(self.frame.AbsolutePosition.Y/c.ViewportSize.Y,0,.95) end
 end
 function UI:fit()
  local c=workspace.CurrentCamera;if not c then return end;local v=c.ViewportSize;local s=self.app.config.data.ui;local b=M.Layout.compute(v.X,v.Y,s.width,s.height,s.compact,#self.navigation.order);self.layout=b
  self.frame.Size=UDim2.fromOffset(b.width,b.height);self.frame.Position=UDim2.fromOffset(math.clamp(s.x*v.X,4,math.max(4,v.X-b.width-4)),math.clamp(s.y*v.Y,4,math.max(4,v.Y-b.height-4)))
  self.title.TextSize=b.width&lt;420 and 13 or 19;self.subtitle.TextSize=b.width&lt;420 and 9 or 11
  self.nav.Position=UDim2.fromOffset(12,80);self.nav.Size=UDim2.fromOffset(b.navWidth,b.navHeight)
  self.nav.ScrollingEnabled=true;self.nav.AutomaticCanvasSize=Enum.AutomaticSize.Y;self.nav.CanvasSize=UDim2.new()
  self.navLayout.FillDirectionMaxCells=b.navColumns;self.navLayout.CellSize=UDim2.fromOffset(b.navCellWidth,b.navCellHeight)
  for _,button in pairs(self.buttons) do button.Size=UDim2.fromOffset(b.navCellWidth,b.navCellHeight);button.TextSize=b.width&lt;420 and 10 or 12 end
  self.search.Position=UDim2.fromOffset(b.contentX,b.contentY);self.search.Size=UDim2.fromOffset(b.contentWidth,32)
  self.content.Position=UDim2.fromOffset(b.contentX,b.contentY+42);self.content.Size=UDim2.fromOffset(b.contentWidth,math.max(40,b.contentHeight-42))
 end
 function UI:page(id,title)
  id=self.navigation.resolve(id);title=self.navigation.titles[id] or title
  if self.pages[id] then return self.pages[id] end
  local page=self:create('ScrollingFrame',{Name=id,Size=UDim2.fromScale(1,1),BackgroundTransparency=1,BorderSizePixel=0,ScrollBarThickness=3,CanvasSize=UDim2.new(),AutomaticCanvasSize=Enum.AutomaticSize.Y,Visible=false},self.content)
  self:create('UIListLayout',{Padding=UDim.new(0,12),SortOrder=Enum.SortOrder.LayoutOrder},page)
  self.pages[id]=page;self.buttons[id]=self:button(self.nav,title,function()self:show(id)end,nil,false);self.buttons[id].LayoutOrder=self.navigation.rank(id);self:fit();return page
 end
 function UI:show(id)
  self:closeSettings()
  local target=self.routes[id];id=self.navigation.resolve(id)
  if not self.pages[id] then return end
  if self.search.Text~='' then self.search.Text='' end;self.results.Visible=false
  self.scrollTarget=nil;self.current=id;for name,page in pairs(self.pages) do page.Visible=name==id;self.buttons[name].BackgroundColor3=self.palette.bg;self.buttons[name].TextColor3=name==id and self.palette.accent or self.palette.text;local stroke=self.buttons[name]:FindFirstChild('NavStroke');if stroke then stroke.Color=name==id and self.palette.accent or self.palette.card end end
  if target then self:scrollTo(self.cardBodies[target]) end
 end
 function UI:scrollTo(record)
  if not record then return end;record.open(true);self.scrollTarget=record
 end
 function UI:reveal(body)
  local record=self.cardBodies[body];if not record then return end;self:show(record.page);self:scrollTo(record)
 end
 function UI:hide()self:closeSettings();self.frame.Visible=false;self.bubble.Visible=true;self.tooltip.Visible=false end
 function UI:label(parent,text,height)
  return self:create('TextLabel',{Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,BackgroundTransparency=1,Text=text,TextColor3=self.palette.text,TextWrapped=true,Font=Enum.Font.Gotham,TextSize=13,TextXAlignment=Enum.TextXAlignment.Left,TextYAlignment=Enum.TextYAlignment.Top},parent)
 end
 function UI:card(page,title,description)
  local card=self:create('Frame',{Size=UDim2.new(1,-5,0,0),AutomaticSize=Enum.AutomaticSize.Y,BackgroundColor3=self.palette.card,BorderSizePixel=0},page);self:corner(card,11)
  self:create('UIPadding',{PaddingLeft=UDim.new(0,13),PaddingRight=UDim.new(0,13),PaddingTop=UDim.new(0,10),PaddingBottom=UDim.new(0,12)},card);self:create('UIListLayout',{Padding=UDim.new(0,8),SortOrder=Enum.SortOrder.LayoutOrder},card)
  local heading=self:button(card,title,function()end)
  local body=self:create('Frame',{Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,BackgroundTransparency=1},card)
  self:create('UIListLayout',{Padding=UDim.new(0,8),SortOrder=Enum.SortOrder.LayoutOrder},body)
  local record={outer=card,body=body,title=title,page=page.Name,terms=title..' '..self:t(title)..' '..(description or '')};self.cards[#self.cards+1]=record;self.cardBodies[body]=record
  local function open(value)body.Visible=value;heading.Text=(value and '[-]  ' or '[+]  ')..self:t(title) end;record.open=open
  self:bind(heading.Activated,function()open(not body.Visible)end)
  open(not self.firstCard[page.Name]);self.firstCard[page.Name]=true
  if description then self:settingsFor(heading,title,function(panel)self:label(panel,description)end) end
  record.result=self:button(self.results,self:t(self.navigation.titles[page.Name] or page.Name)..'  /  '..self:t(title),function()self:reveal(body)end)
  return body
 end
 function UI:searchCards()
  self:closeSettings()
  if not self.search then return end;local query=self.search.Text
  if query:match('^%s*$') then self.results.Visible=false;for id,page in pairs(self.pages) do page.Visible=id==self.current end;return end
  for _,page in pairs(self.pages) do page.Visible=false end;self.results.Visible=true
  for _,record in ipairs(self.cards) do record.result.Visible=self.navigation.matches(query,record.terms) end
 end
 function UI:rememberTerm(parent,text)
  local at=parent;while at and at~=self.content do local r=self.cardBodies[at];if r then r.terms=r.terms..' '..tostring(text)..' '..tostring(self:t(text));return end;at=at.Parent end
 end
 function UI:button(parent,text,fn,tip,list)
  if not list then self:rememberTerm(parent,text) end
  local b=self:create('TextButton',{Size=UDim2.new(1,0,0,38),BackgroundColor3=self.palette.panel,Text=text,TextColor3=self.palette.text,TextSize=12,TextWrapped=true,Font=Enum.Font.GothamBold,BorderSizePixel=0},parent);self:corner(b,8)
  if parent==self.nav then self:create('UIStroke',{Name='NavStroke',Color=self.palette.card,Thickness=1,ApplyStrokeMode=Enum.ApplyStrokeMode.Border},b) end
  self:bind(b.Activated,function()self.app:run(self.current or 'GUI',fn)end,list)
  if tip then self:bind(b.MouseEnter,function()if self.app.config.data.ui.tooltips then self.tooltip.Text=tip;local p=self.app.input:GetMouseLocation();local v=workspace.CurrentCamera.ViewportSize;self.tooltip.Position=UDim2.fromOffset(math.clamp(p.X,0,math.max(0,v.X-290)),math.clamp(p.Y-82,0,math.max(0,v.Y-80)));self.tooltip.Visible=true end end,list);self:bind(b.MouseLeave,function()self.tooltip.Visible=false end,list) end
  return b
 end
 function UI:closeSettings()
  if self.activeSettings then self.activeSettings.Visible=false;self.activeSettings=nil end
  self.sliderDrag=nil
 end
 function UI:settingsFor(button,title,build)
  self.featureSettings=self.featureSettings or {};local entry={button=button,title=title,build=build};self.featureSettings[#self.featureSettings+1]=entry
  local function open()
   self:closeSettings();self.tooltip.Visible=false
   if not entry.panel then
    local panel=self:create('Frame',{Name='FeatureSettings',Size=UDim2.fromScale(1,1),BackgroundColor3=self.palette.bg,BorderSizePixel=0,Active=true,ZIndex=20},self.content);self:corner(panel,10)
    local back=self:button(panel,'‹  Wróć',function()self:closeSettings()end);back.Size=UDim2.new(1,0,0,34)
    local label=self:label(panel,title);label.Position=UDim2.fromOffset(8,43);label.Size=UDim2.new(1,-16,0,0);label.TextSize=15;label.Font=Enum.Font.GothamBold
    local body=self:create('ScrollingFrame',{Position=UDim2.fromOffset(8,76),Size=UDim2.new(1,-16,1,-84),BackgroundTransparency=1,BorderSizePixel=0,ScrollBarThickness=3,CanvasSize=UDim2.new(),AutomaticCanvasSize=Enum.AutomaticSize.Y},panel)
    self:create('UIListLayout',{Padding=UDim.new(0,8),SortOrder=Enum.SortOrder.LayoutOrder},body);build(body)
    entry.panel=panel;entry.body=body
   end
   self:refreshControls();entry.panel.Visible=true;self.activeSettings=entry.panel
  end
  entry.open=open
  self:bind(button.InputBegan,function(input)if input.UserInputType==Enum.UserInputType.MouseButton2 then open() end end)
  return entry
 end
 function UI:feature(parent,title,get,action,build)
  local row=self:create('Frame',{Size=UDim2.new(1,0,0,40),BackgroundTransparency=1},parent)
  local b=self:button(row,title,action);b.Size=UDim2.new(1,-38,1,0);self:rememberTerm(parent,title)
  local function refresh()b.Text=self:t(title)..(get and ('  '..(get() and 'ON' or 'OFF')) or '');b.TextColor3=get and get() and self.palette.accent or self.palette.text end
  self.featureRefreshers=self.featureRefreshers or {};self.featureRefreshers[#self.featureRefreshers+1]=refresh;self.refreshers[#self.refreshers+1]=refresh;refresh();self:bind(b.Activated,refresh)
  if build then local entry=self:settingsFor(b,title,build);local gear=self:button(row,'⋯',entry.open);gear.Position=UDim2.new(1,-34,0,0);gear.Size=UDim2.fromOffset(34,40);self:bind(gear.InputBegan,function(input)if input.UserInputType==Enum.UserInputType.MouseButton2 then entry.open() end end) end
  return b
 end
 function UI:field(parent,title,initial,fn,multiline,get)
  self:rememberTerm(parent,title)
  self:label(parent,title,26)
  local box=self:create('TextBox',{Size=UDim2.new(1,0,0,multiline and 140 or 35),BackgroundColor3=self.palette.bg,BorderSizePixel=0,Text=tostring(initial or ''),PlaceholderText=title,TextColor3=self.palette.text,PlaceholderColor3=self.palette.muted,TextSize=12,Font=multiline and Enum.Font.Code or Enum.Font.Gotham,TextWrapped=true,ClearTextOnFocus=false,MultiLine=multiline==true,TextXAlignment=Enum.TextXAlignment.Left,TextYAlignment=multiline and Enum.TextYAlignment.Top or Enum.TextYAlignment.Center},parent);self:corner(box,7)
  if fn then self:bind(box.FocusLost,function()self.app:run('GUI',function()local value,err=fn(box.Text);if value==false then if get then box.Text=tostring(get()) end;return false,err end;if value~=nil then box.Text=tostring(value) end end)end) end
  if get then local function refresh()box.Text=tostring(get())end;refresh();self.refreshers[#self.refreshers+1]=refresh end;return box
 end
 function UI:cycle(parent,title,values,get,set)
  self:rememberTerm(parent,title)
  local function text()return self:t(title)..': '..tostring(self:t(get()))end
  local button
  button=self:button(parent,text(),function()local at=1;for i,v in ipairs(values) do if v==get() then at=i%#values+1;break end end;local ok,err=set(values[at]);button.Text=text();return ok,err end)
  self.refreshers[#self.refreshers+1]=function()button.Text=text()end
  return button
 end
 function UI:toggle(parent,title,get,set)
  local b
  local function text()return self:t(title)..': '..(get() and 'ON' or 'OFF')end
  b=self:button(parent,'',function()local ok,err=set(not get());b.Text=text();return ok,err end);b.Text=text()
  self.refreshers[#self.refreshers+1]=function()b.Text=text()end;return b
 end
 function UI:slider(parent,title,get,set,lo,hi,step)
  title=self:t(title)
  local label=self:label(parent,title..': '..tostring(get()),30)
  local track=self:create('Frame',{Size=UDim2.new(1,0,0,22),BackgroundColor3=self.palette.bg,BorderSizePixel=0,Active=true},parent);self:corner(track,7)
  local fill=self:create('Frame',{Size=UDim2.new((get()-lo)/(hi-lo),0,1,0),BackgroundColor3=self.palette.accent,BorderSizePixel=0},track);self:corner(fill,7)
  local d={track=track,fill=fill,label=label,title=title,set=set,lo=lo,hi=hi,step=step or 1}
  self:bind(track.InputBegan,function(input)if self:isPress(input) then self.sliderDrag=d;self:setSliderFromInput(input.Position.X) end end)
  local box=self:field(parent,'Wartość liczbowa',get(),function(value)local v=M.Util.number(tonumber(value),get(),lo,hi);set(v);fill.Size=UDim2.new((v-lo)/(hi-lo),0,1,0);label.Text=title..': '..string.format('%.1f',v);return v end)
  self.refreshers[#self.refreshers+1]=function()local v=get();box.Text=tostring(v);fill.Size=UDim2.new((v-lo)/(hi-lo),0,1,0);label.Text=title..': '..string.format('%.1f',v)end
 end
 function UI:setSliderFromInput(x)
  local d=self.sliderDrag;if not d then return end;local f=math.clamp((x-d.track.AbsolutePosition.X)/math.max(1,d.track.AbsoluteSize.X),0,1);local value=math.clamp(math.floor((d.lo+f*(d.hi-d.lo))/d.step+.5)*d.step,d.lo,d.hi);d.set(value);d.fill.Size=UDim2.new((value-d.lo)/(d.hi-d.lo),0,1,0);d.label.Text=d.title..': '..string.format('%.1f',value)
 end
 function UI:clearList(parent)
  for _,c in ipairs(self.listConnections) do self.app.runtime:disconnect(c) end;self.listConnections={}
  for _,o in ipairs(parent:GetChildren()) do if o:IsA('GuiObject') then o:Destroy() end end
 end
 function UI:theme()
  self.palette.accent=self.app.config.data.ui.theme=='PURPLE' and Color3.fromRGB(156,103,247) or Color3.fromRGB(83,133,247);self.bubble.BackgroundColor3=self.palette.accent;self:show(self.current or 'HOME')
 end
 function UI:refreshFeatures()for _,fn in ipairs(self.featureRefreshers or {}) do fn()end end
 function UI:refreshControls()for _,fn in ipairs(self.refreshers) do fn()end end
 function UI:clearNotification()
  if self.notificationConnection then self.app.runtime:disconnect(self.notificationConnection);self.notificationConnection=nil end
  if self.notification then self.notification:Destroy();self.notification=nil end
 end
 function UI:toast(module,message,bad)
  local full='['..module..'] '..tostring(self:t(message))
  if self.statusInfo then self.statusInfo.Text=full end
  local compact=full:gsub('%s+',' ')
  self.footer.Text=compact;self.footer.TextColor3=bad and self.palette.red or self.palette.muted
  local preview=compact
  -- Keep the notification bounded without cutting a Polish UTF-8 character in half.
  local valid,cut=pcall(utf8.offset,compact,221)
  if valid and cut then preview=compact:sub(1,cut-1)..'…' elseif not valid then preview='['..module..'] Kliknij, aby odczytać pełną treść.' end
  self:clearNotification()
  local camera=workspace.CurrentCamera;local width=math.max(120,math.min(340,(camera and camera.ViewportSize.X or 364)-24))
  self.notification=self:create('TextButton',{Name='Notification',AnchorPoint=Vector2.new(1,1),Size=UDim2.new(0,width,0,0),AutomaticSize=Enum.AutomaticSize.Y,Position=UDim2.new(1,-12,1,-18),BackgroundColor3=self.palette.panel,Text=preview..'\n'..self:t('Kliknij po szczegóły.'),TextColor3=bad and self.palette.red or self.palette.text,TextWrapped=true,TextSize=13,Font=Enum.Font.Gotham,TextXAlignment=Enum.TextXAlignment.Left,BorderSizePixel=0,ZIndex=80},self.gui);self:corner(self.notification,10)
  self.notificationConnection=self:bind(self.notification.Activated,function()self.frame.Visible=true;self.bubble.Visible=false;if self.statusBody then self:reveal(self.statusBody) else self:show('DEBUG') end end)
  self:create('UIPadding',{PaddingLeft=UDim.new(0,12),PaddingRight=UDim.new(0,12),PaddingTop=UDim.new(0,10),PaddingBottom=UDim.new(0,10)},self.notification);self.notifyUntil=self.app.clock()+5
 end
 function UI:tick()
  if self.notification and self.app.clock()&gt;=self.notifyUntil then self:clearNotification() end
  if self.scrollTarget then local r=self.scrollTarget;self.scrollTarget=nil;local page=self.pages[r.page];page.CanvasPosition=Vector2.new(0,math.max(0,r.outer.AbsolutePosition.Y-page.AbsolutePosition.Y+page.CanvasPosition.Y)) end
 end
 return UI
end
end)()(M)

