-- SOURCE: src/schematics/WormMK2.lua
M.WormMK2=(function()
return function(Schema)
 local function create()
  local s={schemaVersion=2,id='WORM_MK2',name='WORM MK2 — rig testowy',category='WORMS',elements={},connections={},mechanical=true,root='body_1',driver='driver',rig='worm_mk2'}
  local red,white={.84,.025,.045},{.96,.96,.89}
  local function part(id,name,material,pos,size,rot,class,layer,color)
   s.elements[#s.elements+1]={id=id,name=name,material=material,position=pos,size=size,rotation=rot or {0,0,0},class=class or 'Part',layer=layer or 0,color=color or red}
  end
  local function weld(a,b) s.connections[#s.connections+1]={id='weld_'..#s.connections,a=a,b=b,kind='Weld'} end
  local function hinge(id,a,b,pivot,axis,role,lower,upper)
   s.connections[#s.connections+1]={id=id,a=a,b=b,kind='Hinge',pivot=pivot,axis=axis,lower=lower or -22,upper=upper or 22,role=role}
  end
  for i=1,9 do
   part('body_'..i,'Segment '..i,'MetalBlock',{0,6,(i-1)*7},{6,5,6},nil,nil,i)
   if i&gt;1 then hinge('spine_'..i,'body_'..(i-1),'body_'..i,{0,6,(i-1)*7-3.5},{0,1,0},'spine') end
   for _,side in ipairs({-1,1}) do local id='ridge_'..i..'_'..(side+2);part(id,'Pancerz segmentu '..i,'PlasticBlock',{side*3.5,6,(i-1)*7},{1,3,4},nil,nil,i);weld('body_'..i,id) end
  end
  part('head','Głowa','MetalBlock',{0,6,-7},{6,6,6},nil,nil,10)
  hinge('neck','body_1','head',{0,6,-3.5},{0,1,0},'neck',-18,18)
  part('driver','Fotel kierowcy','CarSeat',{0,9.5,1},{2,1.5,2},nil,'VehicleSeat',1,{.12,.12,.16});weld('body_1','driver')
  for i=1,5 do
   local a=(i-1)*math.pi*2/5+math.pi/2;local c,n=math.cos(a),math.sin(a);local id='petal_'..i
   part(id,'Płat paszczy '..i,'PlasticBlock',{c*6,6+n*6,-10},{3,6,1.2},{0,0,math.deg(a)-90},'WedgePart',11)
   hinge('mouth_'..i,'head',id,{c*3,6+n*3,-10},{-n,c,0},'mouth',-5,65)
   for j=1,3 do
    local r=3.7+j*1.25;local tooth='tooth_'..i..'_'..j
    part(tooth,'Ząb '..i..'.'..j,'PlasticBlock',{c*r,6+n*r,-10.9},{.7,1.4,.7},{0,0,math.deg(a)-90},'WedgePart',11,white);weld(id,tooth)
   end
  end
  local valid,errors=Schema.validate(s);assert(valid,table.concat(errors,'; '));return valid
 end
 return create
end
end)()(M.Schema)

-- SOURCE: src/schematics/DynamiteStack.lua
M.DynamiteStack=(function()
return function(Schema)
 local function create(count)
  assert(type(count)=='number' and count&gt;=1 and count&lt;=3000 and count%1==0,'Stos: 1–3000 drewnianych bloków.')
  local s={schemaVersion=2,id='DYNAMITE_STACK',name='Dynamit + stos '..count..' drewna',category='Proste budowle',elements={},connections={},mechanical=false,assistantOnly=true,intentionalOverlap=true}
  local function add(id,name,material,pos,size,class,color)
   s.elements[#s.elements+1]={id=id,name=name,material=material,position=pos,size=size or {2,2,2},rotation={0,0,0},layer=material=='WoodBlock' and 1 or 0,class=class or 'Part',color=color}
  end
  add('dynamite','Laska dynamitu','Dynamite',{0,1,0},{.7,3,.7},nil,{.9,.05,.04})
  add('seat','Jedyne siedzenie','Seat',{0,1,2},{2,1,2},'Seat',{.2,.2,.2})
  s.connections[1]={id='seat_to_dynamite',a='dynamite',b='seat',kind='Weld'}
  for i=1,count do add('wood_'..i,'Drewno w stosie '..i,'WoodBlock',{0,4,0}) end
  -- Deliberate overlap is represented as data. This assistant does not detonate explosives or flood a public server.
  return Schema.validate(s)
 end
 return create
end
end)()(M.Schema)

-- SOURCE: src/schematics/Library.lua
M.Library=(function()
return function(Util,Schema,LegacyShapes,LegacyPlans,WormMK2,DynamiteStack)
 local Library={};Library.__index=Library
 function Library.new()
  local self=setmetatable({items={},custom={},errors={},revision=0},Library)
  local plans,assets=LegacyPlans(LegacyShapes);self.assets=assets
  local groups={SPEEDBOAT='Łodzie',RAFT='Łodzie',SUBMARINE='Łodzie',HOVERCRAFT='Łodzie',JET='Samoloty',SPACESHIP='Samoloty',UFO='Samoloty',['MINI TANK']='Pojazdy',WORM='WORMS'}
  for _,name in ipairs(Util.keys(plans)) do
   if #plans[name]&gt;0 and name~='TNT_STACK' then
    local id='legacy_'..name:gsub(' ','_');local value,errors=Schema.fromLegacy(id,name,plans[name],groups[name])
    if value then value.legacy=true;self.items[id]=value else self.errors[#self.errors+1]=name..': '..table.concat(errors,'; ') end
   end
  end
  self.items.WORM_MK2=WormMK2();self.items.DYNAMITE_STACK=assert(DynamiteStack(3000))
  return self
 end
 function Library:list(query,category,sort,favorites,onlyFavorites)
  local out={};query=(query or ''):lower();favorites=favorites or {}
  for _,item in pairs(self.items) do if (not category or category=='Wszystkie' or item.category==category) and (not onlyFavorites or favorites[item.id]) and (item.name:lower():find(query,1,true) or item.id:lower():find(query,1,true)) then out[#out+1]=item end end
  table.sort(out,function(a,b)if sort=='Bloki' and #a.elements~=#b.elements then return #a.elements&lt;#b.elements end;return a.name&lt;b.name end);return out
 end
 function Library:save(raw)
  local item,errors=Schema.validate(raw);if not item then return false,table.concat(errors,'; ') end
  if self.items[item.id] and not self.custom[item.id] then return false,'Wbudowany schemat wymaga nowego identyfikatora przy zapisie.' end
  item.category='Własne projekty';self.items[item.id]=item;self.custom[item.id]=true;self.revision=self.revision+1;return true,item
 end
 return Library
end
end)()(M.Util,M.Schema,M.LegacyShapes,M.LegacyPlans,M.WormMK2,M.DynamiteStack)

-- SOURCE: src/core/Adapter.lua
M.Adapter=(function()
return function(Util)
 local Adapter={};Adapter.__index=Adapter
 function Adapter.new(context)
  return setmetatable({context=context,capabilities={},pending=nil,serial=0,session=nil,zone=nil,label='Asystent — brak autoryzowanego adaptera',chunkSize=16,minFarmInterval=0,lastLatency=nil},Adapter)
 end
 function Adapter:newId(prefix)self.serial=self.serial+1;return prefix..'_'..self.context.userId..'_'..self.serial..'_'..math.floor(self.context.clock()*1000) end
 function Adapter:call(kind,payload)
  if not self.remote then return {ok=false,error='Brak autoryzowanego adaptera.'} end
  if self.pending then return {ok=false,error='Poprzednie żądanie adaptera nadal trwa. Nie ponawiam automatycznie.'} end
  local ticket={done=false};self.pending=ticket;local started=self.context.clock()
  local packet={protocol=1,session=self.session,id=self:newId(kind),kind=kind,payload=payload or {}}
  self.context.spawn(function()
   ticket.ok,ticket.result=pcall(function()return self.remote:InvokeServer(packet)end);ticket.done=true
   if self.pending==ticket then self.pending=nil end
  end)
  while not ticket.done and self.context.clock()-started&lt;5 and self.context.alive() do self.context.wait(.025) end
  if not ticket.done then return {ok=false,error='Adapter: timeout. Żądanie może nadal kończyć się na serwerze; czekam przed następnym.'} end
  self.lastLatency=(self.context.clock()-started)*1000
  if not ticket.ok then return {ok=false,error=tostring(ticket.result)} end
  if type(ticket.result)~='table' or type(ticket.result.ok)~='boolean' then return {ok=false,error='Nieprawidłowa odpowiedź adaptera.'} end
  return ticket.result
 end
 function Adapter:connect(replica)
  local r=replica:FindFirstChild('KubiHubAuthorizedBridgeV1');local cancel=replica:FindFirstChild('KubiHubCancelV1')
  if not r or not r:IsA('RemoteFunction') or not cancel or not cancel:IsA('RemoteEvent') then return false,self.label end
  self.remote=r;self.cancelRemote=cancel;local reply=self:call('hello')
  if not reply.ok or reply.authorized~=true or reply.userId~=self.context.userId or reply.placeId~=self.context.placeId or reply.protocol~=1 or type(reply.session)~='string' then self.remote=nil;return false,reply.error or 'Serwer nie potwierdził uprawnień.' end
  self.session=reply.session;self.capabilities={};for _,cap in ipairs({'build','mechanics','inventory','farm','movement'}) do self.capabilities[cap]=type(reply.capabilities)=='table' and reply.capabilities[cap]==true end
  if type(reply.zone)=='table' and Util.vector(reply.zone.size,10000) and reply.zone.size[1]&gt;0 and reply.zone.size[2]&gt;0 and reply.zone.size[3]&gt;0 then
   self.zone={size=Util.copy(reply.zone.size)}
   if Util.vector(reply.zone.min,10000) and Util.vector(reply.zone.max,10000) then local valid=true;for i=1,3 do if reply.zone.min[i]&gt;=reply.zone.max[i] then valid=false end end;if valid then self.zone.min=Util.copy(reply.zone.min);self.zone.max=Util.copy(reply.zone.max) end end
  end
  self.minFarmInterval=Util.number(reply.minFarmInterval,.5,.1,10);self.label=tostring(reply.label or 'Autoryzowany adapter'):sub(1,120);return true
 end
 function Adapter:cancel(transaction)
  if self.session and self.cancelRemote then self.cancelRemote:FireServer({protocol=1,session=self.session,transaction=transaction or 'all'}) end
 end
 function Adapter:inventory()return self:call('inventory')end
 function Adapter:beginBuild(id,schema,yaw)return self:call('beginBuild',{id=id,schema=schema,yaw=yaw})end
 function Adapter:placeChunk(id,first,count)return self:call('placeChunk',{transaction=id,first=first,count=count})end
 function Adapter:commitBuild(id)return self:call('commitBuild',{transaction=id})end
 function Adapter:buildStatus(id,cancel)return self:call('buildStatus',{transaction=id,cancel=cancel==true})end
 function Adapter:farmStep(stage)return self:call('farmStep',{stage=stage})end
 function Adapter:movement(values)return self:call('movement',values)end
 function Adapter:rig(action)return self:call('rig',{action=action})end
 function Adapter:snapshot()return self:call('snapshot')end
 return Adapter
end
end)()(M.Util)

-- SOURCE: src/core/BabftAdapter.lua
M.BabftAdapter=(function()
return function(Util,Schema,Inventory)
 local B={};B.__index=B
 function B.new(context,platform)
  return setmetatable({context=context,platform=platform,mode='BABFT',capabilities={},serial=0,pending=nil,transactions={},chunkSize=1,minFarmInterval=.3,label='BABFT — oczekiwanie na test narzędzia',buildVerified=false},B)
 end
 function B:newId(prefix)self.serial+=1;return prefix..'_'..self.context.userId..'_'..self.serial end
 function B:connect()
  local info=self.platform:inspect();self.zone=info.zone;self.diagnostics=info.text;self.farmReason=info.farmReason
  self.capabilities={build=self.buildVerified and info.build,inventory=true,mechanics=false,movement=false,farm=info.farm==true}
  self.label=self.buildVerified and 'BABFT — test bloku potwierdzony' or info.farm and 'BABFT — trasa autofarmy dostępna' or 'BABFT — sprawdź działkę i trasę'
  self.toolAvailable=info.build==true;return self.toolAvailable or self.capabilities.farm,self.diagnostics
 end
 function B:invoke(remote,args)
  if self.pending then return {ok=false,error='Poprzednie żądanie narzędzia nadal trwa. Nie ponawiam go.'} end
  local job={done=false};self.pending=job;local start=self.context.clock()
  self.context.spawn(function()job.ok,job.value=pcall(function()return remote:InvokeServer(table.unpack(args,1,args.n or #args))end);job.done=true;if self.pending==job then self.pending=nil end end)
  while not job.done and self.context.alive() and self.context.clock()-start&lt;7 do self.context.wait(.03) end
  self.lastLatency=(self.context.clock()-start)*1000
  if not job.done then return {ok=false,error='Narzędzie nie odpowiedziało w 7 s. Żądanie może jeszcze postawić blok; nie ponawiam.'} end
  if not job.ok or job.value==false then return {ok=false,error=job.ok and 'Narzędzie odrzuciło żądanie.' or tostring(job.value)} end
  return {ok=true,value=job.value}
 end
 function B:inventory()return {ok=true,values=self.platform:inventory(),source='BABFT / odczyt danych gracza'} end
 function B:testBuild()
  for _,tx in pairs(self.transactions) do if tx.state=='building' then return {ok=false,error='Zakończ bieżącą budowę przed testem.'} end end
  if self.pending then return {ok=false,error='Poprzednie żądanie jeszcze trwa.'} end
  self:connect();if not self.toolAvailable then return {ok=false,error=self.diagnostics} end
  local e={id='probe',material='WoodBlock',class='Part',position={0,2,0},rotation={0,0,0},size={2,2,2}}
  local ok,err=self.platform:preflight({elements={e}},0);if not ok then return {ok=false,error=err} end
  local generation=self.probeGeneration or 0
  local function cancelled()return not self.context.alive() or generation~=(self.probeGeneration or 0) end
  local result=self.platform:place(e,0,function(remote,args)return self:invoke(remote,args)end,cancelled)
  if cancelled() then return {ok=false,error='Test zatrzymany. Wysłany wcześniej blok może pozostać na działce.'} end
  if not result.ok then self.buildVerified=false;self.capabilities.build=false;return result end
  self.buildVerified=true;self.capabilities.build=true;self.label='BABFT — test bloku potwierdzony'
  return {ok=true,message='Test potwierdzony: jeden drewniany blok jest w Twojej budowli. Możesz uruchomić BUILD dla planów statycznych. Blok testowy pozostaje na działce.'}
 end
 function B:beginBuild(id,raw,yaw)
  if not self.buildVerified then return {ok=false,error='Najpierw uruchom TEST 1 BLOKU w Builderze.'} end
  if self.transactions[id] then return {ok=false,error='Ten identyfikator budowy był już użyty.'} end
  for _,tx in pairs(self.transactions) do if tx.state=='building' then return {ok=false,error='Inna budowa nadal trwa.'} end end
  local schema,errors=Schema.validate(raw);if not schema then return {ok=false,error=table.concat(errors,'; ')} end
  if schema.mechanical or schema.importedMechanics or schema.assistantOnly or #schema.connections&gt;0 then return {ok=false,error='BABFT: obsługa statycznej geometrii. Ten projekt wymaga nieobsługiwanych połączeń lub jest tylko podglądem.'} end
  local ok,err=self.platform:preflight(schema,yaw);if not ok then return {ok=false,error=err} end
  self.order=self.order or {};while #self.order&gt;=3 do local old=table.remove(self.order,1);self.transactions[old]=nil end;self.order[#self.order+1]=id
  local tx={schema=schema,yaw=yaw or 0,state='building',next=1,objects={}};self.transactions[id]=tx;self.active=id;return {ok=true,transaction=id}
 end
 function B:placeChunk(id,first,count)
  local tx=self.transactions[id];if not tx or tx.state~='building' or first~=tx.next or count~=1 then return {ok=false,error='Nieprawidłowa kolejność lub zatrzymana budowa.'} end
  local e=tx.schema.elements[first];if not e then return {ok=false,error='Brak części w planie.'} end
  local result=self.platform:place(e,tx.yaw,function(remote,args)return self:invoke(remote,args)end,function()return tx.state~='building' or not self.context.alive() end)
  if not result.ok then return result end
  tx.objects[#tx.objects+1]=result.object;tx.next+=1
  return {ok=true,ids={e.id}}
 end
 function B:commitBuild(id)
  local tx=self.transactions[id];if not tx or tx.state~='building' or #tx.objects~=#tx.schema.elements then return {ok=false,error='Brak potwierdzenia wszystkich części.'} end
  for _,object in ipairs(tx.objects) do if not self.platform:stillOwned(object) then return {ok=false,error='Jedna z postawionych części zniknęła z Twojej budowli.'} end end
  tx.state='committed';return {ok=true,count=#tx.objects,connected=true}
 end
 function B:cancel(id)
  if id=='all' then self.probeGeneration=(self.probeGeneration or 0)+1 end
  if id=='farm' or id=='all' then self.farmGeneration=(self.farmGeneration or 0)+1;self.farmState=nil;if self.platform.stopFarm then self.platform:stopFarm() end end
  for key,tx in pairs(self.transactions) do if tx.state=='building' and (id=='all' or id==key) then tx.state='cancelled' end end
 end
 function B:buildStatus(id,cancel)
  if cancel then self:cancel(id) end;local tx=self.transactions[id]
  if not tx then return {ok=false,error='Nie znaleziono budowy.'} end
  return {ok=true,state=tx.state,count=#tx.objects}
 end
 function B:expectingRespawn()return self.platform.expectingRespawn and self.platform:expectingRespawn() or false end
 function B:farmStep(stage,paused,settings)
  if not self.platform.farmStep then return {ok=false,error='Brak obsługi farmy w tym środowisku.'} end
  local generation=self.farmGeneration or 0
  return self.platform:farmStep(stage,function()return not self.context.alive() or generation~=(self.farmGeneration or 0) end,paused,settings)
 end
 function B:rig()return {ok=false,error='Mechanika WORM-a nie jest obsługiwana przez narzędzia zgodności BABFT.'} end
 function B:movement()return {ok=false,error='Ten tryb nie zmienia ustawień ruchu.'} end
 function B:snapshot()return {ok=false,error='Eksport budowli BABFT nie jest jeszcze obsługiwany. Eksportuj wybrany plan.'} end
 return B
end
end)()(M.Util,M.Schema,M.Inventory)

-- SOURCE: src/modules/babft/FarmRoute.lua
M.BabftFarmRoute=(function()
 local Route={};Route.__index=Route
 function Route.new(player,world,wait,clock,alive)
  return setmetatable({player=player,world=world,wait=wait,clock=clock,alive=alive},Route)
 end
 function Route:stages()
  local folder=self.world:FindFirstChild('BoatStages');return folder and folder:FindFirstChild('NormalStages')
 end
 function Route:target(stage)
  local stages=self:stages();if not stages then return nil,'Brak trasy BoatStages / NormalStages.' end
  local target
  if stage&lt;=10 then local cave=stages:FindFirstChild('CaveStage'..stage);target=cave and cave:FindFirstChild('DarknessPart',true)
  else local ending=stages:FindFirstChild('TheEnd');local chest=ending and ending:FindFirstChild('GoldenChest',true);target=chest and chest:FindFirstChild('Trigger',true) end
  if not target or not target:IsA('BasePart') then return nil,stage&lt;=10 and ('Brak punktu CaveStage'..stage..' / DarknessPart.') or 'Brak końcowej skrzyni / Trigger.' end
  return target
 end
 function Route:inspect()
  if not self:stages() then return false,'Brak trasy BoatStages / NormalStages. Poczekaj na wczytanie gry i odśwież trasę.' end
  return true,'Trasa BABFT wykryta. Etapy są sprawdzane kolejno podczas przejazdu.'
 end
 function Route:character()
  local c=self.player.Character;local h=c and c:FindFirstChildOfClass('Humanoid');local r=c and c:FindFirstChild('HumanoidRootPart')
  if not h or not r or h.Health&lt;=0 then return nil,nil,'Poczekaj na aktywną postać.' end;return c,r
 end
 function Route:stop()
  self.phase='Zatrzymano'
  self.expectedCharacter=nil
  if self.floor then self.floor:Destroy();self.floor=nil end
  local origin=self.origin;self.origin=nil
  if origin and self.player.Character==origin.character and origin.root.Parent then local h=origin.character:FindFirstChildOfClass('Humanoid');if h and h.Health&gt;0 then origin.root.AssemblyLinearVelocity=Vector3.zero;origin.root.AssemblyAngularVelocity=Vector3.zero;origin.root.CFrame=origin.cf end end
 end
 function Route:expectingRespawn()return self.expectedCharacter~=nil end
 function Route:move(character,root,cf)
  local h=character:FindFirstChildOfClass('Humanoid');if h then h.Sit=false end
  root.AssemblyLinearVelocity=Vector3.zero;root.AssemblyAngularVelocity=Vector3.zero
  character:PivotTo(cf*root.CFrame:ToObjectSpace(character:GetPivot()))
 end
 function Route:step(stage,cancelled,paused,settings)
  if type(stage)~='number' or stage%1~=0 or stage&lt;1 or stage&gt;11 then return {ok=false,error='Nieprawidłowy etap trasy.'} end
  if cancelled() then return {ok=false,error='Zatrzymano trasę.'} end
  local target,err=self:target(stage);local targetWait=0
  while not target and targetWait&lt;8 and self.alive() and not cancelled() do
   self.phase='Wczytywanie etapu '..stage..': '..tostring(err)
   if not paused or not paused() then targetWait+=.1 end;self.wait(.1);target,err=self:target(stage)
  end
  if cancelled() then self:stop();return {ok=false,error='Zatrzymano trasę.'} end
  if not target then self:stop();return {ok=false,error=err..' Punkt nie pojawił się przez 8 s.'} end
  local character,root,characterError=self:character();if not root then self:stop();return {ok=false,error=characterError} end
  if stage&lt;=10 then
   if stage==1 and not self.origin then self.origin={character=character,root=root,cf=root.CFrame} end
   if not self.floor then self.floor=Instance.new('Part');self.floor.Name='KubiHubFarmSupport';self.floor.Anchored=true;self.floor.CanCollide=true;self.floor.CanTouch=false;self.floor.CanQuery=false;self.floor.Transparency=1;self.floor.Size=Vector3.new(6,1,6);self.floor.Parent=self.world end
   self.phase='Przejście przez etap '..stage..' / 10'
   local duration=math.clamp(tonumber(settings and settings.crossingTime) or .8,.4,3);local elapsed=0;local last=self.clock()
   while elapsed&lt;duration and self.alive() and not cancelled() do
    if self.player.Character~=character or not root.Parent then self:stop();return {ok=false,error='Postać zmieniła się w etapie '..stage..'.'} end
    local now=self.clock()
    if not paused or not paused() then
     elapsed+=math.min(.1,math.max(0,now-last));local cf=target.CFrame*CFrame.new(0,0,-12+24*math.clamp(elapsed/duration,0,1))
     self.floor.CFrame=cf*CFrame.new(0,-3.5,0);self:move(character,root,cf)
    end
    last=now;self.wait(.05)
   end
   if cancelled() or not self.alive() then self:stop();return {ok=false,error='Zatrzymano przejazd.'} end
   return {ok=true,stage=stage,completed=false,confirmation='local-route-position'}
  end
  self.expectedCharacter=character
  self.phase='Skrzynia: oczekiwanie na powrót postaci'
  local elapsed=0;local last=self.clock();local nextTeleport=0;local wasPaused=paused and paused() or false
  while elapsed&lt;35 and self.alive() and not cancelled() do
   local current=self.player.Character
   if current and current~=character then
    local h=current:FindFirstChildOfClass('Humanoid');local r=current:FindFirstChild('HumanoidRootPart')
    if h and r and h.Health&gt;0 then self:stop();return {ok=true,stage=11,completed=true,confirmation='observed-respawn'} end
   end
   local now=self.clock();local isPaused=paused and paused() or false
   if not isPaused then
    if not wasPaused then elapsed+=math.max(0,now-last) end
    if elapsed&lt;10 and elapsed&gt;=nextTeleport and current==character then
     local r=character:FindFirstChild('HumanoidRootPart');local h=character:FindFirstChildOfClass('Humanoid')
     if r and h and h.Health&gt;0 then self:move(character,r,target.CFrame*CFrame.new(0,nextTeleport%2==0 and 1 or -1,0)) end;nextTeleport=elapsed+1
    end
   end
   last=now;wasPaused=isPaused;self.wait(.05)
  end
  self:stop();return {ok=false,error=cancelled() and 'Zatrzymano oczekiwanie przy skrzyni.' or 'Brak powrotu postaci po skrzyni w 35 s. Zatrzymaj i sprawdź trasę; nagrody nie zostały potwierdzone.'}
 end
 return Route
end)()

-- SOURCE: src/modules/babft/Environment.lua
M.BabftEnvironment=(function()
return function(Util,Schema,Inventory,FarmRoute)
 local E={};E.__index=E
 function E.new(player,world,wait,clock,alive)
  return setmetatable({player=player,world=world,wait=wait,clock=clock,alive=alive,route=FarmRoute.new(player,world,wait,clock,alive),used=setmetatable({},{__mode='k'})},E)
 end
 function E:findTool(name)
  local aliases=({BuildingTool={'BuildingTool','BuildTool'},ScalingTool={'ScalingTool','ScaleTool'},PaintingTool={'PaintingTool','PaintTool'}})[name] or {name}
  local backpack=self.player:FindFirstChildOfClass('Backpack');local ch=self.player.Character
  for _,alias in ipairs(aliases) do local t=ch and ch:FindFirstChild(alias) or backpack and backpack:FindFirstChild(alias);if t and t:IsA('Tool') then return t end end
 end
 function E:remote(tool)
  if not tool then return end
  for _,r in ipairs(tool:GetDescendants()) do if r.Name=='RF' and r:IsA('RemoteFunction') then return r end end
 end
 function E:equip(name)
  local t=self:findTool(name);local h=self.player.Character and self.player.Character:FindFirstChildOfClass('Humanoid')
  if not t or not h or h.Health&lt;=0 then return nil,'Brak narzędzia '..name..' lub aktywnej postaci.' end
  if t.Parent~=self.player.Character then h:EquipTool(t);self.wait(.1) end
  local r=self:remote(t);if not r then return nil,'Brak RF w '..name end;return r
 end
 function E:plot()
  for _,o in ipairs(self.world:GetChildren()) do local c=o:FindFirstChild('TeamColor');if o:IsA('BasePart') and c and c.Value==self.player.TeamColor then return o end end
 end
 function E:ownFolder()
  local blocks=self.world:FindFirstChild('Blocks');return blocks and blocks:FindFirstChild(self.player.Name)
 end
 function E:stillOwned(object)local folder=self:ownFolder();return object and folder and object:IsDescendantOf(folder) or false end
 function E:part(object)
  if object:IsA('BasePart') then return object end
  return object:FindFirstChild('PPart') or object:FindFirstChildWhichIsA('BasePart',true)
 end
 function E:inventory()return Inventory.readPlayer(self.player) end
 function E:inspect()
  local zone=self:plot();local build=self:remote(self:findTool('BuildingTool'))~=nil
  local stages=self.world:FindFirstChild('BoatStages');stages=stages and stages:FindFirstChild('NormalStages')
  local lines={'Tryb: BABFT','Działka drużyny: '..(zone and zone.Name or 'BRAK'),'BuildingTool.RF: '..(build and 'wykryto' or 'BRAK'),'ScalingTool.RF: '..(self:remote(self:findTool('ScalingTool')) and 'wykryto' or 'BRAK'),'PaintingTool.RF: '..(self:remote(self:findTool('PaintingTool')) and 'wykryto' or 'BRAK'),'Etapy trasy: '..(stages and 'wykryto' or 'BRAK'),'Mechanika WORM: nieobsługiwana przez ten tryb'}
  local farm,farmReason=self.route:inspect();lines[#lines+1]=farmReason
  return {build=build and zone~=nil,farm=farm,farmReason=farmReason,zone=zone and {size={zone.Size.X,200,zone.Size.Z},min={-zone.Size.X/2+1,-6,-zone.Size.Z/2+1},max={zone.Size.X/2-1,200,zone.Size.Z/2-1}},text=table.concat(lines,'\n')}
 end
 function E:farmStep(stage,cancelled,paused,settings)return self.route:step(stage,cancelled,paused,settings)end
 function E:stopFarm()self.route:stop()end
 function E:expectingRespawn()return self.route:expectingRespawn()end
 function E:preflight(schema,yaw)
  local info=self:inspect();if not info.build then return false,info.text..'\nDołącz do drużyny i sprawdź, czy masz narzędzie budowania.' end
  local bounds=Schema.bounds(schema,yaw);for i=1,3 do if bounds.min[i]&lt;info.zone.min[i] or bounds.max[i]&gt;info.zone.max[i] then return false,'Plan wychodzi poza działkę. Użyj Dopasuj do obszaru.' end end
  local comparison=Inventory.compare(schema,Inventory.snapshot(self:inventory(),'BABFT / dane gracza'));if not comparison.enough then return false,Inventory.describe(comparison) end
  for _,e in ipairs(schema.elements) do
   if e.class=='WedgePart' then return false,'Ten plan wymaga nieobsługiwanego kształtu klina.' end
   if Inventory.definitions[e.material].volume and (math.abs(e.size[1]-2)&gt;.001 or math.abs(e.size[2]-2)&gt;.001 or math.abs(e.size[3]-2)&gt;.001) then if not self:remote(self:findTool('ScalingTool')) then return false,'Plan wymaga narzędzia ScalingTool.' end end
   if e.color and not self:remote(self:findTool('PaintingTool')) then return false,'Plan ma kolory i wymaga narzędzia PaintingTool.' end
  end
  return true
 end
 function E:place(e,yaw,invoke,cancelled)
  if cancelled() then return {ok=false,error='Zatrzymano przed wysłaniem bloku.'} end
  local zone=self:plot();if not zone then return {ok=false,error='Działka zniknęła.'} end
  local have=self:inventory()[e.material];if not have or have&lt;Inventory.cost(e) then return {ok=false,error='Brak materiału '..e.material} end
  local remote,err=self:equip('BuildingTool');if not remote then return {ok=false,error=err} end
  if cancelled() then return {ok=false,error='Zatrzymano przed wysłaniem bloku.'} end
  local cf=zone.CFrame*CFrame.new(0,zone.Size.Y/2+1,0)*CFrame.Angles(0,math.rad(yaw or 0),0)*CFrame.new(table.unpack(e.position))*CFrame.Angles(math.rad(e.rotation[1]),math.rad(e.rotation[2]),math.rad(e.rotation[3]))
  local before={};local folder=self:ownFolder();if folder then for _,o in ipairs(folder:GetChildren()) do before[o]=true end end
  local reply=invoke(remote,{e.material,have,zone,zone.CFrame:ToObjectSpace(cf),true,cf,false});if not reply.ok then return reply end
  local deadline=self.clock()+4;local object
  repeat
   folder=self:ownFolder()
   if folder then for _,o in ipairs(folder:GetChildren()) do if not before[o] and not self.used[o] and o.Name==e.material then local p=self:part(o);if p and (p.Position-cf.Position).Magnitude&lt;.5 then object=o;break end end end end
   if object then break end;self.wait(.04)
  until self.clock()&gt;=deadline or not self.alive()
  if not object then return {ok=false,error='Nie potwierdzono nowego bloku w Twojej budowli. Kolejka zatrzymana; nie ponawiam żądania.'} end
  self.used[object]=true
  if cancelled() then return {ok=true,object=object} end
  if Inventory.definitions[e.material].volume and (math.abs(e.size[1]-2)&gt;.001 or math.abs(e.size[2]-2)&gt;.001 or math.abs(e.size[3]-2)&gt;.001) then
   remote,err=self:equip('ScalingTool');if not remote then return {ok=false,error=err} end
   if cancelled() then return {ok=true,object=object} end
   reply=invoke(remote,{object,Vector3.new(table.unpack(e.size)),cf});if not reply.ok then return reply end
  end
  if e.color then
   remote,err=self:equip('PaintingTool');if not remote then return {ok=false,error=err} end
   if cancelled() then return {ok=true,object=object} end
   reply=invoke(remote,{{{object,Color3.new(table.unpack(e.color))}}});if not reply.ok then return reply end
  end
  deadline=self.clock()+3
  repeat
   if not self:stillOwned(object) then return {ok=false,error='Postawiony blok zniknął.'} end
   local p=self:part(object);local size=p and p.Size;local color=p and p.Color
   local sizeOK=not Inventory.definitions[e.material].volume or size and math.abs(size.X-e.size[1])&lt;.05 and math.abs(size.Y-e.size[2])&lt;.05 and math.abs(size.Z-e.size[3])&lt;.05
   local colorOK=not e.color or color and math.abs(color.R-e.color[1])&lt;.04 and math.abs(color.G-e.color[2])&lt;.04 and math.abs(color.B-e.color[3])&lt;.04
   local _,angle;if p then _,angle=p.CFrame:ToObjectSpace(cf):ToAxisAngle() end
   if sizeOK and colorOK and angle and math.abs(angle)&lt;math.rad(3) and (p.Position-cf.Position).Magnitude&lt;.2 then return {ok=true,object=object} end
   self.wait(.04)
  until self.clock()&gt;=deadline or not self.alive()
  return {ok=false,error='Blok powstał, ale nie potwierdzono wymiarów, koloru lub pozycji. Pozostaje na działce; kolejka zatrzymana.'}
 end
 return E
end
end)()(M.Util,M.Schema,M.Inventory,M.BabftFarmRoute)

-- SOURCE: src/modules/farm/Controller.lua
M.Farm=(function()
return function(Util)
 local Farm={};Farm.__index=Farm
 Farm.profiles={NORMAL=2,FAST=1.4,TURBO=1,HYPER=.7,LIGHTNING=.5,SONIC=.3}
 function Farm.new(runtime,adapter,settings,log,spawn)
  return setmetatable({runtime=runtime,adapter=adapter,settings=settings,log=log,spawn=spawn,state='STOPPED',generation=0,stage=0,retries=0,nextAt=0,stats={started=runtime.clock(),completed=0,failed=0,totalCycleTime=0,lastError='',lastCycleTime=nil},pending=nil},Farm)
 end
 function Farm:availability()
  if self.adapter.mode=='BABFT' and self.adapter.farmReason then return self.adapter.capabilities.farm==true,self.adapter.farmReason end
  if self.adapter.capabilities.farm then return true,'Autofarma: dostępna w połączonym środowisku.' end
  if self.adapter.mode=='BABFT' then return false,'Brak kompletnej trasy autofarmy BABFT. Odśwież trasę i sprawdź etapy oraz skrzynię.' end
  return false,'Ten serwer nie udostępnia kontrolera autofarmy. Kontroler V5 działa z dodatkiem do własnej gry w Roblox Studio.'
 end
 function Farm:start()
  if self.state~='STOPPED' and self.state~='ERROR' then return false,'Farm już działa lub jest wstrzymana.' end
  if self.pending and not self.pending.done or self.adapter.pending then return false,'Oczekiwanie na zakończenie poprzedniego żądania.' end
  if self.adapter.mode=='BABFT' then self.adapter:connect() end
  local available,reason=self:availability();if not available then self.stats.lastError=reason;return false,reason end
  local ok,err=self.runtime:acquire('Farm');if not ok then return false,err end
  self.generation=self.generation+1;self.stage=0;self.retries=0;self.stats.lastError='';self.cycleStarted=self.runtime.clock();self.nextAt=self.runtime.clock();self.state='RUNNING';self.log:add('Farm','START');return true
 end
 function Farm:pause()if self.state~='RUNNING' and self.state~='RETRY' then return false,'Brak aktywnej farmy.' end;self.beforePause=self.state;self.state='PAUSED';self.log:add('Farm','PAUZA');return true end
 function Farm:resume()if self.state~='PAUSED' then return false,'Farm nie jest wstrzymana.' end;self.state=self.beforePause or 'RUNNING';self.log:add('Farm','WZNÓW');return true end
 function Farm:stop(reason)
  self.generation=self.generation+1;self.state='STOPPED';self.runtime:release('Farm');self.adapter:cancel('farm');self.log:add('Farm',reason or 'Zadanie zatrzymane przez użytkownika.');return true
 end
 function Farm:reset()
  if self.state~='STOPPED' or self.pending and not self.pending.done then return false,'Zatrzymaj Farm i poczekaj na koniec żądania.' end
  self.stats={started=self.runtime.clock(),completed=0,failed=0,totalCycleTime=0,lastError='',lastCycleTime=nil};self.stage=0;return true
 end
 function Farm:fail(err)
  self.adapter:cancel('farm')
  self.stats.failed=self.stats.failed+1;self.stats.lastError=tostring(err);self.log:error('Farm',err);self.retries=self.retries+1
  if self.retries&gt;self.settings.retryLimit then self.state='ERROR';self.runtime:release('Farm');return end
  self.state='RETRY';self.stage=0;self.nextAt=self.runtime.clock()+2^(self.retries-1);self.cycleStarted=self.nextAt
 end
 function Farm:tick()
  if self.pending then
   if not self.pending.done then return end
   local j=self.pending;self.pending=nil
   if j.generation~=self.generation then return end
   if not j.ok or type(j.result)~='table' or not j.result.ok then local paused=self.state=='PAUSED';self:fail(j.ok and j.result and j.result.error or j.result);if paused and self.state=='RETRY' then self.beforePause='RETRY';self.state='PAUSED' end;return end
   local reply=j.result
   if reply.stage~=self.stage+1 then self:fail('Serwer potwierdził inny etap.');return end
   self.stage=reply.stage
   if reply.completed==true then
    local duration=self.runtime.clock()-self.cycleStarted;self.stats.completed=self.stats.completed+1;self.stats.totalCycleTime=self.stats.totalCycleTime+duration;self.stats.lastCycleTime=duration;self.retries=0;self.stage=0;self.cycleStarted=self.runtime.clock()
    self.log:add('Farm',self.adapter.mode=='BABFT' and 'Zaobserwowano powrót postaci po trasie i skrzyni. Nagrody nie zostały zmierzone.' or 'Cykl potwierdzony przez uprawniony serwer. Nagrody nie są symulowane.')
    if self.settings.stopAfter&gt;0 and self.stats.completed&gt;=self.settings.stopAfter then self:stop('Osiągnięto limit cykli.');return end
   end
   self.nextAt=self.runtime.clock()+math.max(Farm.profiles[self.settings.profile] or 2,self.adapter.minFarmInterval or 0)
  end
  if self.state=='RETRY' and self.runtime.clock()&gt;=self.nextAt then self.state='RUNNING' end
  if self.state~='RUNNING' or self.runtime.clock()&lt;self.nextAt then return end
  local generation=self.generation;local stage=self.stage+1
  self.pending=self.runtime:job('Farm',function()return self.adapter:farmStep(stage,function()return self.state=='PAUSED' end,self.settings)end,self.spawn);self.pending.generation=generation
 end
 function Farm:summary()
  local elapsed=math.max(0,self.runtime.clock()-self.stats.started);local count=self.stats.completed
  return {state=self.state,elapsed=elapsed,completed=count,failed=self.stats.failed,average=count&gt;0 and self.stats.totalCycleTime/count or nil,cyclesPerHour=count&gt;0 and elapsed&gt;0 and count*3600/elapsed or nil,lastError=self.stats.lastError,stage=self.stage}
 end
 return Farm
end
end)()(M.Util)

-- SOURCE: src/modules/builder/Controller.lua
M.Builder=(function()
return function(Util,Schema,Inventory)
 local Builder={};Builder.__index=Builder
 function Builder.new(runtime,adapter,log,spawn)
  return setmetatable({runtime=runtime,adapter=adapter,log=log,spawn=spawn,state='IDLE',generation=0,revision=0,pending=nil,placed=0,total=0,history={},future={},options={yaw=0,material='ORIGINAL',mirrorX=false,mirrorZ=false,scale=1,offsetX=0,offsetY=0,offsetZ=0},transaction=nil},Builder)
 end
 function Builder:select(raw,reset)
  if self:isBusy() then return false,'Najpierw zakończ lub anuluj budowę.' end
  local schema,errors=Schema.validate(raw);if not schema then return false,table.concat(errors,'; ') end
  local options=reset and {yaw=0,material='ORIGINAL',mirrorX=false,mirrorZ=false,previewLayer=0,scale=1,offsetX=0,offsetY=0,offsetZ=0} or Util.copy(self.options);if schema.mechanical then options.mirrorX=false;options.mirrorZ=false;options.scale=1 end
  local transformed,transformErrors=Schema.transform(schema,options);if not transformed then return false,table.concat(transformErrors,'; ') end
  self.source=schema;self.schema=transformed;self.options=options;self.bounds=Schema.bounds(transformed,options.yaw);self.history={};self.future={};self.state='PREVIEW';self.error=nil;self.revision=self.revision+1;return true
 end
 function Builder:isBusy()return self.state=='BUILDING' or self.state=='BEGINNING' or self.state=='PAUSED' or self.state=='COMMITTING' or self.state=='CANCELLING' end
 function Builder:staticDraft(id)
  if self:isBusy() or not self.source then return nil,'Najpierw zatrzymaj budowę i wybierz plan.' end
  if self.source.assistantOnly or self.source.intentionalOverlap then return nil,'Ten plan pozostaje asystentem; nie jest modelem do konwersji statycznej.' end
  local out={schemaVersion=2,id=id,name=self.source.name:sub(1,85)..' — statyczny',category='Własne projekty',elements={},connections={},geometryOnly=true,source=self.source.source}
  for _,e in ipairs(self.source.elements) do local d=Inventory.definitions[e.material];if d and d.volume and e.class=='Part' then out.elements[#out.elements+1]=Util.copy(e) end end
  local schema,errors=Schema.validate(out);if not schema then return nil,table.concat(errors,'; ') end
  return schema,#self.source.elements-#schema.elements
 end
 function Builder:edit(options,record)
  if self:isBusy() then return false,'Edycja jest zablokowana podczas budowania.' end
  if not self.source then return false,'Wybierz schemat.' end
  local nextOptions=Util.copy(options);nextOptions.yaw=Util.number(nextOptions.yaw,0,-360,360)
  local schema,errors=Schema.transform(self.source,nextOptions);if not schema then return false,table.concat(errors,'; ') end
  if record~=false then self.history[#self.history+1]=Util.copy(self.options);if #self.history&gt;30 then table.remove(self.history,1) end;self.future={} end
  self.options=nextOptions;self.schema=schema;self.bounds=Schema.bounds(schema,nextOptions.yaw);self.state='PREVIEW';self.error=nil;self.revision=self.revision+1;return true
 end
 function Builder:undo()
  if self:isBusy() then return false,'Nie można cofać podczas budowania.' end
  local previous=table.remove(self.history);if not previous then return false,'Brak wcześniejszej edycji.' end
  self.future[#self.future+1]=Util.copy(self.options);return self:edit(previous,false)
 end
 function Builder:redo()
  if self:isBusy() then return false,'Nie można ponawiać podczas budowania.' end
  local nextOptions=table.remove(self.future);if not nextOptions then return false,'Brak edycji do ponowienia.' end
  self.history[#self.history+1]=Util.copy(self.options);return self:edit(nextOptions,false)
 end
 function Builder:assistant(snapshot)
  if not self.schema then return nil,'Wybierz schemat.' end
  return {bounds=self.bounds,materials=Inventory.compare(self.schema,snapshot),elements=#self.schema.elements,connections=#self.schema.connections,mechanical=self.schema.mechanical==true}
 end
 function Builder:start(snapshot)
  if self:isBusy() or self.pending and not self.pending.done or self.adapter.pending then return false,'Budowa albo jej zatrzymywanie już trwa.' end
  if not self.schema then return false,'Wybierz schemat.' end
  local valid,errors=Schema.validate(self.schema);if not valid then return false,table.concat(errors,'; ') end
  if valid.assistantOnly or valid.importedMechanics then return false,'Ten schemat jest dostępny jako podgląd / asystent. Nie uruchamiam eksplozji ani nie pomijam nieobsługiwanych połączeń.' end
  if not self.adapter.capabilities.build then return false,'Brak uprawnionego API budowania w tej grze. Podgląd i lista kroków są dostępne; lokalne części nie są budowlą serwerową.' end
  if valid.mechanical and not self.adapter.capabilities.mechanics then return false,'Adapter nie obsługuje wymaganych zawiasów i sterowania.' end
  local check=Inventory.compare(valid,snapshot);if not check.enough then return false,Inventory.describe(check) end
  local zone=self.adapter.zone;if not zone then return false,'Brak własnego obszaru budowania.' end
  local low=zone.min or {-zone.size[1]/2,-math.huge,-zone.size[3]/2};local high=zone.max or {zone.size[1]/2,math.huge,zone.size[3]/2}
  for i=1,3 do if self.bounds.min[i]&lt;low[i]-1e-6 or self.bounds.max[i]&gt;high[i]+1e-6 then return false,'Konstrukcja wychodzi poza własny obszar. Wyśrodkuj projekt, zmień obrót albo wybierz mniejszy.' end end
  local ok,err=self.runtime:acquire('Builder');if not ok then return false,err end
  self.generation=self.generation+1;self.state='BEGINNING';self.error=nil;self.placed=0;self.total=#valid.elements;self.transaction=nil;self.nextIndex=1
  local generation=self.generation;local requestId=self.adapter:newId('build');self.requestId=requestId
  self.pending=self.runtime:job('Builder',function()return self.adapter:beginBuild(requestId,valid,self.options.yaw)end,self.spawn);self.pending.generation=generation;self.pending.phase='begin'
  self.log:add('Builder','Sprawdzono plan i materiały. Oczekiwanie na autoryzację serwera.');return true
 end
 function Builder:pause()if self.state~='BUILDING' then return false,'Budowa nie jest w stanie BUILDING.' end;self.state='PAUSED';return true end
 function Builder:resume()if self.state~='PAUSED' then return false,'Budowa nie jest wstrzymana.' end;self.state='BUILDING';return true end
 function Builder:cancel(reason)
  if not self:isBusy() then return true end
  self.generation=self.generation+1;self.adapter:cancel(self.transaction or self.requestId);self.state='CANCELLING';self.log:add('Builder',reason or 'Zatrzymano kolejkę; oczekiwanie na potwierdzenie anulowania / końca zatwierdzania.');return true
 end
 function Builder:fail(err)
  self.adapter:cancel(self.transaction or self.requestId);self.state='ERROR';self.error=tostring(err);self.runtime:release('Builder');self.log:error('Builder',err)
 end
 function Builder:tick()
  if self.pending then
   if not self.pending.done then return end
   local j=self.pending;self.pending=nil;if j.generation~=self.generation then return end
   if not j.ok or type(j.result)~='table' or not j.result.ok then self:fail(j.ok and j.result and j.result.error or j.result);return end
   local r=j.result
   if j.phase=='begin' then
    if type(r.transaction)~='string' then self:fail('Brak identyfikatora transakcji w odpowiedzi serwera.');return end
    self.transaction=r.transaction;self.state='BUILDING'
   elseif j.phase=='place' then
    if type(r.ids)~='table' or #r.ids~=j.expected then self:fail('Niepełne potwierdzenie partii. Nie ponawiam jej automatycznie.');return end
    for i,id in ipairs(r.ids) do if id~=self.schema.elements[self.nextIndex+i-1].id then self:fail('Odpowiedź zawiera niewłaściwy identyfikator bloku.');return end end
    self.placed=self.placed+#r.ids;self.nextIndex=self.nextIndex+#r.ids
   elseif j.phase=='commit' then
    if r.count~=self.total or r.connected~=true then self:fail('Serwer nie potwierdził całej konstrukcji i połączeń.');return end
    self.state='COMPLETED';self.runtime:release('Builder');self.log:add('Builder',self.adapter.mode=='BABFT' and ('Odczytano '..self.total..' nowych części w Twojej budowli BABFT. Plan statyczny; nie odtwarzano mechaniki.') or ('Serwer potwierdził '..self.total..' części i połączenia. Fizyka wymaga testu integracyjnego.'));return
   elseif j.phase=='cancel' then
    if r.state~='committed' and r.state~='cancelled' or r.state=='committed' and r.count~=self.total then self:fail('Brak poprawnego potwierdzenia anulowania lub zakończenia budowy.');return end
    self.state=r.state=='committed' and 'COMPLETED' or 'CANCELLED';if r.state=='committed' then self.placed=r.count or self.placed;self.log:add('Builder','Zatwierdzanie zakończyło się przed anulowaniem. Konstrukcja pozostaje na serwerze.','WARN') elseif self.adapter.mode=='BABFT' then self.placed=r.count or self.placed;self.log:add('Builder','Zatrzymano wysyłanie bloków. Już postawione części pozostają na działce.','WARN') end;self.runtime:release('Builder');return
   end
  end
  if self.state=='CANCELLING' then
   if self.adapter.pending then return end
   local generation=self.generation;self.pending=self.runtime:job('Builder',function()return self.adapter:buildStatus(self.transaction or self.requestId,true)end,self.spawn);self.pending.phase='cancel';self.pending.generation=generation;return
  end
  if self.state~='BUILDING' then return end
  local generation=self.generation
  if self.nextIndex&gt;self.total then
   self.state='COMMITTING';self.pending=self.runtime:job('Builder',function()return self.adapter:commitBuild(self.transaction)end,self.spawn);self.pending.phase='commit'
  else
   local first=self.nextIndex;local count=math.min(self.adapter.chunkSize or 16,self.total-first+1)
   self.pending=self.runtime:job('Builder',function()return self.adapter:placeChunk(self.transaction,first,count)end,self.spawn);self.pending.phase='place';self.pending.expected=count
  end
  self.pending.generation=generation
 end
 function Builder:export()if not self.schema then return nil,{'Wybierz schemat.'} end;return Schema.bakeYaw(self.schema,self.options.yaw) end
 function Builder:center()
  if not self.schema then return false,'Wybierz schemat.' end
  local options=Util.copy(self.options);local d=Util.rotate({-self.bounds.center[1],0,-self.bounds.center[3]},{0,-options.yaw,0})
  options.offsetX=(options.offsetX or 0)+d[1];options.offsetZ=(options.offsetZ or 0)+d[3];return self:edit(options)
 end
 function Builder:fit(zone)
  if self:isBusy() then return false,'Zatrzymaj budowę przed dopasowaniem.' end
  if not self.source then return false,'Wybierz schemat.' end
  if type(zone)~='table' or not Util.vector(zone.size,10000) or zone.size[1]&lt;=2 or zone.size[3]&lt;=2 then return false,'Brak poprawnych wymiarów obszaru.' end
  local low=zone.min or {-zone.size[1]/2,-math.huge,-zone.size[3]/2};local high=zone.max or {zone.size[1]/2,math.huge,zone.size[3]/2}
  local factor=1;for i=1,3 do local available=high[i]-low[i];if available&lt;=0 then return false,'Nieprawidłowe granice obszaru.' end;factor=math.min(factor,available/self.bounds.size[i]) end
  local options=Util.copy(self.options);options.scale=(options.scale or 1)*factor
  if options.scale&lt;.1 then return false,'Plan wymaga skali poniżej 10%. Wybierz większy obszar lub prostszy schemat.' end
  local schema,errors=Schema.transform(self.source,options);if not schema then return false,table.concat(errors,'; ') end
  local bounds=Schema.bounds(schema,options.yaw);local desiredX=(low[1]+high[1])/2;local desiredZ=(low[3]+high[3])/2
  local dy=math.clamp(0,low[2]-bounds.min[2],high[2]-bounds.max[2]);local d=Util.rotate({desiredX-bounds.center[1],dy,desiredZ-bounds.center[3]},{0,-options.yaw,0})
  options.offsetX=(options.offsetX or 0)+d[1];options.offsetY=(options.offsetY or 0)+d[2];options.offsetZ=(options.offsetZ or 0)+d[3]
  return self:edit(options)
 end
 return Builder
end
end)()(M.Util,M.Schema,M.Inventory)

-- SOURCE: src/modules/tools/Version.lua
M.Version=(function()
return function(Util)
 local Version={current='6.2.0',releaseDate='2026-11-04',url='https://raw.githubusercontent.com/kubibubi124269/script-kubi-hub-babft/main/version.json'}
 function Version.validate(raw)
  if type(raw)~='table' or not Util.semver(raw.version) or type(raw.releaseDate)~='string' or not raw.releaseDate:match('^%d%d%d%d%-%d%d%-%d%d$') then return nil,'Nieprawidłowe informacje o wersji.' end
  if type(raw.changes)~='table' or #raw.changes&gt;30 then return nil,'Nieprawidłowa lista zmian.' end
  for _,line in ipairs(raw.changes) do if type(line)~='string' or #line&gt;300 then return nil,'Nieprawidłowy opis zmiany.' end end
  return {version=raw.version,releaseDate=raw.releaseDate,changes=Util.copy(raw.changes),compatibility=tostring(raw.compatibility or 'Brak opisu'):sub(1,500),update=Util.newer(raw.version,Version.current)}
 end
 function Version.fetch(get,decode)
  local ok,text=pcall(get,Version.url);if not ok or type(text)~='string' or #text&gt;20000 then return nil,'Nie udało się odczytać version.json. Hub działa dalej.' end
  local parsed,raw=pcall(decode,text);if not parsed then return nil,'version.json nie jest poprawnym JSON.' end
  return Version.validate(raw)
 end
 return Version
end
end)()(M.Util)

-- SOURCE: src/modules/tools/Performance.lua
M.Performance=(function()
local Performance={}
Performance.profiles={QUALITY={previewLimit=700,previewHz=30,statsInterval=.5},BALANCED={previewLimit=350,previewHz=15,statsInterval=1},PERFORMANCE={previewLimit=120,previewHz=6,statsInterval=2}}
function Performance.get(name,fps)
 local source=Performance.profiles[name] or Performance.profiles.BALANCED
 return {previewLimit=source.previewLimit,previewHz=fps and fps&lt;30 and math.min(6,source.previewHz) or source.previewHz,statsInterval=fps and fps&lt;30 and math.max(2,source.statsInterval) or source.statsInterval}
end
return Performance
end)()

-- SOURCE: src/modules/movement/Controller.lua
M.Movement=(function()
return function(Util)
 local Movement={};Movement.__index=Movement
 function Movement.new(runtime,adapter,player,input,log,settings)
  return setmetatable({runtime=runtime,adapter=adapter,player=player,input=input,log=log,settings=settings,fly=false,saved=nil,objects={}},Movement)
 end
 function Movement:character()
  local ch=self.player.Character;return ch,ch and ch:FindFirstChildOfClass('Humanoid'),ch and ch:FindFirstChild('HumanoidRootPart')
 end
 function Movement:available()
  if not self.adapter.capabilities.movement then return false,'Zmiana ruchu wymaga autoryzowanego środowiska testowego.' end
  local _,h,r=self:character();if not h or not r or h.Health&lt;=0 then return false,'Postać jest niedostępna.' end;return true
 end
 function Movement:capture(h)
  if self.saved and self.saved.humanoid==h then return end
  self.saved={humanoid=h,WalkSpeed=h.WalkSpeed,JumpPower=h.JumpPower,JumpHeight=h.JumpHeight,UseJumpPower=h.UseJumpPower,PlatformStand=h.PlatformStand,AutoRotate=h.AutoRotate}
 end
 function Movement:apply()
  local ok,err=self:available();if not ok then return false,err end
  local _,h=self:character();self:capture(h)
  local response=self.adapter:movement({walk=Util.number(self.settings.walk,16,8,60),jump=Util.number(self.settings.jump,50,20,120)})
  if not response.ok then return false,response.error end
  self.log:add('Movement',(self.adapter.mode=='MM2' or self.adapter.mode=='UNIVERSAL') and 'Zastosowano lokalne ustawienia własnej postaci.' or 'Serwer potwierdził ustawienia własnej postaci.');return true
 end
 function Movement:startFly()
  local ok,err=self:available();if not ok then return false,err end
  if self.fly then return false,'Fly już działa.' end
  ok,err=self.runtime:acquire('Fly');if not ok then return false,err end
  local _,h,r=self:character();self:capture(h);h.PlatformStand=true;h.AutoRotate=false
  local a=Instance.new('Attachment');a.Name='KubiHubFlyAttachment';a.Parent=r
  local velocity=Instance.new('LinearVelocity');velocity.Attachment0=a;velocity.RelativeTo=Enum.ActuatorRelativeTo.World;velocity.VelocityConstraintMode=Enum.VelocityConstraintMode.Vector;velocity.MaxForce=math.max(10000,r.AssemblyMass*workspace.Gravity*8);velocity.VectorVelocity=Vector3.zero;velocity.Parent=r
  local align=Instance.new('AlignOrientation');align.Mode=Enum.OrientationAlignmentMode.OneAttachment;align.Attachment0=a;align.MaxTorque=200000;align.Responsiveness=15;align.CFrame=r.CFrame;align.Parent=r
  self.objects={velocity,align,a};self.velocity=velocity;self.align=align;self.fly=true;return true
 end
 function Movement:stopFly()
  self.fly=false;for _,o in ipairs(self.objects) do o:Destroy() end;self.objects={};self.velocity=nil;self.align=nil
  if self.saved and self.saved.humanoid.Parent then self.saved.humanoid.PlatformStand=self.saved.PlatformStand;self.saved.humanoid.AutoRotate=self.saved.AutoRotate end;self.runtime:release('Fly')
 end
 function Movement:reset()
  self:stopFly();self.adapter:cancel('movement');local s=self.saved
  if s and s.humanoid.Parent then for _,key in ipairs({'WalkSpeed','JumpPower','JumpHeight','UseJumpPower','PlatformStand','AutoRotate'}) do s.humanoid[key]=s[key] end end
  self.saved=nil;return true
 end
 function Movement:tick()
  if not self.fly then return end
  local _,h,r=self:character();local c=workspace.CurrentCamera
  if not h or not r or h.Health&lt;=0 or not self.velocity or not self.velocity.Parent then self:reset();return end
  local move=Vector3.zero
  if c and not self.input:GetFocusedTextBox() then
   for _,s in ipairs({{Enum.KeyCode.W,c.CFrame.LookVector},{Enum.KeyCode.S,-c.CFrame.LookVector},{Enum.KeyCode.D,c.CFrame.RightVector},{Enum.KeyCode.A,-c.CFrame.RightVector},{Enum.KeyCode.Space,Vector3.yAxis},{Enum.KeyCode.LeftControl,-Vector3.yAxis}}) do if self.input:IsKeyDown(s[1]) then move=move+s[2] end end
   if self.input.TouchEnabled then move=move+h.MoveDirection end
  end
  self.velocity.VectorVelocity=move.Magnitude&gt;.01 and move.Unit*Util.number(self.settings.flySpeed,40,10,100) or Vector3.zero
  if c then self.align.CFrame=c.CFrame.Rotation end
 end
 return Movement
end
end)()(M.Util)

-- SOURCE: src/modules/tools/Effects.lua
M.Effects=(function()
local Effects={};Effects.__index=Effects
function Effects.new(clock) return setmetatable({clock=clock,objects={},rainbow=nil,clones=0},Effects) end
function Effects:own(object,ttl)self.objects[#self.objects+1]={object=object,expires=self.clock()+ttl};return object end
function Effects:confetti(root)
 assert(root,'Brak postaci.');local a=self:own(Instance.new('Attachment'),4);a.Parent=root
 local e=Instance.new('ParticleEmitter');e.Texture='rbxasset://textures/particles/sparkles_main.dds';e.Rate=0;e.Lifetime=NumberRange.new(1,2);e.Speed=NumberRange.new(10,22);e.SpreadAngle=Vector2.new(180,180);e.Size=NumberSequence.new(.3);e.Color=ColorSequence.new(Color3.fromRGB(70,130,255),Color3.fromRGB(180,80,255));e.Parent=a;e:Emit(60)
end
function Effects:trail(root)
 if self.rainbow then self:clear();return end;assert(root,'Brak postaci.')
 local a=self:own(Instance.new('Attachment'),600);a.Position=Vector3.new(-1,0,0);a.Parent=root;local b=self:own(Instance.new('Attachment'),600);b.Position=Vector3.new(1,0,0);b.Parent=root
 local t=self:own(Instance.new('Trail'),600);t.Attachment0=a;t.Attachment1=b;t.Lifetime=.8;t.LightEmission=1;t.FaceCamera=true;t.Parent=root;self.rainbow=t
end
function Effects:clone(character,scale)
 assert(character,'Brak postaci.');assert(self.clones&lt;5,'Limit pięciu lokalnych kopii. Wyczyść efekty lub poczekaj 12 s.')
 local old=character.Archivable;character.Archivable=true;local ok,clone=pcall(function()return character:Clone()end);character.Archivable=old;assert(ok and clone,'Nie można skopiować postaci.')
 for _,o in ipairs(clone:GetDescendants()) do if o:IsA('Script') or o:IsA('LocalScript') or o:IsA('Tool') then o:Destroy() elseif o:IsA('BasePart') then o.Anchored=true;o.CanCollide=false;o.CanTouch=false;o.CanQuery=false end end
 clone.Name='KubiHubLocalClone';clone.Parent=workspace;clone:ScaleTo(scale);clone:PivotTo(character:GetPivot()*CFrame.new(5+self.clones*3,0,0));self:own(clone,12);self.clones=self.clones+1
end
function Effects:tick()
 local now=self.clock();for i=#self.objects,1,-1 do local row=self.objects[i];if not row.object.Parent or now&gt;=row.expires then if row.object==self.rainbow then self.rainbow=nil end;if row.object.Name=='KubiHubLocalClone' then self.clones=math.max(0,self.clones-1) end;row.object:Destroy();table.remove(self.objects,i) end end
 if self.rainbow then self.rainbow.Color=ColorSequence.new(Color3.fromHSV(now*.1%1,.8,1),Color3.fromHSV((now*.1+.3)%1,.8,1)) end
end
function Effects:clear()for _,row in ipairs(self.objects) do row.object:Destroy() end;self.objects={};self.clones=0;self.rainbow=nil end
return Effects
end)()

-- SOURCE: src/modules/tools/Travel.lua
M.Travel=(function()
 local T={};T.__index=T
 function T.new(runtime,player,allowed)return setmetatable({runtime=runtime,player=player,allowed=allowed,slots={},slot=1,offset=3},T)end
 function T:character()
  local c=self.player.Character;local h=c and c:FindFirstChildOfClass('Humanoid');local r=c and c:FindFirstChild('HumanoidRootPart')
  if not c or not h or not r or h.Health&lt;=0 then return nil,nil,nil,'Poczekaj na aktywną postać.' end;return c,h,r
 end
 function T:save()
  local _,_,r,err=self:character();if not r then return false,err end;self.slots[self.slot]=r.CFrame;return true
 end
 function T:go(cf)
  if not self.allowed then return false,'Teleport działa w BABFT i MM2.' end
  if not cf then return false,'Najpierw zapisz punkt.' end
  local ok,err=self.runtime:acquire('Teleport');if not ok then return false,err end
  local c,h,r,why=self:character();if not r then self.runtime:release('Teleport');return false,why end
  local origin=r.CFrame;local moved,message=pcall(function()h.Sit=false;r.AssemblyLinearVelocity=Vector3.zero;r.AssemblyAngularVelocity=Vector3.zero;c:PivotTo(cf*r.CFrame:ToObjectSpace(c:GetPivot()))end)
  self.runtime:release('Teleport');if not moved then return false,tostring(message) end;self.previous={character=c,cf=origin};return true
 end
 function T:back()
  if not self.previous or self.previous.character~=self.player.Character then return false,'Brak powrotu dla obecnej postaci.' end;return self:go(self.previous.cf)
 end
 return T
end)()

-- SOURCE: src/ui/Layout.lua
M.Layout=(function()
local Layout={}
function Layout.compute(viewWidth,viewHeight,desiredWidth,desiredHeight,compact,tabCount)
 local width=math.min(math.max(300,desiredWidth),math.max(260,viewWidth-16));local height=math.min(math.max(360,desiredHeight),math.max(260,viewHeight-16))
 local narrow=width&lt;700 or compact==true;local navWidth=width&lt;420 and 88 or compact and 116 or 140
 return {width=width,height=height,narrow=narrow,contentX=navWidth+26,contentY=80,contentWidth=width-navWidth-38,contentHeight=height-120,
 navColumns=1,navRows=tabCount or 6,navWidth=navWidth,navHeight=height-120,navCellWidth=navWidth-5,navCellHeight=width&lt;420 and 36 or 40}
end
return Layout
end)()

-- SOURCE: src/ui/Navigation.lua
M.Navigation=(function()
local N={}
N.order={'FARM','TROLLING','TELEPORT','FIGHT','MISC','SETTINGS'}
N.titles={FARM='Autofarm',TROLLING='Trolling',TELEPORT='Teleport',FIGHT='Fight',MISC='Misc',SETTINGS='Ustawienia'}
N.aliases={HOME='SETTINGS',PRO='SETTINGS',MOVEMENT='MISC',PLAYER='TROLLING',BUILDER='MISC',TOOLS='MISC',SCHEMATICS='MISC',SHAPES='MISC',CIRCLE='MISC',COMBAT='FIGHT',STATS='SETTINGS',DEBUG='SETTINGS',PERFORMANCE='SETTINGS'}
function N.resolve(id)return N.aliases[id] or id end
function N.rank(id)for i,v in ipairs(N.order) do if id==v then return i end end;return 99 end
function N.matches(query,text)
 local q=string.lower(query):gsub('^%s+',''):gsub('%s+$','');local t=string.lower(text)
 for word in q:gmatch('%S+') do if not t:find(word,1,true) then return false end end
 return true
end
return N
end)()

