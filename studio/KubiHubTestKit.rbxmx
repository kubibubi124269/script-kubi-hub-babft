function Util.matrix(r)
 local x,y,z=math.rad(r[1]),math.rad(r[2]),math.rad(r[3]);local a,b,c,d,e,f=math.sin(x),math.cos(x),math.sin(y),math.cos(y),math.sin(z),math.cos(z)
