 ['Wheelie (Ctrl)']={'Wheelie (Ctrl)','Вилли (Ctrl)','Вілі (Ctrl)','翘头 (Ctrl)','Caballito (Ctrl)','Wheelie (Ctrl)','Empinar (Ctrl)','Roue arrière (Ctrl)','Impennata (Ctrl)'},
 ['Triki 1–4']={'Tricks 1–4','Трюки 1–4','Трюки 1–4','特技 1–4','Trucos 1–4','Tricks 1–4','Manobras 1–4','Figures 1–4','Trucchi 1–4'},
 ['Osłona przed kraksą']={'Crash guard','Защита от столкновений','Захист від зіткнень','碰撞保护','Protección de choques','Kollisionsschutz','Proteção contra colisões','Protection anticollision','Protezione urti'},
 ['Boost gazu']={'Throttle boost','Ускоренный газ','Посилений газ','油门增强','Aceleración','Gas-Boost','Aceleração','Boost de gaz','Boost acceleratore'},
 ['Puls podczas bezczynności']={'Idle throttle pulse','Импульс газа при простое','Імпульс газу в простої','空闲油门脉冲','Pulso de aceleración en reposo','Gasimpuls im Leerlauf','Pulso de aceleração ocioso','Impulsion au ralenti','Impulso al minimo'},
}
local columns={};for i,code in ipairs(L.codes)do columns[code]=i-1 end
function L.valid(code)return columns[code]~=nil end
function L.text(code,value)
 local column=columns[code];if not column or column==0 or type(value)~='string' then return value end
 local row=rows[value];return row and row[column] or value
end
return L
end)()

-- SOURCE: src/core/Profiles.lua
M.Profiles=(function()
return function(M)
 local P={}
 function P.storage(userId,mode,api)
  local id=tostring(userId)
  assert(id:match('^%-?%d+$') and M.Games.items[mode],'Invalid configuration scope')
  local scope=id..'_'..mode
  _G.KubiHubAccountProfiles=_G.KubiHubAccountProfiles or {}
  local memory=_G.KubiHubAccountProfiles[scope] or {};_G.KubiHubAccountProfiles[scope]=memory
  local base='KubiHubProfiles';local folder=base..'/'..scope
  local disk=api and pcall(function()
   if not api.isfolder(base) then api.makefolder(base)end
   if not api.isfolder(folder) then api.makefolder(folder)end
  end)
  local function path(name,suffix)
   assert(M.Config.profileName(name),'Invalid profile name')
   return folder..'/'..name:lower()..suffix
  end
  local function read(file)
   if not disk or not api.isfile(file) then return nil end
   return api.read(file)
  end
  return {
   label=disk and 'Pliki na tym urządzeniu' or 'Pamięć bieżącej sesji',
   read=function(name)local file=path(name,'.json');local row=memory[name:lower()];return disk and read(file) or row and row.text end,
   backup=function(name)local file=path(name,'.backup.json');local row=memory[name:lower()];return disk and read(file) or row and row.backup end,
   write=function(name,text)
    local file=path(name,'.json');local key=name:lower()
    if disk then
     local previous=read(file);if previous and #previous&lt;=65536 then api.write(path(name,'.backup.json'),previous)end
     api.write(file,text)
    end
    local old=memory[key];memory[key]={text=text,backup=old and old.text}
   end,
   last=function()
    if disk then local ok,value=pcall(read,folder..'/last-profile.txt');if ok and M.Config.profileName(value) then return value end end
    return memory.lastName
   end,
   remember=function(name)
    if not M.Config.profileName(name) then return end
    memory.lastName=name;if disk then pcall(api.write,folder..'/last-profile.txt',name)end
   end,
  }
 end
 function P.init(app,mode)
  local api
  if type(readfile)=='function' and type(writefile)=='function' and type(isfile)=='function' and type(isfolder)=='function' and type(makefolder)=='function' then
   api={read=readfile,write=writefile,isfile=isfile,isfolder=isfolder,makefolder=makefolder}
  end
  local storage=P.storage(app.player.UserId,mode,api);app.storage=storage
  local http=game:GetService('HttpService')
  local codec=app.codec or {encode=function(v)return http:JSONEncode(v)end,decode=function(s)return http:JSONDecode(s)end}
  app.config=M.Config.new(codec,storage,app.log)
  local last=storage.last()
  app.accountProfile=last or 'default'
  if last then app.loadedProfile=app.config:load(last)end
 end
 function P.page(app)
  local ui=app.ui
  local card=ui:card(ui:page('SETTINGS'),'Konfiguracje konta')
  ui:label(card,app.storage.label)
  app.profileName=ui:field(card,'Nazwa profilu',app.accountProfile)
  function app:saveProfile()
   if app.captureProfile then app:captureProfile()end
   local name=app.profileName.Text;local ok,err=app.config:save(name);if not ok then return false,err end
   app.accountProfile=name;app.storage.remember(name);ui:toast('Config','Zapisano profil.');return true
  end
  function app:loadProfile()
   local name=app.profileName.Text;local ok,err=app.config:load(name);if not ok then return false,err end
   app.accountProfile=name;app.storage.remember(name)
   if app.applyConfig then return app:applyConfig()end
   app:stopAll()
   if app.restoreProfile then app:restoreProfile()end
   if app.movement then app.movement.settings=app.config.data.movement end
   ui:fit();ui:theme();ui:refreshControls();return true
  end
  ui:button(card,'Zapisz profil',function()return app:saveProfile()end)
  ui:button(card,'Wczytaj profil',function()return app:loadProfile()end)
  return card
 end
 return P
end
end)()(M)

-- SOURCE: src/ui/Community.lua
M.CommunityLinks=(function()
return function(M)
 local C={}
 C.links={{'Discord','Kopiuj Discord','https://discord.gg/qmWGb4Q9p'},{'YouTube','Kopiuj YouTube','https://www.youtube.com/@Kubi_Bubi1242'}}
 function C.copy(url)
  if type(setclipboard)~='function' then return false end
  return pcall(setclipboard,url)
 end
 function C.page(app)
  local ui=app.ui
  local card=ui:card(ui:page('SETTINGS'),'Społeczność KUBI HUB')
  ui:label(card,'Dołącz na Discordzie lub zasubskrybuj kanał na YouTube. Kod PRO znajdziesz u twórcy.')
  for _,row in ipairs(C.links)do
   local box=ui:field(card,row[1],row[3]);box.TextEditable=false
   ui:button(card,row[2],function()if C.copy(row[3]) then ui:toast('KUBI HUB','Skopiowano link.')else box:CaptureFocus()end end)
  end
  if app.needPro then
   app.proBody=card
   local key=ui:field(card,'Kod PRO','')
   ui:button(card,'Odblokuj PRO',function()
    local code=key.Text:gsub('%s','');key.Text=''
    if code~='6969' then return false,'Nieprawidłowy klucz.' end
    app.pro=true;ui:toast('PRO','Odblokowano funkcje społeczności.');return true
   end)
  end
  ui:button(card,'Wróć do wyboru huba',function()M.Launcher.back(app)end)
  ui:button(card,'Zmień język',function()app:unload();_G.KubiHubRuntime=M.Launcher.new()end)
 end
 return C
end
end)()(M)

-- SOURCE: src/modules/bike/Application.lua
M.BikeApp=(function()
return function(M)
 local A={};A.__index=A;A.run=M.Application.run
 local N={order={'RIDE','QUICK','SETTINGS'},titles={RIDE='Jazda',QUICK='Narzędzia',SETTINGS='Ustawienia'},matches=M.Navigation.matches}
 function N.resolve(id)return id=='HOME' and 'RIDE' or id=='DEBUG' and 'SETTINGS' or id end
 function N.rank(id)return id=='RIDE' and 1 or id=='QUICK' and 2 or 3 end
 local keys=Enum.KeyCode
 local tricks={keys.One,keys.Two,keys.Three,keys.Four}
 function A:localize(text)return M.Locale.text(self.language,text)end
 function A:inputReady()
  if self.input:GetFocusedTextBox() then return false,'Zamknij pole tekstowe i spróbuj ponownie.'end
  if self.virtual then return true end
  local ok,input=pcall(function()return self.input:CreateVirtualInput()end)
  if not ok or not input then return false,'Ten klient nie udostępnia sterowania wirtualnego Roblox.'end
  self.virtual=input;return true
 end
 function A:press(key,seconds,now)
  local held=self.held[key]
  if held then
   if held==-math.huge then return false,'Poczekaj na zwolnienie klawiszy.'end
   self.held[key]=math.max(held,now+seconds);return true
  end
  local ok,err=pcall(function()self.virtual:SendKey(true,key,false)end)
  if not ok then return false,tostring(err)end
  self.held[key]=now+seconds;return true
 end
 function A:release(key)
  if not self.held[key] then return true end
  local ok=pcall(function()self.virtual:SendKey(false,key,false)end)
  if ok then self.held[key]=nil else self.held[key]=-math.huge end
  return ok
 end
 function A:stop(message)
  self.riding=false;self.rider=nil;self.routeIndex=nil
  for key in pairs(self.held)do self:release(key)end
  self.rideInfo.Text=self:localize(message or 'Jazda zatrzymana.')
  if self.routeInfo then self:updateRouteLabel()end
  self.ui:refreshFeatures()
  return true
 end
 function A:character()
  local c=self.player.Character
  local h=c and c:FindFirstChildOfClass('Humanoid')
  local root=c and c:FindFirstChild('HumanoidRootPart')
  if h and h.Health&gt;0 and root and root:IsA('BasePart')then return c,h,root end
 end
 function A:seat()
  local c,h,root=self:character()
  local seat=h and h.SeatPart
  if seat and seat:IsDescendantOf(workspace) and seat.Occupant==h then return c,root,seat end
 end
 function A:hazard(c,root,seat)
  if seat.CFrame.UpVector.Y&lt;.35 then return 'Rower się przewrócił.'end
  local front=seat.CFrame.LookVector
  local velocity=seat.AssemblyLinearVelocity.Magnitude
  local cfg=RaycastParams.new();cfg.FilterType=Enum.RaycastFilterType.Exclude;cfg.IgnoreWater=true;cfg.RespectCanCollide=true
  cfg.FilterDescendantsInstances={c,seat:FindFirstAncestorOfClass('Model') or seat}
  local reach=math.clamp(5+velocity*.22,5,20)
  if workspace:Raycast(seat.Position+Vector3.new(0,.8,0),front*reach,cfg) then return 'Przeszkoda — jazda zatrzymana.'end
  if not workspace:Raycast(seat.Position+front*reach+Vector3.new(0,3,0),Vector3.new(0,-14,0),cfg) then return 'Brak podłoża przed rowerem.'end
  if self.lastPosition and (root.Position-self.lastPosition).Magnitude&gt;=.75 then self.lastPosition=root.Position;self.lastProgress=self.clock()end
  if self.riding and self.clock()-self.lastProgress&gt;=4 then return 'Rower utknął. Przejmij sterowanie.'end
 end
 function A:startRide()
  if next(self.held) then return false,'Poczekaj na zwolnienie klawiszy.'end
  local c,root,seat=self:seat()
  if not seat then return false,'Najpierw wsiądź na rower.'end
  local ok,err=self:inputReady();if not ok then return false,err end
  local now=self.clock()
  self.routeIndex=nil;self.rider=c;self.riding=true;self.gasAt=now;self.trickAt=now+2;self.lastProgress=now;self.lastPosition=root.Position
  self.rideInfo.Text=self:localize('Automatyczna jazda');return true
 end
 function A:tap(key)
  if self.riding or self.routeIndex then return false,'Najpierw zatrzymaj jazdę.'end
  local ok,err=self:inputReady();if not ok then return false,err end
  return self:press(key,.12,self.clock())
 end
 function A:mark(index)
  if self.routeIndex then return false,'Najpierw zatrzymaj trasę.'end
  local _,_,root=self:character();if not root then return false,'Brak aktywnej postaci.'end
  if index then self.startPoint=root.CFrame
  else
   if #self.checkpoints&gt;=30 then return false,'Limit: 30 checkpointów.'end
   self.checkpoints[#self.checkpoints+1]=root.CFrame
  end
  self:updateRouteLabel();return true
 end
 function A:updateRouteLabel()
  local state=self.routeIndex and (math.max(0,self.routeIndex-1)..' / '..#self.checkpoints) or tostring(#self.checkpoints)
  self.routeInfo.Text=self:localize('Checkpointy')..': '..state
 end
 function A:moveTo(cf)
  local c,h,root=self:character()
  if not root then return false,'Brak aktywnej postaci.'end
  if h.SeatPart then
   local seat=h.SeatPart
   local assembly=seat.Occupant==h and seat.AssemblyRootPart
   if not assembly or assembly.Anchored or not seat:IsDescendantOf(workspace) then return false,'Nie rozpoznano ruchomego roweru.'end
   assembly.CFrame=assembly.CFrame+(cf.Position-root.Position)
  else c:PivotTo(cf*root.CFrame:ToObjectSpace(c:GetPivot())) end
  return true
 end
 function A:raceTick(now)
  local index=self.routeIndex
  if not index or now&lt;self.routeAt then return end
  local point=self.checkpoints[index]
  if not point then self:stop('Trasa zakończona. Sprawdź wynik w grze.');self:updateRouteLabel();return end
  local ok,err=self:moveTo(point)
  if not ok then self:stop(err);self:updateRouteLabel();return end
  self.routeIndex=index+1;self.routeAt=now+1;self:updateRouteLabel()
 end
 function A:update(now)
  for key,untilAt in pairs(self.held)do if now&gt;=untilAt then self:release(key)end end
  if self.routeIndex then self:raceTick(now);return end
  if not self.riding then return end
  local c,root,seat=self:seat();if not seat or c~=self.rider then self:stop('Zejście z roweru.');return end
  if self.input:GetFocusedTextBox() then self:stop('Otwarto pole tekstowe.');return end
  local cfg=self.config.data.bike
  if cfg.guard then local reason=self:hazard(c,root,seat);if reason then self:stop(reason);return end end
  local pace=M.Tempo.bike[cfg.tempo] or M.Tempo.bike.NORMAL
  if now&gt;=self.gasAt then
   local time=pace.gas*(cfg.boost and 1.35 or 1)
   local ok,err=self:press(keys.W,time,now);if not ok then self:stop(err);return end
   self.gasAt=now+time+pace.coast
  end
  if now&gt;=self.trickAt and seat.AssemblyLinearVelocity.Magnitude&gt;=6 then
   self.trickAt=now+pace.interval
   local ok,err=true,nil
   if cfg.wheelie and (not cfg.tricks or self.trickIndex%2==0) then ok,err=self:press(keys.LeftControl,pace.wheelie,now)
   elseif cfg.tricks then
    ok,err=self:press(tricks[self.trickSlot],.12,now);self.trickSlot=self.trickSlot%#tricks+1
   end
   if not ok then self:stop(err)end
   self.trickIndex+=1
  end
 end
 function A:stopAll()self:stop();self:updateRouteLabel();if self.quickTools then self.quickTools:reset()end end
 function A:unload()
  if not self.alive then return end
  self:stopAll();self.alive=false;self.runtime:close();if _G.KubiHubRuntime==self then _G.KubiHubRuntime=nil end
 end
 function A.new(onCreating)
  local self=setmetatable({alive=true,mode='BIKE',clock=os.clock,navigation=N,held={},checkpoints={},trickIndex=0,trickSlot=1},A)
  self.player=game:GetService('Players').LocalPlayer;assert(self.player and self.player:WaitForChild('PlayerGui',10),'Missing local PlayerGui.')
  self.input=game:GetService('UserInputService')
  self.log=M.Log.new(function()return os.date('%H:%M:%S')end)
  self.runtime=M.Runtime.new(self.clock,function(module,err)self.log:error(module,err);if self.ui then self.ui:toast(module,err,true)end end)
  if onCreating then onCreating(self)end
  M.Profiles.init(self,'BIKE')
  self.runtime:own({Destroy=function()for key in pairs(self.held)do self:release(key)end end})
  local ui=M.UI.new(self);self.ui=ui;ui.title.Text='DELUXE / BIKE UNIVERSE'
  local page=ui:page('RIDE')
  local ride=ui:card(page,'Jazda')
  ui:label(ride,'Trzymaj się otwartej drogi. F8 zatrzymuje gaz i triki. Nagrody nalicza gra.')
  self.rideInfo=ui:label(ride,'Gotowy.')
  ui:feature(ride,'Automatyczna jazda',function()return self.riding end,function()if self.riding then return self:stop()end;return self:startRide()end)
  ui:cycle(ride,'Profil tempa',M.Tempo.order,function()return self.config.data.bike.tempo end,function(v)self.config.data.bike.tempo=v end)
  ui:button(ride,'Zresp rower (Q)',function()return self:tap(keys.Q)end)
  ui:button(ride,'Wsiądź (E)',function()return self:tap(keys.E)end)
  for _,row in ipairs({{'Wheelie (Ctrl)','wheelie'},{'Triki 1–4','tricks'},{'Osłona przed kraksą','guard'},{'Boost gazu','boost'},{'Puls podczas bezczynności','antiIdle'}})do
   ui:feature(ride,row[1],function()return self.config.data.bike[row[2]]end,function()local cfg=self.config.data.bike;cfg[row[2]]=not cfg[row[2]]end)
  end
  ui:label(ride,'Boost wydłuża trzymanie W. Osłona próbuje zatrzymać automat przy przeszkodzie, krawędzi lub utknięciu.')
  ui:button(ride,'STOP',function()return self:stopAll()end)
  local race=ui:card(page,'Trasa wyścigu')
  ui:label(race,'Zapisz start i punkty w kolejności. Przyjmij zaproszenie w grze, a po starcie użyj zapisanej trasy.')
  self.routeInfo=ui:label(race,'');self:updateRouteLabel()
  ui:button(race,'Zapisz start',function()return self:mark(true)end)
  ui:button(race,'Dodaj checkpoint',function()return self:mark(false)end)
  ui:button(race,'Przenieś do startu',function()if not self.startPoint then return false,'Najpierw zapisz start.'end;self:stop();return self:moveTo(self.startPoint)end)
  ui:button(race,'Przejedź zapisane checkpointy',function()
   if #self.checkpoints==0 then return false,'Najpierw dodaj checkpointy.'end
   self:stop();self.routeIndex=1;self.routeAt=self.clock();self:updateRouteLabel();return true
  end)
  ui:button(race,'Wyczyść trasę',function()self:stop();self.startPoint=nil;table.clear(self.checkpoints);self:updateRouteLabel()end)
  M.QuickTools(self);M.Profiles.page(self);M.CommunityLinks.page(self)
  ui:show('RIDE');ui:theme()
  self.runtime:connect(self.player.CharacterAdded,function()self:stopAll()end,'Bike')
  self.runtime:connect(self.input.WindowFocusReleased,function()self:stopAll()end,'Bike')
  self.runtime:connect(self.input.InputBegan,function(event)if event.KeyCode==keys.F8 or self.riding and (event.KeyCode==keys.A or event.KeyCode==keys.D or event.KeyCode==keys.S or event.KeyCode==keys.Space) then self:stop()end end,'Bike')
  self.runtime:connect(self.player.Idled,function()
   if not self.riding or not self.config.data.bike.antiIdle then return end
   local c,root,seat=self:seat();if not seat or self.input:GetFocusedTextBox() or self:hazard(c,root,seat) then return end
   if not self.held[keys.W] then local ok,err=self:press(keys.W,.15,self.clock());if not ok then self:stop(err)end end
  end,'Bike')
  ui.statusBody=ui:card(ui:page('SETTINGS'),'Ostatni komunikat');ui.statusInfo=ui:label(ui.statusBody,'Gotowy.')
  self.runtime:connect(game:GetService('RunService').Heartbeat,function(dt)self.runtime:tick(dt)end,'Bike')
  self.runtime:schedule('Bike',.05,function(_,now)
   local ok,err=pcall(self.update,self,now);if not ok then self:stop();self.runtime.errors('Bike',err)end
   ui:tick()
  end)
  return self
 end
 return A
end
end)()(M)

-- SOURCE: src/core/Launcher.lua
M.Launcher=(function()
return function(M)
 local L={};L.__index=L
 local function create(class,props,parent)
  local o=Instance.new(class);for k,v in pairs(props)do o[k]=v end;o.Parent=parent;return o
 end
 local function corner(o,r)create('UICorner',{CornerRadius=UDim.new(0,r)},o)end
 function L.new(language)
  local player=game:GetService('Players').LocalPlayer;assert(player,'KUBI HUB requires a Roblox client.')
  local pg=player:WaitForChild('PlayerGui',10);assert(pg,'Missing PlayerGui.')
  local self=setmetatable({alive=true,connections={}},L);self.runtime=M.Runtime.new(os.clock,function(_,e)warn(e)end)
  local old=pg:FindFirstChild('KubiHubGameChooser');if old then old:Destroy()end
  self.gui=create('ScreenGui',{Name='KubiHubGameChooser',ResetOnSpawn=false,DisplayOrder=100,ZIndexBehavior=Enum.ZIndexBehavior.Sibling},pg);self.runtime:own(self.gui)
  self.frame=create('Frame',{AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromScale(.5,.5),Size=UDim2.fromScale(.9,.85),BackgroundColor3=Color3.fromRGB(15,19,30),BorderSizePixel=0},self.gui)
  create('UISizeConstraint',{MaxSize=Vector2.new(440,465)},self.frame);corner(self.frame,14)
  local close=create('TextButton',{Size=UDim2.fromOffset(28,28),Position=UDim2.new(1,-34,0,5),Text='×',TextColor3=Color3.new(1,1,1),BackgroundTransparency=1,TextSize=18,Font=Enum.Font.GothamBold,ZIndex=3},self.frame)
  self.runtime:connect(close.Activated,function()self:unload()end,'Launcher')
  create('TextLabel',{Size=UDim2.new(1,-60,0,36),Position=UDim2.fromOffset(16,10),BackgroundTransparency=1,TextWrapped=true,Text='KUBI HUB DELUXE 7.0',TextColor3=Color3.fromRGB(235,240,255),TextSize=17,Font=Enum.Font.GothamBold},self.frame)
  self:show(M.Locale.valid(language) and 'games' or 'languages',M.Locale.valid(language) and language or nil)
  return self
 end
 function L:button(id,text,fn)
  self.order+=1
  local b=create('TextButton',{Name=id,Size=UDim2.new(1,-4,0,39),LayoutOrder=self.order,Text=text,BackgroundColor3=Color3.fromRGB(65,110,220),TextColor3=Color3.new(1,1,1),Font=Enum.Font.GothamBold,TextSize=14,TextWrapped=true,BorderSizePixel=0},self.body)
  corner(b,8);self.connections[#self.connections+1]=self.runtime:connect(b.Activated,fn,'Launcher')
 end
 function L:show(screen,language)
  for _,c in ipairs(self.connections)do self.runtime:disconnect(c)end;table.clear(self.connections)
  if self.body then self.body:Destroy()end
  self.screen=screen;self.language=language;self.order=0
  local function t(text)return M.Locale.text(language,text)end
  self.body=create('ScrollingFrame',{Position=UDim2.fromOffset(15,52),Size=UDim2.new(1,-30,1,-65),CanvasSize=UDim2.new(),AutomaticCanvasSize=Enum.AutomaticSize.Y,BackgroundTransparency=1,BorderSizePixel=0,ScrollBarThickness=3},self.frame)
  create('UIListLayout',{Padding=UDim.new(0,6),SortOrder=Enum.SortOrder.LayoutOrder},self.body)
  local function label(text,height)
   self.order+=1;return create('TextLabel',{Size=UDim2.new(1,-5,0,height),LayoutOrder=self.order,BackgroundTransparency=1,Text=text,TextColor3=Color3.fromRGB(180,195,220),TextWrapped=true,TextSize=14,Font=Enum.Font.Gotham},self.body)
  end
  if screen=='languages' then
   self.status=label('Wybierz język / Choose a language',30)
   for _,code in ipairs(M.Locale.codes)do self:button('Language_'..code,M.Locale.names[code],function()self:show('community',code)end)end
  elseif screen=='community' then
   self.status=label(t('Społeczność KUBI HUB'),30)
   label(t('Dołącz na Discordzie lub zasubskrybuj kanał na YouTube. Kod PRO znajdziesz u twórcy.'),60)
   for _,row in ipairs(M.CommunityLinks.links)do
    self:button(row[1],t(row[2]),function()
     local copied=M.CommunityLinks.copy(row[3])
     self.status.Text=copied and t('Skopiowano link.') or t('Społeczność KUBI HUB')
    end)
    self.order+=1
    create('TextBox',{Name=row[1]..'URL',Size=UDim2.new(1,-5,0,28),LayoutOrder=self.order,Text=row[3],TextEditable=false,ClearTextOnFocus=false,BackgroundTransparency=1,TextColor3=Color3.fromRGB(180,195,220),TextSize=11,TextScaled=true,Font=Enum.Font.Gotham},self.body)
   end
   self:button('Continue',t('Dalej do gier'),function()self:show('games',language)end)
  else
   local detected=M.Games.detect(game.PlaceId,game.GameId)
   self.status=label(detected and t('Wykryto')..': '..M.Games.items[detected].name or t('Wybierz grę'),35)
   for _,id in ipairs({'BABFT','MM2','BRAINROT','BIKE','UNIVERSAL'})do
    self:button(id,M.Games.items[id].name,function()
     local ok,err=self:choose(id);if not ok then self.status.Text=err;self.status.TextColor3=Color3.fromRGB(255,125,145)end
    end)
   end
   self:button('ChangeLanguage',t('Zmień język'),function()self:show('languages')end)
  end
 end
 function L.back(app)
  local language=app.language;app:unload();_G.KubiHubRuntime=L.new(language)
 end
 function L:choose(id)
  if not self.alive then return false,'Wybór został już zamknięty.' end
  if self.launching then return false,'Trwa otwieranie wybranego huba.' end
  local allowed,reason=M.Games.canLaunch(id,game.PlaceId,game.GameId,game:GetService('RunService'):IsStudio())
  if not allowed then return false,reason end
  if self.screen~='games' then return false,M.Locale.text(self.language,'Wybierz język')end
  self.launching=true;local partial
  local function creating(app)partial=app;app.language=self.language end
  local apps={BABFT=M.Application,MM2=M.MM2App,BRAINROT=M.BrainrotApp,BIKE=M.BikeApp,UNIVERSAL=M.UniversalApp}
  local ok,app=xpcall(function()return apps[id].new(creating)end,function(e)return tostring(e)..'\n'..debug.traceback()end)
  self.launching=false
  if not ok then if partial then partial.alive=false;partial.runtime:close()end;return false,app end
  self:unload();_G.KubiHubRuntime=app;return true,app
 end
 function L:unload()if not self.alive then return end;self.alive=false;self.runtime:close();if _G.KubiHubRuntime==self then _G.KubiHubRuntime=nil end end
 return L
end
end)()(M)

if _G.KubiHubRuntime and type(_G.KubiHubRuntime.unload)=='function' then _G.KubiHubRuntime:unload() end
if type(_G.KubiHubStopAll)=='function' then local ok,err=pcall(_G.KubiHubStopAll);if not ok then warn('Legacy cleanup: '..tostring(err)) end end
_G.KubiHubRuntime=M.Launcher.new()
return _G.KubiHubRuntime
</ProtectedString></Properties></Item></Item></roblox>
