return function(M)
 return function(app)
  local ui=app.ui;app.travel=M.Travel.new(app.runtime,app.player,app.mode=='UNIVERSAL' or M.Games.detect(game.PlaceId,game.GameId)~=nil or app.runService:IsStudio())
  local t=app.travel;local teleport=ui:page('TELEPORT');local p=ui:card(teleport,'Punkty teleportu','Zapisz własny punkt i wróć do niego. Punkty są przechowywane tylko w tej sesji.')
  local info=ui:label(p,'');local function status()info.Text='Wybrany punkt: '..t.slot..' / 3  ·  '..(t.slots[t.slot] and 'zapisany' or 'pusty') end;status();ui.refreshers[#ui.refreshers+1]=status
  local function options(panel)ui:cycle(panel,'Punkt',{1,2,3},function()return t.slot end,function(v)t.slot=v;status()end);ui:button(panel,'Zapisz obecną pozycję',function()local ok,err=t:save();status();return ok,err end)end
  ui:feature(p,'Zapisz punkt',nil,function()local ok,err=t:save();status();return ok,err end,options)
  ui:feature(p,'Teleport do punktu',nil,function()return t:go(t.slots[t.slot])end,options)
  ui:feature(p,'Wróć do poprzedniej pozycji',nil,function()return t:back()end,function(panel)ui:label(panel,'Powrót działa dla tej samej żywej postaci i zapamiętuje ostatni teleport.')end)
  if app.mode=='UNIVERSAL' then return end
  local fight=ui:page('FIGHT')
  if not app.controller then local f=ui:card(fight,'Fight — MM2','Funkcje walki są dostępne w trybie Murder Mystery 2.');ui:label(f,'Dołącz do MM2, uruchom hub i wybierz MM2.');ui:button(f,'Wróć do wyboru huba',function()M.Launcher.back(app)end) end
 end
end
end)()(M)

-- SOURCE: src/core/Application.lua
M.Application=(function()
return function(M)
 local App={};App.__index=App;App.extraPages=M.ExtraPages
 function App.new(onCreating)
  local self=setmetatable({alive=true,clock=os.clock,pro=false,schemaQuery='',schemaCategory='Wszystkie',schemaSort='Nazwa',manualStep=1,fps=0,lastInventoryAt=0},App)
  self.player=game:GetService('Players').LocalPlayer;assert(self.player,'V5 wymaga klienta / LocalScript.');self.player:WaitForChild('PlayerGui',10)
  self.input=game:GetService('UserInputService');self.runService=game:GetService('RunService');self.http=game:GetService('HttpService')
  self.log=M.Log.new(function()return os.date('%Y-%m-%d %H:%M:%S')end)
  self.runtime=M.Runtime.new(self.clock,function(module,err)self.log:error(module,err);if self.ui then self.ui:toast(module,err,true) end end)
  if onCreating then onCreating(self) end
  self.codec={encode=function(v)return self.http:JSONEncode(v)end,decode=function(s)return self.http:JSONDecode(s)end}
  M.Profiles.init(self,'BABFT')
  self.library=M.Library.new();for _,err in ipairs(self.library.errors) do self.log:error('Schematics',err) end
  self.adapterContext={userId=self.player.UserId,placeId=game.PlaceId,clock=self.clock,spawn=task.spawn,wait=task.wait,alive=function()return self.alive end}
  self.adapter=M.Adapter.new(self.adapterContext)
  if game.PlaceId==537413528 then self.babft=M.BabftAdapter.new(self.adapterContext,M.BabftEnvironment.new(self.player,workspace,task.wait,self.clock,function()return self.alive end)) end
  self.farm=M.Farm.new(self.runtime,self.adapter,self.config.data.farm,self.log,task.spawn)
  self.builder=M.Builder.new(self.runtime,self.adapter,self.log,task.spawn)
  self.movement=M.Movement.new(self.runtime,self.adapter,self.player,self.input,self.log,self.config.data.movement)
  self.effects=M.Effects.new(self.clock);self.inventorySnapshot=M.Inventory.snapshot(nil,'Oczekiwanie na dane')
  self.readInventory=M.Inventory.observePlayer(self.player,self.runtime,function(snapshot)if not self.serverInventory then self.inventorySnapshot=snapshot;self.previewDirty=true end end)
  self.ui=M.UI.new(self);self:pages();M.QuickTools(self);self:select('WORM_MK2');self.ui:show('FARM');self.ui:theme()
  self.runtime:connect(self.player.CharacterAdded,function()if not (self.adapter.mode=='BABFT' and self.adapter:expectingRespawn() and (self.farm.state=='RUNNING' or self.farm.state=='PAUSED')) then self.farm:stop('Respawn — uruchom ponownie ręcznie.') end;self.movement:reset();if self.builder:isBusy() then self.builder:cancel('Respawn — anulowanie własnej budowy.') end;if self.babft then self.babft.buildVerified=false;self.babft.capabilities.build=false end;self.effects:clear()end,'Character')
  self.runtime:connect(self.runService.Heartbeat,function(dt)
   self.fps=self.fps==0 and 1/math.max(dt,.001) or self.fps*.94+math.min(240,1/math.max(dt,.001))*.06
   self.runtime:tick(dt)
  end,'Scheduler')
  self.runtime:connect(self.runService.RenderStepped,function()self.movement:tick()end,'Movement')
  self.runtime:schedule('Controllers',.1,function()
   for _,item in ipairs({{'Farm',function()self.farm:tick()end,function(err)self.farm:stop();self.farm.stats.lastError=tostring(err);self.farm.state='ERROR'end},{'Builder',function()self.builder:tick()end,function(err)self.builder:fail(err)end},{'Efekty',function()self.effects:tick()end,function()self.effects:clear()end}}) do
    local ok,err=pcall(item[2]);if not ok then item[3](err);self.log:error(item[1],err);self.ui:toast(item[1],err,true) end
   end
   self.ui:tick()
  end)
  self.runtime:schedule('Dashboard',1,function()self:updateDashboard()end)
  self.runtime:schedule('InventoryRefresh',2,function()if self.adapter.capabilities.inventory and not self.adapter.pending and not self.builder:isBusy() and self.farm.state=='STOPPED' then self:refreshInventory() end end)
  self.runtime:schedule('PreviewRefresh',.2,function()if self.previewDirty and self.ui.current=='MISC' then self:refreshPreview() end end)
  self.runtime:job('Adapter',function()
   local ok,err=self.adapter:connect(game:GetService('ReplicatedStorage'))
   if not ok and self.babft then
    self.adapter=self.babft;self.farm.adapter=self.adapter;self.builder.adapter=self.adapter;self.movement.adapter=self.adapter;ok,err=self.adapter:connect()
    if self.loadedProfile then self:select('legacy_RAFT')
    else self:select('legacy_RAFT',true);self.builder:center();self.config.data.builder=M.Util.copy(self.builder.options);self:refreshPreview()end
   end
   if ok then self.log:add('Adapter',self.adapter.label) else self.log:add('Adapter',err,'WARN') end;self:refreshInventory();return true
  end,task.spawn)
  self.log:add('Core','KUBI HUB DELUXE V'..M.Version.current..' uruchomiony.');self:updateDashboard();return self
 end
 function App:run(module,fn)
  if not self.alive then return false end
  local ok,a,b=xpcall(fn,function(e)return tostring(e)..'\n'..debug.traceback()end)
  if not ok then self.log:error(module,a);self.ui:toast(module,a,true);return false end
  if type(a)=='table' and a.ok~=nil then b=a.error;a=a.ok end
  if a==false then self.log:add(module,tostring(b or 'Funkcja niedostępna.'),'WARN');self.ui:toast(module,b or 'Funkcja niedostępna.',true);return false end
  if self.builder and self.builder.revision~=self.previewRevision then self.previewDirty=true;self.ui:refreshControls() end;return true
 end
 function App:notify(module,text)self.log:add(module,text);self.ui:toast(module,text)end
 function App:copy(text,box)
  if box then box.Text=text end
  if type(setclipboard)=='function' then setclipboard(text);self:notify('Tools','Skopiowano tekst.') else self:notify('Tools','Tekst jest w polu. Zaznacz go i skopiuj ręcznie.') end
 end
 function App:needPro(feature)
  if self.pro then return true end;self.ui:reveal(self.proBody);self.ui:toast('PRO','Wpisz klucz w sekcji PRO — społeczność i klucz, aby odblokować '..feature);return false,'Funkcja PRO wymaga klucza.'
 end
 function App:applyConfig()
  self:stopAll();self.farm.settings=self.config.data.farm;self.movement.settings=self.config.data.movement
  if self.builder:isBusy() then self.deferredConfig=true;return true end
  if self.builder.source then local ok,err=self.builder:edit(self.config.data.builder);if not ok then return false,err end end
  self.ui:fit();self.ui:theme();self.ui:refreshControls();self.previewDirty=true;return true
 end
 function App:refreshInventory()
  if not self.adapter.capabilities.inventory then self.inventorySnapshot=self.readInventory();return end
  local reply=self.adapter:inventory();if reply.ok and type(reply.values)=='table' then self.serverInventory=true;self.inventorySnapshot=M.Inventory.snapshot(reply.values,reply.source or self.adapter.label);self.previewDirty=true else self.log:add('Inventory',reply.error or 'Brak danych adaptera.','WARN') end
 end
 function App:testBabftBuild()
  if self.adapter.mode~='BABFT' then return false,'Ten test jest dostępny w BABFT.' end
  if self.runtime.lock or self.adapter.pending or self.probeJob and not self.probeJob.done then return false,'Najpierw zatrzymaj aktywny moduł lub poczekaj na odpowiedź narzędzia.' end
  local ok,err=self.runtime:acquire('BuildTest');if not ok then return false,err end
  self.probeJob=self.runtime:job('BuildTest',function()
   local worked,result=xpcall(function()return self.adapter:testBuild()end,tostring);self.runtime:release('BuildTest')
   if not self.alive then return end
   if not worked then self:notify('Builder','Test nie powiódł się: '..tostring(result));return false end
   self.log:add('Builder',result.message or result.error,result.ok and 'INFO' or 'WARN');self.ui:toast('Builder',result.message or result.error,not result.ok);self:updateDashboard();return result.ok
  end,task.spawn);return true
 end
 function App:select(id,reset)
  local item=self.library.items[id];if not item then return false,'Nie znaleziono schematu.' end
  local ok,err=self.builder:select(item,reset);if not ok then return false,err end
  if reset then self.config.data.builder=M.Util.copy(self.builder.options) end
  if item.mechanical then self.config.data.builder.mirrorX=false;self.config.data.builder.mirrorZ=false;self.config.data.builder.scale=1 end
  ok,err=self.builder:edit(self.config.data.builder,false);if not ok then return false,err end
  self.manualStep=1;self.previewDirty=true;self.ui:refreshControls();self:refreshPreview();return true
 end
 function App:refreshPreview()
  if not self.builder.schema or not self.preview then return end
  local p=M.Performance.get(self.config.data.performance.profile,self.fps);self.preview:set(self.builder.schema,self.inventorySnapshot,{limit=p.previewLimit,layer=self.config.data.builder.previewLayer,yaw=self.builder.options.yaw});self.previewDirty=false;self.previewRevision=self.builder.revision
  local report=self.builder:assistant(self.inventorySnapshot);local b=report.bounds.size
  self.planInfo.Text=string.format('%s\n%d części • %d połączeń • %.1f × %.1f × %.1f studów\nPodgląd: %d obiektów / %d części. Czerwone: brakujące, bursztynowe: nieodczytane.',self.builder.schema.name,report.elements,report.connections,b[1],b[2],b[3],self.preview.shown,report.elements)
  self.materialInfo.Text='Źródło: '..self.inventorySnapshot.source..'\n'..M.Inventory.describe(report.materials)
  if self.placementInfo then
   local b=self.builder.bounds;local zone=self.adapter.zone;local fits=zone and b.min[1]&gt;=(zone.min and zone.min[1] or -zone.size[1]/2)-1e-6 and b.max[1]&lt;=(zone.max and zone.max[1] or zone.size[1]/2)+1e-6 and b.min[3]&gt;=(zone.min and zone.min[3] or -zone.size[3]/2)-1e-6 and b.max[3]&lt;=(zone.max and zone.max[3] or zone.size[3]/2)+1e-6
   self.placementInfo.Text=string.format('Skala %.0f%% • środek X %.1f / Z %.1f\n%s',(self.builder.options.scale or 1)*100,b.center[1],b.center[3],zone and (fits and 'Obrys X/Z mieści się w odczytanym obszarze. Serwer sprawdzi również wysokość i uprawnienia.' or 'Obrys X/Z wychodzi poza odczytany obszar.') or 'Granice działki nieodczytane. Ręczne wymiary poniżej służą do planowania.')
  end
  self:updateStep()
 end
 function App:updateStep()
  if not self.stepInfo or not self.builder.schema then return end
  local list=self.builder.schema.elements;self.manualStep=math.clamp(self.manualStep,1,#list);local e=list[self.manualStep]
  self.stepInfo.Text=string.format('Krok %d / %d: %s\nID %s • %s\nPozycja %.2f / %.2f / %.2f • obrót %.1f / %.1f / %.1f\nTo instrukcja i podgląd, nie potwierdzenie budowy w grze.',self.manualStep,#list,e.name,e.id,e.material,e.position[1],e.position[2],e.position[3],e.rotation[1],e.rotation[2],e.rotation[3])
 end
 function App:renderSchematics()
  self.ui:clearList(self.schemaList)
  local list=self.library:list(self.schemaQuery,self.schemaCategory,self.schemaSort,self.config.data.favorites,self.onlyFavorites)
  self.schemaCount.Text=#list..' pasujących projektów. Wbudowane modele pojazdów zachowują geometrię; sterowanie potwierdzamy osobno.'
  for _,item in ipairs(list) do local schema=item;local tag=(item.assistantOnly or item.importedMechanics) and 'PODGLĄD' or item.mechanical and 'MECHANIKA' or 'STATYCZNY';self.ui:button(self.schemaList,(self.config.data.favorites[item.id] and '★ ' or '')..item.name..'  ·  '..#item.elements..'  ['..tag..']',function()local ok,err=self:select(schema.id);if ok then self.ui:show('BUILDER') end;return ok,err end,'Kategoria: '..item.category..'. Otwórz podgląd, materiały i kroki.',true) end
 end
 function App:loadCommunity(asset)
  if self.builder:isBusy() then return false,'Najpierw zakończ budowanie.' end
  if self.communityJob and not self.communityJob.done then return false,'Trwa wczytywanie modelu.' end
  self.communityJob=self.runtime:job('Community',function()
   local text=game:HttpGet('https://raw.githubusercontent.com/kubibubi124269/script-kubi-hub-babft/main/assets/community/'..asset.file)
   if not self.alive then return false end;if type(text)~='string' or #text&gt;2000000 then error('Nieprawidłowy plik modelu / limit 2 MB.') end
   local schema,errors=M.Schema.import(self.codec.decode(text));if not schema then error(table.concat(errors,'; ')) end
   if #schema.elements~=asset.parts or schema.importedMechanics then error('Model nie zgadza się z katalogiem geometrii statycznej.') end
   schema.id='community_'..asset.id;schema.name=asset.name;schema.source=asset.url;schema.geometryOnly=true
   local ok,err=self.library:save(schema);if not ok then error(err) end
   ok,err=self:select(schema.id,true);if not ok then error(err) end;self.builder:center()
   if self.adapter.zone then local fitted,fitError=self.builder:fit(self.adapter.zone);if not fitted then self.log:add('Community',fitError,'WARN') end end
   self.config.data.builder=M.Util.copy(self.builder.options);self:renderSchematics();self:refreshPreview();self.ui:show('BUILDER');self:notify('Community',asset.name..': '..asset.parts..' części. '..asset.adaptation);return true
  end,task.spawn);return true
 end
 function App:pages()
  local ui=self.ui
  self:extraPages()
  local home=ui:page('HOME','HOME');local h=ui:card(home,'KUBI HUB DELUXE V'..M.Version.current,'Nowy warsztat z walidowanymi schematami, profilem ustawień i jawnym stanem zgodności. Brak adaptera oznacza tryb asystenta.')
  self.homeInfo=ui:label(h,'',125);ui:button(h,'WORM MK2 — otwórz warsztat',function()local ok,err=self:select('WORM_MK2');ui:show('BUILDER');return ok,err end)
  ui:button(h,'Wróć do wyboru huba',function()M.Launcher.back(self)end)
  ui:button(h,'Biblioteka schematów',function()ui:show('SCHEMATICS')end);ui:button(h,'STOP WSZYSTKIE MODUŁY',function()self:stopAll()end)
  local news=ui:card(home,'Ostatnie zmiany','Materiały z osobnymi identyfikatorami. WORM z grafem połączeń. Stos: 1 laska dynamitu, 1 siedzenie, 3000 drewna. Nowy podgląd i profile. Uprawnione budowanie wymaga adaptera.')
  self.versionInfo=ui:label(news,'V'..M.Version.current..' • wydanie '..M.Version.releaseDate..'. Najnowsza wersja: jeszcze nie sprawdzono.',85)
  ui:button(news,'Sprawdź aktualizację',function()
   if self.versionJob and not self.versionJob.done then return false,'Trwa sprawdzanie wersji.' end
   self.versionJob=self.runtime:job('Version',function()local value,err=M.Version.fetch(function(url)return game:HttpGet(url)end,self.codec.decode);if not value then self.log:add('Version',err,'WARN');self.versionInfo.Text=err;return false end;self.versionInfo.Text='Obecna '..M.Version.current..' • najnowsza '..value.version..' • '..value.releaseDate..'\n'..value.compatibility..'\n'..table.concat(value.changes,'; ');self:notify('Version',value.update and 'Dostępna jest aktualizacja. Kod nie został podmieniony.' or 'Brak nowszej wersji.');return true end,task.spawn)
  end)
  local farm=ui:page('FARM','FARM');local f=ui:card(farm,'Kontroler cykli','BABFT: trasa dziesięciu etapów, skrzynia i oczekiwanie na powrót postaci. Profile zmieniają przerwę między etapami. Licznik mierzy zakończone przejazdy i respawn; nie potwierdza przyznania nagród.')
  self.farmAvailability=ui:label(f,'');self.farmInfo=ui:label(f,'',155)
  ui:button(f,'Odśwież trasę BABFT',function()if self.adapter.mode~='BABFT' then return false,'Odświeżanie tej trasy jest dostępne w BABFT.' end;if self.farm.state~='STOPPED' then return false,'Najpierw zatrzymaj autofarmę.' end;self.adapter:connect();self:updateDashboard();return self.farm:availability()end)
  ui:feature(f,'Autofarma BABFT',function()return self.farm.state=='RUNNING' or self.farm.state=='PAUSED' or self.farm.state=='RETRY' end,function()if self.farm.state=='STOPPED' or self.farm.state=='ERROR' then return self.farm:start() else return self.farm:stop() end end,function(panel)
   ui:slider(panel,'Czas przejścia przez etap (s)',function()return self.config.data.farm.crossingTime end,function(v)self.config.data.farm.crossingTime=v end,.4,3,.1)
   ui:field(panel,'Zatrzymaj po cyklach (0 = bez limitu)',0,function(v)self.config.data.farm.stopAfter=M.Util.number(tonumber(v),0,0,10000,true);return self.config.data.farm.stopAfter end,false,function()return self.config.data.farm.stopAfter end)
   ui:button(panel,'RESET SESJI',function()return self.farm:reset()end)
  end)
  ui:cycle(f,'Profil tempa',{'NORMAL','FAST','TURBO','HYPER','LIGHTNING','SONIC'},function()return self.config.data.farm.profile end,function(v)self.config.data.farm.profile=v end)
  ui:cycle(f,'Tryb trasy',{'Przejście','Teleport szybki'},function()return self.config.data.farm.route end,function(v)self.config.data.farm.route=v end)
  ui:button(f,'PAUZA / WZNÓW',function()if self.farm.state=='PAUSED' then return self.farm:resume() else return self.farm:pause() end end)
  ui:button(f,'STOP',function()return self.farm:stop()end)
  local builder=ui:page('BUILDER','BUILDER');local b=ui:card(builder,'Podgląd 3D i budowanie','Przeciągnij podgląd, by obrócić kamerę. Kółko myszy lub przyciski zmieniają zoom. Obszar podglądu jest oddzielony od świata gry.')
  ui.routes.BUILDER=b;self.preview=M.Preview.new(b);self.runtime:own(self.preview.viewport)
  ui:bind(self.preview.viewport.InputBegan,function(i)if ui:isPress(i) then ui.previewDrag=i.Position end end)
  ui:bind(self.preview.viewport.InputChanged,function(i)if i.UserInputType==Enum.UserInputType.MouseWheel then self.preview:changeZoom(math.exp(-i.Position.Z*.15)) end end)
  self.planInfo=ui:label(b,'',112)
  for _,v in ipairs({{'Widok perspektywiczny','PERSPECTIVE'},{'Widok z góry','TOP'},{'Widok z boku','SIDE'}}) do local a=v;ui:button(b,a[1],function()self.preview:view(a[2])end) end
  ui:button(b,'Przybliż',function()self.preview:changeZoom(.8)end);ui:button(b,'Oddal',function()self.preview:changeZoom(1.25)end)
  ui:field(b,'Warstwa • 0 = wszystkie',0,function(v)self.config.data.builder.previewLayer=M.Util.number(tonumber(v),0,0,1000,true);self.previewDirty=true;return self.config.data.builder.previewLayer end,false,function()return self.config.data.builder.previewLayer or 0 end)
  self.materialInfo=ui:label(b,'',180)
  ui:button(b,'Kopiuj listę materiałów',function()local text=M.Inventory.describe(M.Inventory.compare(self.builder.schema,self.inventorySnapshot));self:copy(text,self.schemaBox);self:notify('Builder','Lista materiałów znajduje się też w polu importu / eksportu.')end)
  self.buildAvailability=ui:label(b,'')
  self.buildTestButton=ui:button(b,'TEST 1 BLOKU — sprawdź narzędzie BABFT',function()return self:testBabftBuild()end,'Stawia jeden drewniany blok na własnej działce. Pozostawia go w grze i sprawdza jego obecność. Nie uruchamia pełnego schematu.')
  self.babftRefresh=ui:button(b,'Odśwież narzędzia i działkę BABFT',function()if self.adapter.mode~='BABFT' then return false,'Ten przycisk jest dostępny w BABFT.' end;if self.builder:isBusy() or self.adapter.pending or self.farm.state~='STOPPED' then return false,'Najpierw zatrzymaj aktywny moduł.' end;self.adapter:connect();self:refreshInventory();self:refreshPreview();self:updateDashboard();self:notify('BABFT',self.adapter.diagnostics);return true end)
  self.buildButton=ui:button(b,'ASYSTENT — pokaż kroki budowania',function()
   if not self.adapter.capabilities.build then ui:reveal(self.assistantBody);return true end
   self:refreshPreview();return self.builder:start(self.inventorySnapshot)
  end,'Bez połączenia z budowaniem: instrukcja ręczna. Po potwierdzeniu uprawnień serwera: budowa na własnej działce.')
  self.staticButton=ui:button(b,'Przygotuj nieruchomą wersję schematu',function()
   local schema,omitted=self.builder:staticDraft(self:newSchemaId('static'));if not schema then return false,omitted end
   local ok,err=self.library:save(schema);if not ok then return false,err end;ok,err=self:select(schema.id,true);if not ok then return false,err end
   self.builder:center();self.config.data.builder=M.Util.copy(self.builder.options);self:renderSchematics();self:refreshPreview();self:updateDashboard();self:notify('Builder','Przygotowano nieruchomy model. Pominięte wyposażenie: '..omitted..'. Nie zawiera zawiasów ani sterowania. Budowanie uruchom osobno.');return true
  end)
  ui:settingsFor(self.buildButton,'Builder — ustawienia planu',function(panel)
   local function option(key,value)local out=M.Util.copy(self.builder.options);out[key]=value;local ok,err=self.builder:edit(out);if ok then self.config.data.builder=M.Util.copy(self.builder.options);self.previewDirty=true end;return ok,err end
   ui:cycle(panel,'Materiał',{'ORIGINAL','WoodBlock','MetalBlock','TitaniumBlock','PlasticBlock'},function()return self.builder.options.material end,function(v)return option('material',v)end)
   ui:cycle(panel,'Obrót',{0,90,180,270},function()return self.builder.options.yaw end,function(v)return option('yaw',v)end)
   ui:button(panel,'Pozycja i dopasowanie',function()ui:reveal(self.placementBody)end)
   ui:button(panel,'Biblioteka schematów',function()ui:show('SCHEMATICS')end)
  end)
  self.buildControls={ui:button(b,'Pauza budowania',function()return self.builder:pause()end),ui:button(b,'Wznów budowanie',function()return self.builder:resume()end),ui:button(b,'Anuluj własną transakcję',function()return self.builder:cancel()end)}
  self.buildInfo=ui:label(b,'',75)
  local edits=ui:card(builder,'Edytor i historia','Obrót dotyczy budowy na działce; kamera podglądu obraca się niezależnie. Odbicie mechanicznego rig-u jest zablokowane, by nie uszkodzić jego osi.')
  local function edit(k,v)local options=M.Util.copy(self.builder.options);options[k]=v;local ok,err=self.builder:edit(options);if ok then self.config.data.builder=M.Util.copy(options);self.previewDirty=true end;return ok,err end
  ui:cycle(edits,'Obrót', {0,90,180,270},function()return self.builder.options.yaw end,function(v)return edit('yaw',v)end)
  ui:cycle(edits,'Materiał',{'ORIGINAL','WoodBlock','MetalBlock','TitaniumBlock','PlasticBlock'},function()return self.builder.options.material end,function(v)return edit('material',v)end)
  ui:toggle(edits,'Lustro X',function()return self.builder.options.mirrorX end,function(v)return edit('mirrorX',v)end);ui:toggle(edits,'Lustro Z',function()return self.builder.options.mirrorZ end,function(v)return edit('mirrorZ',v)end)
  ui:button(edits,'UNDO',function()local ok,err=self.builder:undo();if ok then self.config.data.builder=M.Util.copy(self.builder.options) end;return ok,err end);ui:button(edits,'REDO',function()local ok,err=self.builder:redo();if ok then self.config.data.builder=M.Util.copy(self.builder.options) end;return ok,err end)
  local placement=ui:card(builder,'Pozycja i dopasowanie schematu','Przesunięcia są w osiach konstrukcji przed obrotem. Wyśrodkowanie oraz dopasowanie zapisują jedną zmianę w UNDO. Mechaniki nie zmniejszam.')
  self.placementBody=placement
  self.placementInfo=ui:label(placement,'',115)
  for _,spec in ipairs({{'Przesunięcie X','offsetX'},{'Przesunięcie Y','offsetY'},{'Przesunięcie Z','offsetZ'}}) do local f=spec;ui:field(placement,f[1],0,function(v)local value=tonumber(v);if not M.Util.finite(value) or math.abs(value)&gt;1000 then return false,'Podaj przesunięcie od -1000 do 1000.' end;local ok,err=edit(f[2],value);if not ok then return false,err end;return value end,false,function()return self.builder.options[f[2]] or 0 end) end
  ui:field(placement,'Skala zwykłego planu • procent',100,function(v)local value=tonumber(v);if not M.Util.finite(value) or value&lt;10 or value&gt;200 then return false,'Skala: 10–200%.' end;local ok,err=edit('scale',value/100);if not ok then return false,err end;return value end,false,function()return (self.builder.options.scale or 1)*100 end)
  local function changed(ok,err)if ok then self.config.data.builder=M.Util.copy(self.builder.options);self.previewDirty=true;ui:refreshControls() end;return ok,err end
  ui:button(placement,'Wyśrodkuj schemat X/Z',function()return changed(self.builder:center())end)
  self.manualZone={width=120,depth=120}
  for _,spec in ipairs({{'Ręczna szerokość obszaru','width'},{'Ręczna długość obszaru','depth'}}) do local f=spec;ui:field(placement,f[1],self.manualZone[f[2]],function(v)self.manualZone[f[2]]=M.Util.number(tonumber(v),120,10,300);return self.manualZone[f[2]] end) end
  ui:button(placement,'Dopasuj do obszaru',function()local w,d=self.manualZone.width,self.manualZone.depth;local zone=self.adapter.zone or {size={w,200,d},min={-w/2+1,-6,-d/2+1},max={w/2-1,200,d/2-1}};return changed(self.builder:fit(zone))end,'Używa granic adaptera, jeśli są znane. Inaczej używa ręcznych wymiarów z marginesem jednego studa; jest to pomoc w planowaniu.')
  local assistant=ui:card(builder,'Asystent ręcznego budowania','Współrzędne są względem konstrukcji. Stos drewna zawiera celowe nałożenie elementów; nie uruchamiam eksplozji ani nie wysyłam go do publicznego serwera.')
  self.assistantBody=assistant
  self.stepInfo=ui:label(assistant,'',140);ui:button(assistant,'Poprzedni element',function()self.manualStep=self.manualStep-1;self:updateStep()end);ui:button(assistant,'Następny element',function()self.manualStep=self.manualStep+1;self:updateStep()end)
  ui:field(assistant,'Przejdź do elementu',1,function(v)self.manualStep=M.Util.number(tonumber(v),self.manualStep,1,#self.builder.schema.elements,true);self:updateStep();return self.manualStep end,false,function()return self.manualStep end)
  local schematics=ui:page('SCHEMATICS','SCHEMATICS');local sc=ui:card(schematics,'Biblioteka konstrukcji','Zachowana geometria poprzednich projektów, WORM MK2 oraz własne projekty. Stan mechaniki jest oddzielony od samego planu.')
  ui.routes.SCHEMATICS=sc;ui.routes.SHAPES=sc
  ui:field(sc,'Szukaj schematu','',function(v)self.schemaQuery=v;self:renderSchematics();return v end)
  ui:cycle(sc,'Kategoria',{'Wszystkie','Pojazdy','Łodzie','Samoloty','Konstrukcje mechaniczne','WORMS','Proste budowle','Własne projekty'},function()return self.schemaCategory end,function(v)self.schemaCategory=v;self:renderSchematics()end)
  ui:cycle(sc,'Sortuj',{'Nazwa','Bloki'},function()return self.schemaSort end,function(v)self.schemaSort=v;self:renderSchematics()end)
  ui:toggle(sc,'Tylko ulubione',function()return self.onlyFavorites==true end,function(v)self.onlyFavorites=v;self:renderSchematics()end)
  ui:button(sc,'Dodaj / usuń wybrany z ulubionych',function()local id=self.builder.source.id;self.config.data.favorites[id]=not self.config.data.favorites[id];self:renderSchematics()end)
  self.schemaCount=ui:label(sc,'',60);self.schemaList=ui:create('Frame',{Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,BackgroundTransparency=1},sc);ui:create('UIListLayout',{Padding=UDim.new(0,6),SortOrder=Enum.SortOrder.LayoutOrder},self.schemaList);self:renderSchematics()
  local assets=ui:card(schematics,'Modele społeczności — tylko podgląd','Zachowane pliki czerwonego WORM-a i SHREDDER-a. Odczytuję JSON z tego repozytorium. Ich oryginalne połączenia pozostają w plikach; importer nie udaje gotowej mechaniki.')
  for _,spec in ipairs({{'Czerwony WORM','worm-red.json'},{'SHREDDER','shredder.json'}}) do local a=spec;ui:button(assets,'Wczytaj podgląd: '..a[1],function()
   local text=game:HttpGet('https://raw.githubusercontent.com/kubibubi124269/script-kubi-hub-babft/main/'..a[2]);if #text&gt;2000000 then return false,'Plik przekracza 2 MB.' end
   local schema,errors=M.Schema.import(self.codec.decode(text));if not schema then return false,table.concat(errors,'; ') end;schema.id='asset_'..a[2]:gsub('[^%w]','_');schema.name=a[1]..' — podgląd';schema.assistantOnly=true;schema.importedMechanics=true
   local ok,err=self.library:save(schema);if not ok then return false,err end;ok,err=self:select(schema.id,true);if ok then self:renderSchematics();ui:show('BUILDER') end;return ok,err
  end) end
  local community=ui:card(builder,'Modele z internetu — dom i zamek','Przystosowane wersje statyczne: budynek oraz architektura zamku, z kolorami i rozmiarami bloków. Wyposażenie i mechanizmy oryginału są pominięte. Oryginalne pliki i źródła zachowano w repozytorium. BUILD wymaga testu narzędzia, materiałów oraz narzędzi skalowania i malowania.')
  for _,row in ipairs(M.Community) do local asset=row;ui:button(community,'Wczytaj: '..asset.name..' / '..asset.parts..' części',function()return self:loadCommunity(asset)end);ui:button(community,'Źródło: '..asset.name,function()self:copy(asset.url,self.schemaBox);self:notify('Community',asset.credit..' '..asset.url)end) end
  local movement=ui:page('MOVEMENT','MOVEMENT');local mv=ui:card(movement,'Ruch własnej postaci','W dozwolonym środowisku testowym: WASD / joystick, Spacja w górę, lewy Ctrl w dół. Respawn zatrzymuje moduł i wymaga ręcznego wznowienia.')
  self.movementInfo=ui:label(mv,'',75)
  local function movementOptions(panel)for _,a in ipairs({{'WalkSpeed','walk',8,60},{'Siła skoku','jump',20,120},{'Prędkość Fly','flySpeed',10,100}})do local field=a;ui:slider(panel,field[1],function()return self.config.data.movement[field[2]]end,function(v)self.config.data.movement[field[2]]=v end,field[3],field[4],1)end end
  ui:feature(mv,'Zastosuj ruch',nil,function()return self.movement:apply()end,movementOptions)
  ui:feature(mv,'Fly',function()return self.movement.fly end,function()if self.movement.fly then self.movement:stopFly();return true else return self.movement:startFly() end end,movementOptions)
  ui:button(mv,'Przywróć oryginalny ruch',function()return self.movement:reset()end)
  local player=ui:page('PLAYER','PLAYER');local pl=ui:card(player,'Postać i efekty lokalne','Efekty widoczne u Ciebie. WORM wymaga obsługi mechaniki przez połączony serwer.')
  self.playerInfo=ui:label(pl,'');self.cloneScale=.4
  local function effectsOptions(panel)ui:button(panel,'Wyczyść efekty',function()self.effects:clear()end)end
  ui:feature(pl,'Konfetti',nil,function()local _,_,r=self.movement:character();self.effects:confetti(r)end,effectsOptions)
  ui:feature(pl,'Tęczowy ślad • PRO',function()return self.effects.rainbow~=nil end,function()if not self:needPro('tęczowy ślad') then return false,'Wymagany klucz.' end;local _,_,r=self.movement:character();self.effects:trail(r)end,effectsOptions)
  ui:feature(pl,'Kopia awatara',nil,function()self.effects:clone(self.player.Character,self.cloneScale)end,function(panel)ui:slider(panel,'Rozmiar kopii',function()return self.cloneScale end,function(v)self.cloneScale=v end,.2,2,.1);effectsOptions(panel)end)
  ui:feature(pl,'Paszcza WORM-a',nil,function()return self.adapter:rig('mouth')end,function(panel)ui:label(panel,'Klawisz E. Wymaga połączonego rig-u i obsługi zawiasów; obecny tryb BABFT nie obsługuje mechaniki.')end)
  local tools=ui:page('TOOLS','TOOLS');self:toolsPage(tools)
  local settings=ui:page('SETTINGS','SETTINGS');self:settingsPage(settings)
  ui.statusBody=ui:card(settings,'Ostatni komunikat','Kliknięcie paska u dołu huba otwiera tutaj pełną treść komunikatu. Starsze wpisy są w raporcie błędów.')
  ui.statusInfo=ui:label(ui.statusBody,'Gotowy. Brak nowych komunikatów.')
  local stats=ui:page('STATS','STATS');local st=ui:card(stats,'Rzeczywiste pomiary sesji','Brak pomiaru jest oznaczony „—”. FPS dotyczy klienta. Czas odpowiedzi adaptera jest osobnym pomiarem i nie jest przedstawiany jako ping Roblox.');ui.routes.STATS=st
  self.statsInfo=ui:label(st,'',210);self.lastSession=ui:label(st,_G.KubiHubLastSession and ('Poprzednia sesja:\n'.._G.KubiHubLastSession) or 'Pierwsza sesja V'..M.Version.current..'.',100)
  local debugPage=ui:page('DEBUG','DEBUG');local dbg=ui:card(debugPage,'Raport błędów, zadania i zgodność','Raport zawiera datę, moduł, poziom i szczegóły błędu. Nie zawiera tokenów ani odczytu plików przeglądarki.');ui.routes.DEBUG=dbg;self.debugBody=dbg
  self.debugInfo=ui:label(dbg,'',140);self.debugBox=ui:field(dbg,'Raport do skopiowania','',nil,true);self.debugBox.Size=UDim2.new(1,0,0,260)
  ui:button(dbg,'Odśwież raport',function()self.debugBox.Text=self:report()end);ui:button(dbg,'Skopiuj raport',function()self:copy(self:report(),self.debugBox)end);ui:button(dbg,'Wyczyść historię',function()self.log:clear();self.debugBox.Text='' end)
  local performance=ui:page('PERFORMANCE','PERFORMANCE');local perf=ui:card(performance,'Wydajność KUBI HUB','Profile zmieniają limit obiektów podglądu i częstotliwość statystyk. Nie zmieniają Windows, innych aplikacji ani całego świata gry.');ui.routes.PERFORMANCE=perf
  ui:cycle(perf,'Profil',{'QUALITY','BALANCED','PERFORMANCE'},function()return self.config.data.performance.profile end,function(v)self.config.data.performance.profile=v;self.previewDirty=true end);self.performanceInfo=ui:label(perf,'',110)
  ui:button(perf,'Wyczyść podgląd i efekty',function()self.preview:clear();self.effects:clear();self.previewDirty=false end);ui:button(perf,'Przywróć podgląd',function()self.previewDirty=true;self:refreshPreview()end)
 end
 function App:toolsPage(page)
  local ui=self.ui;local c=ui:card(page,'Import / eksport schematów','Tylko JSON lub dane LP_BUILD. Tekst nigdy nie jest uruchamiany jako Lua. Połączenia WORM-a w formacie V5 są zachowywane.')
  self.schemaBox=ui:field(c,'Dane projektu','',nil,true)
  ui:button(c,'Eksport wybranego schematu',function()local schema,errors=self.builder:export();if not schema then return false,table.concat(errors,'; ') end;self:copy(self.codec.encode(schema),self.schemaBox)end)
  ui:button(c,'Import i zapisz własny projekt',function()
   local text=self.schemaBox.Text;if #text&gt;2000000 then return false,'Limit pliku 2 MB.' end
   if text:match('^%s*LP_META') then local marker=text:find('LP_BUILD',1,true);if not marker then return false,'Brak sekcji LP_BUILD.' end;text=text:sub(marker+8) end
   local raw=self.codec.decode(text);local schema,errors=M.Schema.import(raw);if not schema then return false,table.concat(errors,'; ') end
   schema.id=self:newSchemaId('custom');schema.name='Własny projekt '..self.library.revision+1;local ok,value=self.library:save(schema);if not ok then return false,value end;self:select(schema.id,true);self:renderSchematics();self:notify('Schematics','Zapisano własny schemat w sesji. Eksport JSON służy do trwałej kopii.');return true
  end)
  ui:button(c,'Eksport własnej budowli serwerowej',function()if not self.adapter.capabilities.build then return false,'Brak uprawnionego adaptera eksportu.' end;local r=self.adapter:snapshot();if not r.ok then return false,r.error end;self:copy(self.codec.encode(r.schema),self.schemaBox)end)
  local shapePage=ui:page('SHAPES','Shapes');local generators=ui:card(shapePage,'Shape Lab — bryły','Kula, kopuła, spirala i ściana. Gotowe konstrukcje znajdziesz wyżej w bibliotece. Osobna zakładka Circle Maker służy do kół i łuków.')
  self.generator={radius=10,segments=32,layers=1,kind='WoodBlock',filled=false};self.generatorKind='SPHERE'
  local function generatorOptions(panel)
  ui:cycle(panel,'Generator',{'SPHERE','DOME','SPIRAL','WALL'},function()return self.generatorKind end,function(v)self.generatorKind=v end)
  for _,spec in ipairs({{'Promień','radius',2,28},{'Bloki obwodu / zwoju','segments',8,120},{'Liczba warstw','layers',1,20}}) do local f=spec;ui:field(panel,f[1],self.generator[f[2]],function(v)self.generator[f[2]]=M.Util.number(tonumber(v),self.generator[f[2]],f[3],f[4],true);return self.generator[f[2]] end) end
  ui:cycle(panel,'Materiał',{'WoodBlock','MetalBlock','TitaniumBlock','PlasticBlock'},function()return self.generator.kind end,function(v)self.generator.kind=v end)
  ui:toggle(panel,'Wypełnienie',function()return self.generator.filled end,function(v)self.generator.filled=v end)
  end
  ui:rememberTerm(generators,'kula kopuła spirala ściana promień warstwy materiał')
  ui:feature(generators,'Utwórz plan i pokaż',nil,function()
   local o=M.Util.copy(self.generator);local p;if self.generatorKind=='CIRCLE' then p=M.LegacyShapes.circle(o) elseif self.generatorKind=='SPHERE' or self.generatorKind=='DOME' then o.dome=self.generatorKind=='DOME';p=M.LegacyShapes.sphere(o) elseif self.generatorKind=='SPIRAL' then o.turns=o.layers;p=M.LegacyShapes.spiral(o) else o.width=o.radius;o.height=o.layers;p=M.LegacyShapes.wall(o) end
   local schema,errors=M.Schema.fromLegacy(self:newSchemaId('generated'),'Generator '..self.generatorKind,p,'Własne projekty');if not schema then return false,table.concat(errors,'; ') end;local ok,err=self.library:save(schema);if not ok then return false,err end;ok,err=self:select(schema.id,true);if not ok then return false,err end;self:renderSchematics();self.ui:show('BUILDER')
  end,generatorOptions)
  local circlePage=ui:page('CIRCLE','Circle Maker');local circle=ui:card(circlePage,'Circle Maker — koła, dyski i łuki','Ustaw środek konstrukcji względem własnej działki, materiał, rozmiar i warstwy. Podgląd oraz lista materiałów pojawią się w Builderze.')
  ui.routes.CIRCLE=circle;self.circle={radius=12,segments=40,layers=1,thickness=1,layerGap=2,arc=360,axis='XZ',kind='WoodBlock',filled=false,x=0,y=2,z=0}
  local function circleOptions(panel)
  for _,spec in ipairs({{'Promień','radius',2,50},{'Bloki na obwodzie','segments',8,120},{'Liczba warstw','layers',1,20},{'Grubość pierścienia','thickness',1,8},{'Odstęp warstw','layerGap',.5,10},{'Łuk w stopniach','arc',15,360},{'Środek X','x',-50,50},{'Środek Y','y',0,100},{'Środek Z','z',-50,50}}) do local s=spec;ui:field(panel,s[1],self.circle[s[2]],function(v)self.circle[s[2]]=M.Util.number(tonumber(v),self.circle[s[2]],s[3],s[4],s[2]=='layers' or s[2]=='segments' or s[2]=='thickness');return self.circle[s[2]] end) end
  ui:cycle(panel,'Materiał',{'WoodBlock','MetalBlock','TitaniumBlock','PlasticBlock','GlassBlock'},function()return self.circle.kind end,function(v)self.circle.kind=v end)
  ui:cycle(panel,'Płaszczyzna',{'XZ','XY','YZ'},function()return self.circle.axis end,function(v)self.circle.axis=v end);ui:toggle(panel,'Wypełniony dysk',function()return self.circle.filled end,function(v)self.circle.filled=v end)
  end
  ui:rememberTerm(circle,'promień warstwy materiał środek grubość płaszczyzna łuk')
  ui:feature(circle,'GENERUJ KOŁO — podgląd i materiały',nil,function()
   local o=self.circle;local estimated=o.filled and (2*math.floor(o.radius/2)+1)^2*o.layers or (o.segments+1)*o.layers*o.thickness
   if estimated&gt;M.Schema.limit then return false,'Plan może przekroczyć '..M.Schema.limit..' części. Zmniejsz promień, warstwy albo grubość.' end
   local parts=M.LegacyShapes.circle(o);for _,p in ipairs(parts) do p.x=p.x+o.x;p.y=p.y+o.y;p.z=p.z+o.z end
   local schema,errors=M.Schema.fromLegacy(self:newSchemaId('circle'),'Koło / łuk '..o.radius,parts,'Własne projekty');if not schema then return false,table.concat(errors,'; ') end
   local ok,err=self.library:save(schema);if not ok then return false,err end;ok,err=self:select(schema.id,true);if ok then self:renderSchematics();ui:show('BUILDER') end;return ok,err
  end,circleOptions)
  local dynamite=ui:card(shapePage,'Dynamit + drewno — plan','3000 drewnianych bloków w jednym punkcie nad laską dynamitu i jedno siedzenie. To plan / asystent; detonacja i wysyłanie nakładających się bloków na publiczny serwer są wyłączone.')
  ui:button(dynamite,'Otwórz dokładny plan stosu',function()local ok,err=self:select('DYNAMITE_STACK');ui:show('BUILDER');return ok,err end)
 end
 function App:settingsPage(page)
  local ui=self.ui;local card=M.Profiles.page(self)
  self.configBox=ui:field(card,'Konfiguracja JSON','',nil,true)
  ui:button(card,'Eksport ustawień',function()self:copy(self.config:export(),self.configBox)end);ui:button(card,'Import ustawień',function()local ok,err=self.config:import(self.configBox.Text);if not ok then return false,err end;return self:applyConfig()end)
  ui:button(card,'Przywróć poprzednią konfigurację',function()local ok,err=self.config:rollback();if not ok then return false,err end;return self:applyConfig()end);ui:button(card,'Ustawienia domyślne',function()self.config:reset();return self:applyConfig()end)
  ui:cycle(card,'Akcent',{'BLUE','PURPLE'},function()return self.config.data.ui.theme end,function(v)self.config.data.ui.theme=v;ui:theme()end)
  ui:toggle(card,'Tryb kompaktowy',function()return self.config.data.ui.compact end,function(v)self.config.data.ui.compact=v;ui:fit()end);ui:toggle(card,'Podpowiedzi',function()return self.config.data.ui.tooltips end,function(v)self.config.data.ui.tooltips=v end)
  ui:button(card,'Pomoc i nawigacja',function()self:notify('Pomoc','Prawy Ctrl ukrywa okno. U góry wyszukaj nazwę funkcji. Kliknij nagłówek sekcji, aby ją rozwinąć. Raport błędów i wydajność znajdziesz w Settings.')end)
  M.CommunityLinks.page(self)
  ui:button(card,'Wyłącz hub i posprzątaj',function()self:unload()end)
 end
 function App:newSchemaId(prefix)
  local id;repeat self.schemaSerial=(self.schemaSerial or 0)+1;id=prefix..'_'..math.floor(self.clock()*1000)..'_'..self.schemaSerial until not self.library.items[id];return id
 end
 function App:report()
  local count=self.runtime:counts();local lines={self.log:text(),'Wersja: '..M.Version.current,'','Środowisko: '..self.adapter.label,'Tryb BABFT: '..tostring(self.adapter.mode=='BABFT'),'Test bloku BABFT: '..tostring(self.adapter.buildVerified==true),'Most serwera KUBI: '..tostring(self.adapter.session~=nil),'Zadania klienta: '..count.jobs,'Połączenia klienta: '..count.connections,'Harmonogramy: '..count.schedules,'Otwarte RF adaptera: '..tostring(self.adapter.pending~=nil),'Źródło materiałów: '..self.inventorySnapshot.source,self.adapter.diagnostics or ''}
  if self.builder.schema then lines[#lines+1]=M.Inventory.describe(M.Inventory.compare(self.builder.schema,self.inventorySnapshot)) end
  return table.concat(lines,'\n')
 end
 function App:updateDashboard()
  self.ui:refreshFeatures()
  if self.deferredConfig and not self.builder:isBusy() then self.deferredConfig=false;self:applyConfig() end
  local fs=self.farm:summary();local counts=self.runtime:counts();local _,hum,root=self.movement:character();local speed=root and root.AssemblyLinearVelocity.Magnitude;local active=(self.farm.state=='RUNNING' and 1 or 0)+(self.builder:isBusy() and 1 or 0)+(self.movement.fly and 1 or 0)+(#self.effects.objects&gt;0 and 1 or 0)
  local p=M.Performance.get(self.config.data.performance.profile,self.fps);self.runtime.schedules.Dashboard.interval=p.statsInterval
  self.homeInfo.Text=string.format('Wersja %s • %s\nAktywne moduły: %d\nFarm: %s • Builder: %s\nSchematy: %d • błędy walidacji biblioteki: %d',M.Version.current,self.adapter.label,active,self.farm.state,self.builder.state,#self.library:list(),#self.library.errors)
  local canBuild=self.adapter.capabilities.build==true;local native=self.adapter.mode=='BABFT'
  self.buildTestButton.Visible=native;self.babftRefresh.Visible=native
  self.ui.subtitle.Text='V'..M.Version.current..'  •  '..(canBuild and 'BUDOWANIE POŁĄCZONE' or 'TRYB ASYSTENTA')
  self.buildAvailability.Text=native and (canBuild and 'BABFT: test narzędzia potwierdzony. BUILD obsługuje statyczną geometrię. Mechanika WORM-a pozostaje niedostępna. STOP zatrzymuje kolejne żądania; już postawione bloki pozostają.' or 'BABFT: najpierw TEST 1 BLOKU. Wymaga własnej działki, narzędzia budowania i drewna. Narzędzia skalowania / malowania są potrzebne tylko planom, które ich wymagają.') or (canBuild and 'Serwer potwierdził dostęp do budowania na własnej działce.' or 'W tej sesji budowanie w grze jest niedostępne. Możesz używać podglądu, generatorów, listy materiałów i instrukcji ręcznej.')
  self.buildButton.Text=canBuild and (native and 'BUILD — zbuduj statyczny plan w BABFT' or 'BUILD — sprawdź i zbuduj przez adapter') or 'ASYSTENT — pokaż kroki budowania'
  local schema=self.builder.schema;local incompatible=schema and (schema.mechanical or schema.importedMechanics or #schema.connections&gt;0) and not self.adapter.capabilities.mechanics
  self.staticButton.Visible=incompatible==true and not schema.assistantOnly and not schema.intentionalOverlap
  self.buildButton.Visible=not (canBuild and incompatible)
  if incompatible then self.buildAvailability.Text='Ten schemat wymaga mechaniki, której obecny tryb nie obsługuje. Możesz przygotować osobną nieruchomą wersję.' end
  for _,button in ipairs(self.buildControls) do button.Visible=canBuild end
  local farmAvailable,farmReason=self.farm:availability();self.farmAvailability.Text=farmReason;self.farmAvailability.TextColor3=farmAvailable and self.ui.palette.text or self.ui.palette.red
  self.farmInfo.Text=string.format('Stan: %s • etap: %d\nCykle potwierdzone %d • nieudane %d\nŚredni cykl: %s s • cykle/h: %s\nOstatni błąd: %s',fs.state,fs.stage,fs.completed,fs.failed,fs.average and string.format('%.2f',fs.average) or '—',fs.cyclesPerHour and string.format('%.1f',fs.cyclesPerHour) or '—',fs.lastError~='' and fs.lastError or '—')
  if self.babft and self.babft.platform.route.phase then self.farmInfo.Text=self.farmInfo.Text..'\n'..self.babft.platform.route.phase end
  self.buildInfo.Text=string.format('Stan: %s\nCzęści potwierdzone przez serwer: %d / %d\n%s',self.builder.state,self.builder.placed,self.builder.total,self.builder.error or '')
  self.movementInfo.Text=string.format('Prędkość rzeczywista: %s stud/s\nFly: %s • uprawnienie: %s',speed and string.format('%.1f',speed) or '—',self.movement.fly and 'ON' or 'OFF',self.adapter.capabilities.movement and 'potwierdzone' or 'brak adaptera')
  self.playerInfo.Text=hum and string.format('%s\nZdrowie: %.0f / %.0f • stan: %s',self.player.DisplayName,hum.Health,hum.MaxHealth,hum:GetState().Name) or 'Oczekiwanie na postać.'
  self.statsInfo.Text=string.format('Sesja %.1f min • FPS %.1f\nCykle %d • nieudane %d\nŚredni czas cyklu %s s\nOdpowiedź adaptera %s ms\nZadania %d • połączenia %d • harmonogramy %d\nBrak symulowanych nagród ani złota.',fs.elapsed/60,self.fps,fs.completed,fs.failed,fs.average and string.format('%.2f',fs.average) or '—',self.adapter.lastLatency and string.format('%.1f',self.adapter.lastLatency) or '—',counts.jobs,counts.connections,counts.schedules)
  self.debugInfo.Text='Środowisko: '..self.adapter.label..'\nZadania klienta: '..counts.jobs..' • aktywne połączenia: '..counts.connections..'\nFarm / Builder / Movement: '..self.farm.state..' / '..self.builder.state..' / '..(self.movement.fly and 'FLY' or 'OFF')
  if self.ui.current=='SETTINGS' and self.debugBody.Visible then self.debugBox.Text=self:report() end
  self.performanceInfo.Text=string.format('FPS %.1f • limit podglądu %d\nCzęstotliwość statystyk: co %.1f s\nObiekty podglądu: %d • lokalne efekty: %d',self.fps,p.previewLimit,p.statsInterval,#self.preview.parts,#self.effects.objects)
 end
 function App:stopAll()
  self.farm:stop();self.builder:cancel();self.movement:reset();self.effects:clear();self.adapter:cancel('all');if self.quickTools then self.quickTools:reset()end;self:notify('Core','Zatrzymano moduły. Trwające żądanie serwera może jeszcze kończyć zatwierdzanie; stan sprawdzisz w Settings / Raport błędów.')
 end
 function App:unload()
  if not self.alive then return end
  self:stopAll();local f=self.farm:summary();_G.KubiHubLastSession=string.format('%d cykli potwierdzonych, %d nieudanych, %.1f min. Bez deklaracji testów fizyki.',f.completed,f.failed,f.elapsed/60)
  self.alive=false;self.runtime:close();if _G.KubiHubRuntime==self then _G.KubiHubRuntime=nil end
 end
 function App:captureProfile()
  local layer=self.config.data.builder.previewLayer
  self.config.data.builder=M.Util.copy(self.builder.options);self.config.data.builder.previewLayer=layer
 end
 return App
end
end)()(M)

-- SOURCE: src/modules/mm2/Application.lua
M.MM2App=(function()
return function(M)
 local A={};A.__index=A
 A.extraPages=M.ExtraPages;A.run=M.Application.run;A.notify=M.Application.notify;A.copy=M.Application.copy
 function A.new(onCreating)
  local self=setmetatable({alive=true,clock=os.clock,navigation=M.MM2Navigation,fps=0},A)
  self.players=game:GetService('Players');self.player=self.players.LocalPlayer;assert(self.player,'Brak LocalPlayer.');self.player:WaitForChild('PlayerGui',10)
  self.input=game:GetService('UserInputService');self.runService=game:GetService('RunService');self.http=game:GetService('HttpService')
  self.log=M.Log.new(function()return os.date('%H:%M:%S')end);self.runtime=M.Runtime.new(self.clock,function(module,e)self.log:error(module,e);if self.ui then self.ui:toast(module,e,true) end end)
  if onCreating then onCreating(self) end
  M.Profiles.init(self,'MM2')
  self.platform=M.MM2Platform.new(self.player,self.players,workspace,game.PlaceId,game.GameId);self.controller=M.MM2Controller.new(self.runtime,self.platform,self.clock);self.avatar=M.AvatarAppearance.new(self.platform,self.runtime);self.controller.avatar=self.avatar;self.controller.itemESP={coins=false,gun=false,range=120};self.runtime:own(self.avatar);self.avatar:bind(self.runService)
  self:restoreProfile()
  self.adapter={mode='MM2',capabilities={movement=self.platform.allowed},cancel=function()end}
  self.adapter.movement=function(_,values)local _,h=self.platform:character();if not self.platform.allowed or not h then return {ok=false,error='Brak aktywnej postaci MM2.'} end;h.WalkSpeed=values.walk;if h.UseJumpPower then h.JumpPower=values.jump else h.JumpHeight=values.jump^2/(2*workspace.Gravity) end;return {ok=true}end
  self.movement=M.Movement.new(self.runtime,self.adapter,self.player,self.input,self.log,self.config.data.movement);self.effects=M.Effects.new(self.clock)
  self.ui=M.UI.new(self);self.ui.title.Text='KUBI HUB DELUXE / MM2';self:pages();M.QuickTools(self);self.ui:show('FARM');self.ui:theme();self:updateDashboard()
  self.runtime:connect(self.runService.Heartbeat,function(dt)self.fps=self.fps==0 and 1/math.max(dt,.001) or self.fps*.95+1/math.max(dt,.001)*.05;self.runtime:tick(dt)end,'MM2')
  self.runtime:connect(self.runService.RenderStepped,function()self.movement:tick()end,'Movement')
  self.runService:BindToRenderStep('KubiHubMM2Aim',Enum.RenderPriority.Camera.Value+1,function(dt)if self.alive then local ok,err=pcall(function()self.controller:aimTick(dt)end);if not ok then self.controller.aimbot=false;self.controller.autoShot=false;self.log:error('Aim',err);self.ui:toast('Aim',err,true);self.ui:refreshControls() end end end)
  self.runtime:own({Destroy=function()self.runService:UnbindFromRenderStep('KubiHubMM2Aim')end})
  local manualKeys={Enum.KeyCode.W,Enum.KeyCode.A,Enum.KeyCode.S,Enum.KeyCode.D,Enum.KeyCode.Up,Enum.KeyCode.Down,Enum.KeyCode.Left,Enum.KeyCode.Right,Enum.KeyCode.Space}
  self.runService:BindToRenderStep('KubiHubMM2FarmMotion',Enum.RenderPriority.Character.Value+1,function()
   local c=self.controller;if not self.alive or not c.farming then return end
   local manual=self.input:GetFocusedTextBox()~=nil
   for _,key in ipairs(manualKeys)do if self.input:IsKeyDown(key) then manual=true;break end end
   local ok,err=pcall(c.farmMotionTick,c,manual)
   if not ok then c:stopFarm();c.lastError=tostring(err);self.log:error('MM2 Farm',err);self.ui:toast('MM2 Farm',err,true);self.ui:refreshFeatures()end
  end)
  self.runtime:own({Destroy=function()self.runService:UnbindFromRenderStep('KubiHubMM2FarmMotion')end})
  self.runtime:connect(self.player.CharacterAdded,function()self.controller:stopFarm();self.controller:stopCombat();self.avatar:reset();self.movement:reset();self.effects:clear();self.skins:reset();self.ui:refreshFeatures()end,'Respawn')
  self.runtime:schedule('MM2Controllers',.05,function(dt)
   local ok,err=pcall(function()self.controller:tick(dt)end)
   if not ok then self.controller:stopAll();self.log:error('MM2',err);self.ui:toast('MM2',err,true);self.ui:refreshControls() end
   self.effects:tick();self.ui:tick()
  end)
  self.runtime:schedule('MM2Status',.5,function()self.platform:updateESP(self.controller.esp);self.platform:updateItems(self.controller.itemESP);local ok,err=self.avatar:refresh();if not ok then self.ui:toast('Postać',err,true)end;self:updateDashboard()end)
  return self
 end
 function A:pages()
  local ui=self.ui;local c=self.controller;self:extraPages()
  local farm=ui:page('FARM');local f=ui:card(farm,'Autofarma MM2','Postać leci do pobliskich monet lub cukierków. Poniżej możesz zmienić Lot na Chód. Pełna torba wstrzymuje zbieranie, a odrodzenie je wyłącza.')
  self.farmInfo=ui:label(f,'')
  ui:feature(f,'Monety / cukierki',function()return c.farming end,function()if c.farming then return c:stopFarm() else return c:startFarm() end end,function(panel)
   ui:cycle(panel,'Zbieraj',{'BOTH','COIN','CANDY'},function()return c.kind end,function(v)return c:setFilter(v)end)
   ui:slider(panel,'Zasięg szukania (study)',function()return c.farmRange end,function(v)c.farmRange=v;c:refreshFarm()end,8,45,1)
   ui:slider(panel,'Czekanie na odbiór (s)',function()return c.pickupTimeout end,function(v)c.pickupTimeout=v end,.3,2,.1)
   ui:button(panel,'Odśwież przedmioty',function()c:refreshFarm()end)
   ui:button(panel,'Reset statystyk',function()return c:resetStats()end)
  end)
  ui:cycle(f,'Ruch',{'Lot','Chód'},function()return c.farmMotion end,function(v)return c:setFarmMotion(v)end)
  ui:cycle(f,'Profil tempa',M.Tempo.order,function()return c.farmTempo or 'NORMAL'end,function(v)return c:setTempo(v)end)
  ui:label(f,'Profil zmienia tempo lotu i szukania. Szybki lot może podlegać ograniczeniom serwera.')
  ui:button(f,'PAUZA / WZNÓW',function()return c:pauseFarm()end);ui:button(f,'STOP zbierania',function()return c:stopFarm()end)
  local combat=ui:page('FIGHT');local aim=ui:card(combat,'Celowanie i walka','Auto Shot wymaga własnego pistoletu. Kill all i Knife Aura wymagają własnego noża. Skutki akcji zatwierdza gra.')
  self.combatInfo=ui:label(aim,'')
  local function targets(panel)
   ui:cycle(panel,'Cel',{'MURDERER','NEAREST','SELECTED'},function()return c.settings.target end,function(v)c.settings.target=v end)
   ui:field(panel,'Dokładny nick',c.settings.selected,function(v)c.settings.selected=v;return v end,false,function()return c.settings.selected end)
  end
  local function aimOptions(panel)
   targets(panel);ui:slider(panel,'Zasięg w pikselach',function()return c.settings.fov end,function(v)c.settings.fov=v end,40,500,10)
   ui:slider(panel,'Szybkość celowania',function()return c.settings.smooth end,function(v)c.settings.smooth=v end,5,60,1)
   ui:toggle(panel,'Sprawdzaj ściany',function()return c.settings.wallCheck end,function(v)c.settings.wallCheck=v end)
  end
  ui:feature(aim,'Aimbot',function()return c.aimbot end,function()c.aimbot=not c.aimbot end,aimOptions)
  ui:feature(aim,'Auto Shot',function()return c.autoShot end,function()c.autoShot=not c.autoShot end,function(panel)aimOptions(panel);ui:slider(panel,'Przerwa strzałów (s)',function()return c.settings.shotInterval end,function(v)c.settings.shotInterval=v end,.35,3,.05)end)
  ui:feature(aim,'Kill all',function()return c.combat and c.combat.kind=='KILL_ALL' end,function()if c.combat and c.combat.kind=='KILL_ALL' then return c:stopCombat() else return c:startKillAll() end end,function(panel)ui:label(panel,'Jeden obieg żywych postaci z własnym nożem. STOP przerywa akcję.');ui:button(panel,'STOP walki',function()return c:stopCombat()end)end)
  ui:feature(aim,'Knife Aura',function()return c.aura end,function()c.aura=not c.aura end,function(panel)ui:label(panel,'Własny nóż. Zasięg 6 studów, przerwa 0,45 s.');ui:button(panel,'Wyłącz aurę',function()c.aura=false;ui:refreshControls()end)end)
  local trolling=ui:page('TROLLING');local tr=ui:card(trolling,'Fling','Krótka próba fizyki własnej postaci. Skutek zależy od kolizji i serwera.')
  c.flingSettings={target='NEAREST',selected='',duration=1.5}
  ui:feature(tr,'Fling',function()return c.combat and c.combat.kind=='FLING' end,function()if c.combat and c.combat.kind=='FLING' then return c:stopCombat() else return c:startFling() end end,function(panel)
   ui:cycle(panel,'Cel',{'NEAREST','MURDERER','SELECTED'},function()return c.flingSettings.target end,function(v)c.flingSettings.target=v end)
   ui:field(panel,'Dokładny nick celu','',function(v)c.flingSettings.selected=v;return v end,false,function()return c.flingSettings.selected end)
   ui:field(panel,'Czas: 0.5–3 s',1.5,function(v)c.flingSettings.duration=M.Util.number(tonumber(v),1.5,.5,3);return c.flingSettings.duration end,false,function()return c.flingSettings.duration end)
   ui:button(panel,'STOP Fling',function()return c:stopCombat()end)
  end)
  M.AppearanceControls(self,trolling,true)
  ui:feature(tr,'Konfetti',nil,function()local _,_,r=self.platform:character();self.effects:confetti(r)end,function(panel)ui:label(panel,'Efekt widoczny u Ciebie.');ui:button(panel,'Wyczyść efekty',function()self.effects:clear()end)end)
  local players=ui:page('MISC');local p=ui:card(players,'Gracze i przedmioty','Czerwony: nóż. Niebieski: pistolet. Żółty: nieznana rola. Oznaczenia są lokalne.')
  self.rolesInfo=ui:label(p,'')
  local function playerOptions(panel)
   local names={};for _,person in ipairs(self.platform:people())do names[#names+1]=person.player.Name end;if #names==0 then names={'Brak graczy'}end
   ui:cycle(panel,'Gracz',names,function()return c.settings.selected end,function(v)c.settings.selected=v end)
   ui:field(panel,'Dokładny nick',c.settings.selected,function(v)c.settings.selected=v;return v end,false,function()return c.settings.selected end)
  end
  ui:feature(p,'Podgląd gracza',function()return self.platform.spectating~=nil end,function()if self.platform.spectating then self.platform:stopWatch();return true end;local ok,err=self.platform:watch(c.settings.selected);if ok then c.aimbot=false;c.autoShot=false end;return ok,err end,playerOptions)
  self.proximity=false;self.alertDistance=30;self.threatInfo=ui:label(p,'')
  ui:feature(p,'Ostrzeżenie o Murdererze',function()return self.proximity end,function()self.proximity=not self.proximity;self:updateDashboard()end,function(panel)ui:slider(panel,'Odległość ostrzeżenia',function()return self.alertDistance end,function(v)self.alertDistance=v end,10,100,5);ui:label(panel,'Rozpoznaje wyłącznie gracza z widocznym nożem.')end)
  ui:feature(p,'ESP ról',function()return c.esp end,function()c.esp=not c.esp;self.platform:updateESP(c.esp)end,function(panel)ui:label(panel,'Czerwony — nóż, niebieski — pistolet, żółty — nieznana rola.')end)
  ui:feature(p,'Auto podnoszenie pistoletu',function()return c.autoGun end,function()c.autoGun=not c.autoGun end,function(panel)ui:label(panel,'Odwiedza upuszczony GunDrop, gdy nie masz broni i inne moduły ruchu są wyłączone.')end)
  local travel=ui:card(ui:page('TELEPORT'),'Upuszczona broń');ui:feature(travel,'Podnieś pistolet',nil,function()if self.runtime.lock then return false,'Najpierw zatrzymaj moduł '..self.runtime.lock end;return self.platform:pickupGun()end,function(panel)ui:label(panel,'Przenosi do pistoletu obecnego na mapie.')end)
  ui:feature(travel,'Teleport do gracza',nil,function()local person=self.platform:selected(c.settings.selected);if not person then return false,'Wybierz aktywnego gracza pod PPM.' end;return self.travel:go(person.root.CFrame*CFrame.new(3,0,0))end,playerOptions)
  local items=ui:card(players,'Przedmioty na mapie')
  ui:feature(items,'Podświetl monety / cukierki',function()return c.itemESP.coins end,function()c.itemESP.coins=not c.itemESP.coins;self.platform:updateItems(c.itemESP)end,function(panel)
   ui:field(panel,'Zasięg: 10–300',c.itemESP.range,function(v)c.itemESP.range=M.Util.number(tonumber(v),120,10,300);return c.itemESP.range end,false,function()return c.itemESP.range end)
   ui:label(panel,'Do 40 najbliższych rzeczywistych przedmiotów. Nie uruchamia zbierania.')
  end)
  ui:feature(items,'Podświetl upuszczony pistolet',function()return c.itemESP.gun end,function()c.itemESP.gun=not c.itemESP.gun;self.platform:updateItems(c.itemESP)end,function(panel)ui:label(panel,'Oznacza rzeczywisty GunDrop na mapie, gdy jest dostępny.')end)
  self.skins=M.MM2Skins(self,players)
  local roles=ui:card(players,'Szybki podgląd ról')
  local locations=ui:card(ui:page('TELEPORT'),'Skróty do graczy')
  for _,row in ipairs({{'Murderer','Murderera'},{'Sheriff','Sheriffa'}})do local role,label=row[1],row[2]
   local function help(panel)ui:label(panel,'Wybiera najbliższego gracza z widoczną bronią tej roli. Brak broni oznacza brak pewnego rozpoznania.')end
   ui:feature(roles,'Podgląd '..label,function()return self.platform.spectating and self.platform.spectating.role==role end,function()
    if self.platform.spectating and self.platform.spectating.role==role then self.platform:stopWatch();return true end
    local person,err=self.platform:personByRole(role);if not person then return false,err end
    local ok,why=self.platform:watch(person.player.Name);if ok then c.aimbot=false;c.autoShot=false end;return ok,why
   end,help)
   ui:feature(locations,'Teleport do '..label,nil,function()local person,err=self.platform:personByRole(role);if not person then return false,err end;return self.travel:go(person.root.CFrame*CFrame.new(3,0,0))end,help)
  end
  local move=ui:card(players,'Własna postać')
  local function moveOptions(panel)for _,spec in ipairs({{'WalkSpeed','walk',8,60},{'Skok','jump',20,120},{'Fly speed','flySpeed',10,100}}) do local s=spec;ui:slider(panel,s[1],function()return self.config.data.movement[s[2]]end,function(v)self.config.data.movement[s[2]]=v end,s[3],s[4],1)end end
  ui:feature(move,'Zastosuj ruch',nil,function()return self.movement:apply()end,moveOptions)
  ui:feature(move,'Fly',function()return self.movement.fly end,function()if self.movement.fly then self.movement:stopFly();return true else return self.movement:startFly() end end,moveOptions)
  ui:button(move,'Przywróć ruch',function()return self.movement:reset()end)
  local settings=ui:page('SETTINGS');local s=ui:card(settings,'KUBI HUB / MM2')
  self.homeInfo=ui:label(s,'');ui:button(s,'STOP WSZYSTKO',function()self:stopAll()end)
  ui:cycle(s,'Akcent',{'BLUE','PURPLE'},function()return self.config.data.ui.theme end,function(v)self.config.data.ui.theme=v;ui:theme()end);ui:toggle(s,'Tryb kompaktowy',function()return self.config.data.ui.compact end,function(v)self.config.data.ui.compact=v;ui:fit()end)
  M.Profiles.page(self);M.CommunityLinks.page(self)
  ui.statusBody=ui:card(settings,'Ostatni komunikat');ui.statusInfo=ui:label(ui.statusBody,'Gotowy.')
  local debug=ui:card(settings,'Raport MM2');ui.routes.DEBUG=debug
  self.debugBox=ui:field(debug,'Raport do skopiowania','',nil,true);ui:button(debug,'Skopiuj raport MM2',function()self:copy(self:report(),self.debugBox)end);ui:button(debug,'Wyłącz hub',function()self:unload()end)
 end
 function A:captureProfile()
  local c=self.controller;self.config.data.mm2={tempo=c.farmTempo or 'NORMAL',kind=c.kind,motion=c.farmMotion,range=c.farmRange,timeout=c.pickupTimeout}
 end
 function A:restoreProfile()
  local c,s=self.controller,self.config.data.mm2
  c.farmRange=s.range;c.pickupTimeout=s.timeout;c:setTempo(s.tempo);c:setFarmMotion(s.motion);c:setFilter(s.kind)
 end
 function A:report()
  local c=self.controller;return self.log:text()..'\nWersja: '..M.Version.current..string.format('\nMM2 wykryte: %s\nWłasna broń / rola: %s\nZbieranie: %s\nPróby odbioru: %d\nZniknięcia obiektów po próbie: %d\nAktywacje pistoletu: %d\nAktywacje noża: %d\nOstatni błąd: %s',tostring(self.platform.allowed),self.platform:role(self.player),c.state,c.attempts,c.disappeared,c.shots,c.stabs,c.lastError)
 end
 function A:updateDashboard()
  self.ui:refreshFeatures()
  self.platform:updateWatch()
  self.skins:updateLabel()
  if self.threatInfo then local person,distance=self.platform:nearestMurderer();self.threatInfo.Visible=self.proximity;self.threatInfo.Text=person and (distance&lt;=self.alertDistance and 'UWAGA: ' or '')..person.player.Name..' · '..math.floor(distance)..' studów' or 'Brak gracza z wykrytym nożem.';self.threatInfo.TextColor3=person and distance&lt;=self.alertDistance and self.ui.palette.red or self.ui.palette.muted end
  local c=self.controller;local roles={};for _,p in ipairs(self.platform:people()) do roles[#roles+1]=p.player.Name..': '..p.role end
  self.ui.subtitle.Text='V'..M.Version.current..'  •  MURDER MYSTERY 2'
  self.homeInfo.Text=string.format('MM2: %s\nWłasna rola / broń: %s\nFPS %.1f • zbieranie: %s\nAkcja walki: %s',self.platform.allowed and 'wykryto' or 'nie wykryto — moduły gry zablokowane',self.platform:role(self.player),self.fps,c.state,c.combat and c.combat.kind or 'STOP')
  local states={STOPPED='Wyłączona',SEARCHING='Szukam przedmiotów',WAIT_ITEMS='Brak przedmiotu w zasięgu — podejdź bliżej',WAIT_CHARACTER='Czekam na aktywną postać',BAG_FULL='Pełna torba — czekam',PICKUP='Czekam na odbiór',APPROACH=c.farmMotion=='Lot' and 'Lecę do przedmiotu' or 'Idę do przedmiotu',MANUAL='Sterujesz ręcznie',PAUSED='Pauza'}
  self.farmInfo.Text=string.format('%s: %s\nPróby odbioru %d • zniknięcia obiektów %d\nNie jest to potwierdzone saldo monet ani cukierków.\n%s',self.ui:t('Stan'),self.ui:t(states[c.state] or c.state)..' · '..c.lastScanCount,c.attempts,c.disappeared,c.lastError)
  self.combatInfo.Text=string.format('Aimbot %s • Auto Shot %s\nAktywacje pistoletu %d • noża %d\n%s',c.aimbot and 'ON' or 'OFF',c.autoShot and 'ON' or 'OFF',c.shots,c.stabs,c.lastError)
  self.rolesInfo.Text=#roles&gt;0 and table.concat(roles,'\n') or 'Brak innych aktywnych postaci.'
  if self.ui.current=='SETTINGS' then self.debugBox.Text=self:report() end
 end
 function A:stopAll()self.controller:stopAll();self.proximity=false;if self.threatInfo then self.threatInfo.Visible=false end;self.movement:reset();self.effects:clear();if self.skins then self.skins:reset()end;if self.quickTools then self.quickTools:reset()end;if self.ui then self.ui:refreshControls();self:notify('MM2','Zatrzymano funkcje, przywrócono kamerę i wyczyszczono efekty.') end end
 function A:unload()if not self.alive then return end;self:stopAll();self.alive=false;self.runtime:close();if _G.KubiHubRuntime==self then _G.KubiHubRuntime=nil end end
 return A
end
end)()(M)

-- SOURCE: src/modules/tools/Universal.lua
M.UniversalApp=(function()
return function(M)
 local A={};A.__index=A;A.run=M.Application.run;A.notify=M.Application.notify;A.copy=M.Application.copy
 local N={order={'MISC','PLAYER','CAMERA','TELEPORT','QUICK','SETTINGS'},titles={MISC='Główne',PLAYER='Postać',CAMERA='Widok',TELEPORT='Teleport',QUICK='Narzędzia',SETTINGS='Ustawienia'},matches=M.Navigation.matches}
 function N.resolve(id)return id=='HOME' and 'MISC' or id=='DEBUG' and 'SETTINGS' or id end
 function N.rank(id)for i,key in ipairs(N.order)do if id==key then return i end end;return 99 end
 function A.new(onCreating)
  local self=setmetatable({alive=true,mode='UNIVERSAL',navigation=N,clock=os.clock,fps=0,fovEnabled=false,fov=80,cameraOriginal={},bright=false},A)
  self.player=game:GetService('Players').LocalPlayer;assert(self.player,'Brak LocalPlayer.');self.player:WaitForChild('PlayerGui',10)
  self.input=game:GetService('UserInputService');self.runService=game:GetService('RunService');self.lighting=game:GetService('Lighting')
  self.log=M.Log.new(function()return os.date('%H:%M:%S')end);self.runtime=M.Runtime.new(self.clock,function(module,err)self.log:error(module,err);if self.ui then self.ui:toast(module,err,true)end end)
  if onCreating then onCreating(self)end
  M.Profiles.init(self,'UNIVERSAL')
  self.platform={allowed=true,character=function()
   local c=self.player.Character;local h=c and c:FindFirstChildOfClass('Humanoid');local r=c and c:FindFirstChild('HumanoidRootPart');if c and h and r and h.Health&gt;0 then return c,h,r end
  end}
  self.adapter={mode='UNIVERSAL',capabilities={movement=true},cancel=function()end,movement=function(_,values)local _,h=self.platform:character();if not h then return {ok=false,error='Poczekaj na aktywną postać.'}end;h.WalkSpeed=values.walk;if h.UseJumpPower then h.JumpPower=values.jump else h.JumpHeight=values.jump^2/(2*workspace.Gravity)end;return {ok=true}end}
  self.movement=M.Movement.new(self.runtime,self.adapter,self.player,self.input,self.log,self.config.data.movement);self.avatar=M.AvatarAppearance.new(self.platform,self.runtime);self.runtime:own(self.avatar);self.avatar:bind(self.runService)
  self.ui=M.UI.new(self);self.ui.title.Text='KUBI HUB DELUXE / UNIVERSAL'
  self.crossGui=self.ui:create('ScreenGui',{Name='KubiHubUniversalCrosshair',IgnoreGuiInset=true,ResetOnSpawn=false,DisplayOrder=80},self.player.PlayerGui);self.runtime:own(self.crossGui)
  self.cross=self.ui:create('TextLabel',{AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromScale(.5,.5),Size=UDim2.fromOffset(48,48),Text='+',TextSize=24,Font=Enum.Font.GothamBold,TextColor3=Color3.new(1,1,1),BackgroundTransparency=1,Visible=false},self.crossGui)
  self:pages();M.QuickTools(self);self.ui:show('MISC');self.ui:theme();self:updateDashboard()
  self.runtime:connect(self.runService.Heartbeat,function(dt)self.fps=self.fps==0 and 1/math.max(dt,.001) or self.fps*.95+1/math.max(dt,.001)*.05;self.runtime:tick(dt)end,'Universal')
  self.runtime:connect(self.runService.RenderStepped,function()self.movement:tick();self:applyFov()end,'Universal')
  self.runtime:connect(self.player.CharacterAdded,function()self.movement:reset();self.avatar:reset();self.ui:refreshFeatures()end,'Respawn')
  self.runtime:schedule('UniversalUI',.1,function()self.ui:tick()end)
  self.runtime:schedule('UniversalStatus',.5,function()local ok,err=self.avatar:refresh();if not ok then self.ui:toast('Postać',err,true)end;self:updateDashboard()end)
  return self
 end
 function A:applyFov()
  local camera=workspace.CurrentCamera;if not self.fovEnabled or not camera then return end
  if self.cameraOriginal[camera]==nil then self.cameraOriginal[camera]=camera.FieldOfView end
  if camera.FieldOfView~=self.fov then camera.FieldOfView=self.fov end
 end
 function A:resetFov()
  self.fovEnabled=false;for camera,value in pairs(self.cameraOriginal)do pcall(function()camera.FieldOfView=value end)end;self.cameraOriginal={}
 end
 function A:setZoom(mode)
  if mode~=nil and mode~='FAR' and mode~='FIRST' then return false,'Nieznany tryb kamery.'end
  if not mode then
   local saved=self.zoomOriginal;self.zoomOriginal=nil;self.zoomMode=nil
   if saved then self.player.CameraMaxZoomDistance=math.max(saved.max,self.player.CameraMinZoomDistance);self.player.CameraMinZoomDistance=saved.min;self.player.CameraMaxZoomDistance=saved.max;self.player.CameraMode=saved.mode end
   return true
  end
  if not self.zoomOriginal then self.zoomOriginal={min=self.player.CameraMinZoomDistance,max=self.player.CameraMaxZoomDistance,mode=self.player.CameraMode}end
  self.zoomMode=mode
  if mode=='FAR' then self.player.CameraMode=Enum.CameraMode.Classic;self.player.CameraMaxZoomDistance=math.max(self.zoomDistance or 300,self.player.CameraMinZoomDistance);self.player.CameraMinZoomDistance=.5;self.player.CameraMaxZoomDistance=self.zoomDistance or 300
  else self.player.CameraMode=Enum.CameraMode.LockFirstPerson end;return true
 end
 function A:setBright(value)
  if value and not self.bright then self.lightOriginal={};for _,key in ipairs({'Brightness','ClockTime','Ambient','OutdoorAmbient','FogEnd','GlobalShadows'})do self.lightOriginal[key]=self.lighting[key]end end
  if value then self.lighting.Brightness=2;self.lighting.ClockTime=14;self.lighting.Ambient=Color3.fromRGB(170,170,170);self.lighting.OutdoorAmbient=Color3.fromRGB(170,170,170);self.lighting.FogEnd=100000;self.lighting.GlobalShadows=false
  elseif self.lightOriginal then for key,original in pairs(self.lightOriginal)do self.lighting[key]=original end;self.lightOriginal=nil end
  self.bright=value;return true
 end
 function A:pages()
  local ui=self.ui;M.ExtraPages(self)
  local main=ui:card(ui:page('MISC'),'Universal','Wspólne narzędzia klienta. Gra może przywracać własny ruch, kamerę i oświetlenie. Nie ma tu serwerowych nagród ani funkcji walki MM2.')
  self.info=ui:label(main,'');ui:button(main,'STOP / przywróć zmiany',function()self:stopAll()end)
  local player=ui:page('PLAYER');local move=ui:card(player,'Ruch postaci','Zastosowanie lokalne. Gra może korygować ruch. Wyłączenie przywraca zapamiętane ustawienia.')
  local function options(panel)for _,row in ipairs({{'Prędkość','walk',8,60},{'Skok','jump',20,120},{'Prędkość Fly','flySpeed',10,100}})do local spec=row;ui:slider(panel,spec[1],function()return self.config.data.movement[spec[2]]end,function(v)self.config.data.movement[spec[2]]=v end,spec[3],spec[4],1)end end
  ui:feature(move,'Zastosuj ruch',nil,function()return self.movement:apply()end,options)
  ui:feature(move,'Fly',function()return self.movement.fly end,function()if self.movement.fly then self.movement:stopFly();return true else return self.movement:startFly()end end,options)
  ui:button(move,'Przywróć ruch',function()return self.movement:reset()end);M.AppearanceControls(self,player,false)
  local view=ui:card(ui:page('CAMERA'),'Kamera i widok','Zmiany widoczne u Ciebie. STOP przywraca zapamiętane wartości.')
  ui:feature(view,'Pole widzenia',function()return self.fovEnabled end,function()if self.fovEnabled then self:resetFov()else self.fovEnabled=true;self:applyFov()end end,function(panel)ui:slider(panel,'FOV',function()return self.fov end,function(v)self.fov=v;self:applyFov()end,40,110,1)end)
  ui:feature(view,'Celownik',function()return self.cross.Visible end,function()self.cross.Visible=not self.cross.Visible end,function(panel)ui:slider(panel,'Rozmiar celownika',function()return self.cross.TextSize end,function(v)self.cross.TextSize=v end,12,40,1)end)
  ui:feature(view,'Jasny dzień — lokalnie',function()return self.bright end,function()return self:setBright(not self.bright)end,function(panel)ui:label(panel,'Lokalne oświetlenie. Wyłączenie przywraca porę, jasność, mgłę i cienie.')end)
  self.zoomDistance=300
  ui:feature(view,'Daleki zoom',function()return self.zoomMode=='FAR' end,function()if self.zoomMode=='FAR' then return self:setZoom(nil)else return self:setZoom('FAR')end end,function(panel)
   ui:field(panel,'Maksymalna odległość: 20–400',self.zoomDistance,function(v)self.zoomDistance=M.Util.number(tonumber(v),300,20,400);if self.zoomMode=='FAR' then self:setZoom('FAR')end;return self.zoomDistance end,false,function()return self.zoomDistance end)
  end)
  ui:feature(view,'Pierwsza osoba',function()return self.zoomMode=='FIRST' end,function()if self.zoomMode=='FIRST' then return self:setZoom(nil)else return self:setZoom('FIRST')end end,function(panel)ui:label(panel,'Ustawia lokalny tryb pierwszej osoby. Wyłączenie przywraca poprzedni tryb i zoom.')end)
  local settings=ui:page('SETTINGS');local s=ui:card(settings,'Wygląd huba')
  ui:cycle(s,'Akcent',{'BLUE','PURPLE'},function()return self.config.data.ui.theme end,function(v)self.config.data.ui.theme=v;ui:theme()end)
  ui:toggle(s,'Tryb kompaktowy',function()return self.config.data.ui.compact end,function(v)self.config.data.ui.compact=v;ui:fit()end)
  M.Profiles.page(self);M.CommunityLinks.page(self)
  ui.statusBody=ui:card(settings,'Ostatni komunikat');ui.statusInfo=ui:label(ui.statusBody,'Gotowy.');ui.routes.DEBUG=ui.statusBody
  ui:button(s,'Wyłącz i przywróć zmiany',function()self:unload()end)
 end
 function A:updateDashboard()
  self.ui:refreshFeatures();self.ui.subtitle.Text='V'..M.Version.current..'  •  UNIVERSAL'
  self.info.Text=string.format('FPS %.0f\nMiejsce: %s\nLPM: użyj · PPM / ⋯: opcje\nFunkcje zaczynają wyłączone.',self.fps,tostring(game.PlaceId))
 end
 function A:stopAll()
  self.movement:reset();self.avatar:reset();self:resetFov();self:setZoom(nil);self:setBright(false);self.cross.Visible=false;if self.quickTools then self.quickTools:reset()end;if self.ui then self.ui:refreshFeatures()end
 end
 function A:unload()if not self.alive then return end;self:stopAll();self.alive=false;self.runtime:close();if _G.KubiHubRuntime==self then _G.KubiHubRuntime=nil end end
 return A
end
end)()(M)

-- SOURCE: src/ui/QuickTools.lua
M.QuickTools=(function()
return function(M)
 local Q={};Q.__index=Q
 local filters={
  {'Czarno-biały',-1,.08,0,255,255,255},
  {'Sepia',-.65,.07,0,255,221,174},
  {'Wyższy kontrast',0,.32,0,255,255,255},
  {'Nasycone kolory',.45,.08,0,255,255,255},
  {'Chłodny obraz',.05,0,0,190,224,255},
  {'Przyciemnienie',0,0,-.22,255,255,255},
 }
 local function formatTime(seconds)
  seconds=math.max(0,math.floor(seconds));return string.format('%02d:%02d',math.floor(seconds/60),seconds%60)
 end
 local function character(player)
  local model=player.Character
  return model and model:FindFirstChildOfClass('Humanoid'),model and model:FindFirstChild('HumanoidRootPart')
 end
 function Q:elapsed(now)return self.elapsedTime+(self.started and (now-self.started) or 0)end
 function Q:filter(row)
  if self.effect then self.effect:Destroy();self.effect=nil end
  if self.filterChoice==row or not row then self.filterChoice=nil;return end
  local effect=Instance.new('ColorCorrectionEffect');effect.Name='KubiHubQuickFilter'
  effect.Saturation=row[2];effect.Contrast=row[3];effect.Brightness=row[4];effect.TintColor=Color3.fromRGB(row[5],row[6],row[7])
  self.effect=effect;self.filterChoice=row;effect.Parent=game:GetService('Lighting')
 end
 function Q:deleteMarker()
  if self.marker then self.marker:Destroy();self.marker=nil;self.billboard=nil end
 end
 function Q:mark()
  local _,root=character(self.app.player);if not root then return false,'Brak aktywnej postaci.' end
  if not self.marker then
   local part=Instance.new('Part');part.Name='KubiHubLocalMarker';part.Size=Vector3.new(1,1,1);part.Transparency=1;part.Anchored=true
   part.CanCollide=false;part.CanQuery=false;part.CanTouch=false;self.marker=part
   self.billboard=self.ui:create('BillboardGui',{Name='KubiHubMarkerLabel',Size=UDim2.fromOffset(130,34),StudsOffset=Vector3.new(0,2,0),MaxDistance=300,AlwaysOnTop=true,Adornee=part},part)
   self.ui:create('TextLabel',{Size=UDim2.fromScale(1,1),Text='▼  ZNACZNIK',TextColor3=Color3.fromRGB(255,224,93),TextStrokeTransparency=.2,BackgroundTransparency=1,Font=Enum.Font.GothamBold,TextSize=15},self.billboard)
  end
  self.marker.CFrame=CFrame.new(root.Position);self.marker.Parent=workspace;self.billboard.Enabled=true
  self.ui:refreshFeatures();return true
 end
 function Q:update(now)
  if self.timerEnd and now&gt;=self.timerEnd then
   self.timerEnd=nil;self.timerDone=true
   self.ui:toast('Minutnik','Czas minął.');self.ui:refreshFeatures()
  end
  self.timerInfo.Text='Stoper: '..formatTime(self:elapsed(now))..'  ·  Międzyczas: '..(self.lap or '—')..
   '\nMinutnik: '..(self.timerEnd and formatTime(math.ceil(self.timerEnd-now)) or self.timerDone and 'koniec' or '—')
  if not next(self.metrics) then self.hud.Visible=false;return end
  local h,root=character(self.app.player)
  local pos=root and root.Position;local v=root and root.AssemblyLinearVelocity
  local rows={
   {'FPS',self.fps and string.format('%.0f',self.fps) or '—'},
   {'Czas sesji',formatTime(now-self.opened)},
   {'Pozycja XYZ',pos and string.format('%.0f / %.0f / %.0f',pos.X,pos.Y,pos.Z) or '—'},
   {'Zdrowie',h and string.format('%.0f / %.0f',h.Health,h.MaxHealth) or '—'},
   {'Prędkość',v and string.format('%.1f studów/s',Vector3.new(v.X,0,v.Z).Magnitude) or '—'},
   {'Liczba graczy',tostring(#game:GetService('Players'):GetPlayers())},
   {'Odległość do znacznika',pos and self.marker and string.format('%.0f studów',(self.marker.Position-pos).Magnitude) or '—'},
  }
  local lines={}
  for _,row in ipairs(rows)do if self.metrics[row[1]] then lines[#lines+1]=row[1]..': '..row[2] end end
  self.hud.Text=table.concat(lines,'\n');self.hud.Visible=true
 end
 function Q:reset()
  table.clear(self.metrics);self.hud.Visible=false;self:filter(nil);self:deleteMarker()
  self.started=nil;self.elapsedTime=0;self.lap=nil;self.timerEnd=nil;self.timerDone=false
  self:update(self.app.clock());self.ui:refreshFeatures()
 end
 function Q:Destroy()self:filter(nil);self:deleteMarker()end
 return function(app)
  local ui=app.ui
  local q=setmetatable({app=app,ui=ui,metrics={},opened=app.clock(),elapsedTime=0,timerSeconds=60},Q)
  app.quickTools=q;app.runtime:own(q)
  q.hud=ui:create('TextLabel',{Name='KubiHubQuickHUD',AnchorPoint=Vector2.new(1,0),Position=UDim2.new(1,-12,0,12),Size=UDim2.fromOffset(205,0),AutomaticSize=Enum.AutomaticSize.Y,BackgroundColor3=ui.palette.panel,BackgroundTransparency=.12,TextColor3=ui.palette.text,TextSize=13,TextXAlignment=Enum.TextXAlignment.Left,Font=Enum.Font.Gotham,Text='',Visible=false},ui.gui)
  ui:corner(q.hud,8);ui:create('UIPadding',{PaddingLeft=UDim.new(0,9),PaddingRight=UDim.new(0,9),PaddingTop=UDim.new(0,6),PaddingBottom=UDim.new(0,6)},q.hud)
  local page=ui:page('QUICK')
  local hud=ui:card(page,'HUD — informacje na ekranie')
  for _,label in ipairs({'FPS','Czas sesji','Pozycja XYZ','Zdrowie','Prędkość','Liczba graczy','Odległość do znacznika'})do
   ui:feature(hud,label,function()return q.metrics[label]==true end,function()
    q.metrics[label]=not q.metrics[label] and true or nil;q:update(app.clock())
   end)
  end
  local look=ui:card(page,'Filtry obrazu','Jeden filtr naraz. Kliknij aktywny filtr ponownie, aby go wyłączyć.')
  for _,row in ipairs(filters)do
   ui:feature(look,row[1],function()return q.filterChoice==row end,function()q:filter(row);ui:refreshFeatures()end)
  end
  local time=ui:card(page,'Czas — stoper i minutnik')
  q.timerInfo=ui:label(time,'')
  ui:feature(time,'Stoper',function()return q.started~=nil end,function()
   local now=app.clock()
   if q.started then q.elapsedTime=q:elapsed(now);q.started=nil else q.started=now end;q:update(now)
  end)
  ui:feature(time,'Zapisz międzyczas',nil,function()
   if not q.started and q.elapsedTime==0 then return false,'Najpierw uruchom stoper.' end
   q.lap=formatTime(q:elapsed(app.clock()));q:update(app.clock())
  end)
  ui:feature(time,'Reset stopera',nil,function()
   q.elapsedTime=0;q.lap=nil;if q.started then q.started=app.clock()end;q:update(app.clock())
  end)
  ui:feature(time,'Minutnik',function()return q.timerEnd~=nil end,function()
   if q.timerEnd then q.timerEnd=nil else q.timerEnd=app.clock()+q.timerSeconds end
   q.timerDone=false;q:update(app.clock())
  end,function(panel)
   ui:field(panel,'Czas następnego odliczania: 5–600 s',q.timerSeconds,function(v)q.timerSeconds=M.Util.number(tonumber(v),60,5,600);return q.timerSeconds end,false,function()return q.timerSeconds end)
  end)
  local mark=ui:card(page,'Znacznik miejsca','Punkt widoczny tylko u Ciebie. Zapisuje pozycję do końca sesji lub do STOP.')
  ui:feature(mark,'Zapisz znacznik tutaj',nil,function()return q:mark()end)
  ui:feature(mark,'Pokaż znacznik',function()return q.billboard and q.billboard.Enabled end,function()
   if not q.billboard then return false,'Najpierw zapisz znacznik.' end;q.billboard.Enabled=not q.billboard.Enabled
  end)
  ui:feature(mark,'Usuń znacznik',nil,function()q:deleteMarker();q:update(app.clock());ui:refreshFeatures()end)
  app.runtime:connect(game:GetService('RunService').Heartbeat,function(dt)
   if q.metrics.FPS and dt&gt;0 then local current=1/dt;q.fps=q.fps and q.fps*.9+current*.1 or current end
  end,'Narzędzia')
  app.runtime:schedule('QuickTools',.25,function(_,now)q:update(now)end)
  q:update(app.clock())
 end
end
end)()(M)

-- SOURCE: src/modules/mm2/Skins.lua
M.MM2Skins=(function()
return function(M)
 local S={};S.__index=S
 local styles={
  {name='Zorza',main={85,239,195},edge={137,94,250}},
  {name='Rubin',main={223,49,86},edge={255,164,139}},
  {name='Złoty',main={245,189,65},edge={255,241,180}},
  {name='Lód',main={111,204,250},edge={224,250,255}},
  {name='Obsydian',main={70,62,99},edge={199,151,255}},
  {name='Laser',main={235,72,206},edge={156,251,94}},
 }
 local names,styleByName={},{}
 for _,style in ipairs(styles)do names[#names+1]=style.name;styleByName[style.name]=style end
 local models={
  Knife={
   {'Part','Rękojeść',{-1.63,0,0},{1.24,.48,.48},'grip'},
   {'Part','Nasada',{-2.23,0,0},{.18,.55,.55},'edge'},
   {'Part','Jelec',{-.92,0,0},{.16,.92,.55},'edge'},
   {'Part','Ostrze',{.16,0,0},{1.98,.58,.24},'main'},
   {'WedgePart','Czubek',{1.64,0,0},{.24,.58,.98},'main',{0,90,0}},
   {'Part','Grzbiet',{.16,.19,.13},{1.74,.09,.045},'edge'},
  },
  Gun={
   {'Part','Zamek',{.28,.48,0},{3.05,.57,.62},'main'},
   {'Part','Lufa',{1.87,.48,0},{.25,.38,.40},'grip'},
   {'Part','Szkielet',{-.21,.10,0},{2.13,.32,.53},'edge'},
   {'Part','Uchwyt',{-.99,-.54,0},{.66,1.38,.52},'grip',{0,0,-14}},
   {'Part','Kabłąk',{-.03,-.47,0},{1.04,.13,.35},'edge'},
   {'Part','Koniec kabłąka',{.43,-.24,0},{.12,.51,.35},'edge'},
   {'Part','Muszka',{1.35,.84,0},{.16,.13,.20},'edge'},
  },
 }
 local labels={Knife='Nóż',Gun='Pistolet'}
 local kinds={['Nóż']='Knife',['Pistolet']='Gun'}
 local grip=Color3.fromRGB(32,38,52)

 function S:clearTint()
  if self.folder then self.folder:Destroy();self.folder=nil end
  table.clear(self.tint)
 end
 function S:reset()
  self.enabled=false;self:clearTint()
  if self.status then self:updateLabel()end
  self.app.ui:refreshFeatures()
 end
 function S:Destroy()self:clearTint()end

 function S:updateCamera()
  local angle=math.rad(self.angle)
  self.camera.CFrame=CFrame.lookAt(Vector3.new(math.sin(angle)*8,1.9,math.cos(angle)*8),Vector3.new(0,.05,0))
 end
 function S:updatePreview()
  local style=styleByName[self.style]
  local colors={grip=grip,main=Color3.fromRGB(table.unpack(style.main)),edge=Color3.fromRGB(table.unpack(style.edge))}
  if self.previewKind~=self.kind then
   for _,part in ipairs(self.world:GetChildren())do part:Destroy()end
   self.previewParts={}
   for _,spec in ipairs(models[self.kind])do
    local part=Instance.new(spec[1]);part.Name=spec[2];part.Size=Vector3.new(table.unpack(spec[4]))
    part.CFrame=CFrame.new(table.unpack(spec[3]))
    if spec[6] then local x,y,z=table.unpack(spec[6]);part.CFrame=part.CFrame*CFrame.Angles(math.rad(x),math.rad(y),math.rad(z))end
    part.Anchored=true;part.CanCollide=false;part.CanTouch=false;part.CanQuery=false
    part.Material=spec[5]=='grip' and Enum.Material.SmoothPlastic or Enum.Material.Metal
    part.Parent=self.world;self.previewParts[#self.previewParts+1]={part=part,color=spec[5]}
   end
   self.previewKind=self.kind
  end
  for _,row in ipairs(self.previewParts)do row.part.Color=colors[row.color]end
 end
 function S:updateLabel()
  local platform=self.app.platform
  local character=platform:character()
  local tool=platform:tool(self.kind)
  local held=character and tool and tool.Parent==character
  local available=held and 'w dłoni' or tool and 'w plecaku tej rundy' or 'brak w tej rundzie'
  local effect=self.enabled and (next(self.tint) and 'włączona' or 'czeka na widoczną broń w dłoni') or 'wyłączona'
  self.status.Text=labels[self.kind]..': '..available..'\nPrzymiarka: '..effect
  return held and tool or nil
 end
 function S:refresh()
  local tool=self:updateLabel()
  if not self.enabled or not tool or not self.app.platform.allowed then self:clearTint();self:updateLabel();return end
  local style=styleByName[self.style]
  local main=Color3.fromRGB(table.unpack(style.main));local edge=Color3.fromRGB(table.unpack(style.edge))
  local keep={};local count=0
  local function add(part)
   if not part or keep[part] or not part:IsA('BasePart') or part.Transparency&gt;=1 or part.LocalTransparencyModifier&gt;=1 or count&gt;=6 then return end
   keep[part]=true;count+=1
   if not self.folder then
    self.folder=Instance.new('Folder');self.folder.Name='KubiHubLocalWeaponStyle';self.folder.Parent=workspace
   end
   local effect=self.tint[part]
   if not effect or effect.Parent~=self.folder then
    effect=Instance.new('Highlight');effect.Name='Podgląd stylu';effect.Adornee=part
    effect.DepthMode=Enum.HighlightDepthMode.Occluded;effect.FillTransparency=.21;effect.OutlineTransparency=.36
    self.tint[part]=effect;effect.Parent=self.folder
   end
   effect.FillColor=main;effect.OutlineColor=edge
  end
  add(tool:FindFirstChild('Handle'))
  for _,part in ipairs(tool:GetDescendants())do if count&gt;=6 then break end;add(part)end
  for part,effect in pairs(self.tint)do if not keep[part] then effect:Destroy();self.tint[part]=nil end end
  if not next(self.tint) then self:clearTint()end
  self:updateLabel()
 end
 function S:setStyle(style)
  if not styleByName[style] then return false,'Nieznany styl.' end
  self.style=style;self:updatePreview();self:refresh();return true
 end

 return function(app,page)
  local ui=app.ui
  local self=setmetatable({app=app,kind='Knife',style=names[1],angle=15,enabled=false,tint={}},S)
  app.runtime:own(self)
  local card=ui:card(page,'Studio skórek MM2','Zobacz własne wzory na modelach 3D i przymierz kolor na broni z rundy. Wzory huba są widoczne tylko u Ciebie.')
  ui:label(card,'Podgląd 3D i przymiarka nie zmieniają ekwipunku. Wymienialne skórki przekażesz w oknie wymiany MM2.')
  local viewport=ui:create('ViewportFrame',{Name='WeaponSkinPreview',Size=UDim2.new(1,0,0,165),BackgroundColor3=ui.palette.bg,BorderSizePixel=0,Ambient=Color3.fromRGB(179,188,211),LightColor=Color3.fromRGB(252,247,233),LightDirection=Vector3.new(-1,-1,-1)},card)
  ui:corner(viewport,8)
  self.world=ui:create('WorldModel',{},viewport)
  self.camera=ui:create('Camera',{FieldOfView=42},viewport);viewport.CurrentCamera=self.camera;self:updateCamera()
  self.status=ui:label(card,'')
  ui:cycle(card,'Model',{'Nóż','Pistolet'},function()return labels[self.kind]end,function(label)
   self.kind=kinds[label];self:updatePreview();self:refresh()
  end)
  ui:cycle(card,'Styl',names,function()return self.style end,function(style)return self:setStyle(style)end)
  ui:button(card,'Obróć podgląd',function()self.angle=(self.angle+45)%360;self:updateCamera()end)
  ui:button(card,'Losuj styl',function()
   local choices={};for _,name in ipairs(names)do if name~=self.style then choices[#choices+1]=name end end
   self:setStyle(choices[math.random(#choices)]);ui:refreshControls()
  end)
  ui:feature(card,'Przymierz styl — lokalnie',function()return self.enabled end,function()self.enabled=not self.enabled;self:refresh()end,function(panel)
   ui:label(panel,'Efekt nakłada wybrany kolor na widoczną broń w Twojej dłoni. Oryginalna skórka pozostaje bez zmian.')
  end)
  ui:button(card,'Załóż broń z tej rundy',function()
   local tool,err=app.platform:equip(self.kind)
   if not tool then return false,err end
   self:refresh();return true
  end)
  ui:button(card,'Zdejmij lokalny styl',function()self:reset()end)
  self:updatePreview();self:refresh()
  app.runtime:schedule('MM2Skins',.25,function()
   if not self.enabled then return end
   local ok,err=pcall(self.refresh,self)
   if not ok then self:reset();app.runtime.errors('Skórki',err)end
  end)
  return self
 end
end
end)()(M)

-- SOURCE: src/modules/brainrot/Application.lua
M.BrainrotApp=(function()
return function(M)
 local A={};A.__index=A;A.run=M.Application.run
 local N={order={'STEAL','QUICK','SETTINGS'},titles={STEAL='AutoSteal',QUICK='Narzędzia',SETTINGS='Ustawienia'},matches=M.Navigation.matches}
 function N.resolve(id)return id=='HOME' and 'STEAL' or id=='DEBUG' and 'SETTINGS' or id end
 function N.rank(id)return id=='STEAL' and 1 or id=='QUICK' and 2 or 3 end

 local function normalize(text)
  return (text:lower():gsub('%s+',' '):match('^%s*(.-)%s*$'))
 end
 local function isSteal(prompt)
  local action=normalize(prompt.ActionText)
  local object=normalize(prompt.ObjectText)
  return action=='steal' or action=='ukradnij' or action=='voler' or action=='roubar' or action=='robar'
   or (object~='' and action=='steal '..object)
 end
 local function promptPosition(prompt)
  local parent=prompt.Parent
  if not parent then return nil end
  if parent:IsA('Attachment') then return parent.WorldPosition end
  if parent:IsA('BasePart') then return parent.Position end
  if parent:IsA('Model') and parent.PrimaryPart then return parent.PrimaryPart.Position end
 end
 local function character(player)
  local model=player.Character
  local humanoid=model and model:FindFirstChildOfClass('Humanoid')
  local root=model and model:FindFirstChild('HumanoidRootPart')
  if humanoid and humanoid.Health&gt;0 and root and root:IsA('BasePart') then return model,root end
 end

 function A.new(onCreating)
  local self=setmetatable({alive=true,mode='BRAINROT',navigation=N,clock=os.clock,shown={},enabled=false,nextAt=0,sequence=0},A)
  self.player=game:GetService('Players').LocalPlayer;assert(self.player,'Brak LocalPlayer.')
  assert(self.player:WaitForChild('PlayerGui',10),'Brak PlayerGui.')
  self.input=game:GetService('UserInputService')
  self.log=M.Log.new(function()return os.date('%H:%M:%S')end)
  self.runtime=M.Runtime.new(self.clock,function(module,err)self.log:error(module,err);if self.ui then self.ui:toast(module,err,true)end end)
  if onCreating then onCreating(self)end
  M.Profiles.init(self,'BRAINROT')
  local prompts=game:GetService('ProximityPromptService')
  local ui=M.UI.new(self);self.ui=ui
  ui.title.Text='DELUXE / STEAL A BRAINROT'
  ui.subtitle.Text='V'..M.Version.current..'  •  AUTOSTEAL'
  local home=ui:card(ui:page('STEAL'),'AutoSteal w zasięgu')
  ui:label(home,'Włącz i podejdź do Brainrota, aż gra pokaże „Steal”. Hub przytrzyma przycisk przez czas wymagany przez grę. Zanieś Brainrota do bazy samodzielnie.')
  ui:feature(home,'AutoSteal',function()return self.enabled end,function()self:setEnabled(not self.enabled)end,function(panel)
   ui:label(panel,'Po otwarciu huba odejdź od celu i podejdź ponownie, jeśli napis był już widoczny. Hub podejmuje jedną próbę dla danego wyświetlenia przycisku. Po przerwie wybiera najbliższą dostępną akcję.')
  end)
  self.state=ui:label(home,'AutoSteal wyłączony.')
  ui:cycle(home,'Profil tempa',M.Tempo.order,function()return self.config.data.brainrot.tempo end,function(v)self.config.data.brainrot.tempo=v end)
  ui:label(home,'Profil zmienia przerwę między próbami. Czas przytrzymania ustala gra.')
  self.last=ui:label(home,'Ostatnia próba: —')
  ui:button(home,'STOP / wyłącz AutoSteal',function()self:setEnabled(false)end)
  local settings=ui:card(ui:page('SETTINGS'),'Sesja')
  ui:button(settings,'Wyłącz hub',function()self:unload()end)
  ui.statusBody=ui:card(ui:page('SETTINGS'),'Ostatni komunikat')
  ui.statusInfo=ui:label(ui.statusBody,'Gotowy.')
  M.QuickTools(self);M.Profiles.page(self);M.CommunityLinks.page(self);ui:show('STEAL')

  self.runtime:connect(prompts.PromptShown,function(prompt)
   if not self.shown[prompt] and isSteal(prompt) then
    self.sequence+=1
    self.shown[prompt]={order=self.sequence}
   end
  end,'AutoSteal')
  self.runtime:connect(prompts.PromptHidden,function(prompt)
   self.shown[prompt]=nil
   if self.active and self.active.prompt==prompt then self:finish(self.clock(),'Anulowano: akcja zniknęła.')end
  end,'AutoSteal')
  self.runtime:connect(prompts.PromptTriggered,function(prompt,player)
   local active=self.active
   if active and active.prompt==prompt and player==self.player then active.triggered=true end
  end,'AutoSteal')
  self.runtime:connect(self.player.CharacterAdded,function()self:setEnabled(false,'Odrodzenie. Włącz AutoSteal ponownie.')end,'AutoSteal')
  self.runtime:connect(game:GetService('RunService').Heartbeat,function(dt)self.runtime:tick(dt)end,'Brainrot')
  self.runtime:schedule('AutoSteal',.05,function(_,now)
   local ok,err=pcall(self.update,self,now)
   if not ok then self:setEnabled(false,'AutoSteal przerwany przez błąd.');self.runtime.errors('AutoSteal',err)end
  end)
  self.runtime:schedule('BrainrotUI',.1,function()ui:tick()end)
  return self
 end

 function A:distance(prompt,model,root)
  if not prompt.Enabled or not isSteal(prompt) or not prompt:IsDescendantOf(workspace) or prompt:IsDescendantOf(model) then return nil end
  local position=promptPosition(prompt)
  local distance=position and (position-root.Position).Magnitude
  if distance and distance&lt;=prompt.MaxActivationDistance then return distance end
 end

 function A:finish(now,result)
  local active=self.active
  if not active then return end
  self.active=nil
  self.nextAt=now+(M.Tempo.steal[self.config.data.brainrot.tempo] or M.Tempo.steal.NORMAL)
  local ok,err=pcall(function()active.prompt:InputHoldEnd()end)
  if not ok then
   self.enabled=false
   self.state.Text=self.ui:t('AutoSteal wyłączony po błędzie interakcji.')
   self.last.Text='Ostatnia próba: nie udało się zwolnić przycisku.'
   self.ui:refreshFeatures()
   self.runtime.errors('AutoSteal',err)
   return
  end
  if active.triggered then result='Zarejestrowano interakcję. Sprawdź, czy niesiesz Brainrota.' end
  self.last.Text='Ostatnia próba: '..result
  if self.enabled then self.state.Text=self.ui:t('Krótka przerwa przed kolejną próbą.') end
 end

 function A:setEnabled(value,reason)
  self.enabled=value
  if value then
   self.state.Text=self.ui:t('Czekam na „Steal” w zasięgu.')
  else
   self:finish(self.clock(),'Przerwano ręcznie.')
   self.state.Text=self.ui:t(reason or 'AutoSteal wyłączony.')
  end
  self.ui:refreshFeatures()
 end

 function A:update(now)
  if not self.enabled then return end
  local model,root=character(self.player)
  if not root then
   self:setEnabled(false,'Brak aktywnej postaci. Włącz AutoSteal ponownie po odrodzeniu.')
   return
  end
  local active=self.active
  if active then
   if active.character~=model or not self.shown[active.prompt] or not self:distance(active.prompt,model,root) then
    self:finish(now,'Anulowano: akcja niedostępna lub poza zasięgiem.')
   elseif now&gt;=active.untilAt then
    self:finish(now,'Zakończono przytrzymanie. Brak sygnału interakcji.')
   end
   return
  end
  if now&lt;self.nextAt then return end
  local closest,record,best
  for prompt,row in pairs(self.shown) do
   if not prompt:IsDescendantOf(workspace) then
    self.shown[prompt]=nil
   elseif not row.attempted then
    local distance=self:distance(prompt,model,root)
    if distance and (not best or distance&lt;best or distance==best and row.order&lt;record.order) then closest,record,best=prompt,row,distance end
   end
  end
  if not closest then self.state.Text=self.ui:t('Czekam na „Steal” w zasięgu.');return end
  record.attempted=true
  local duration=closest.HoldDuration
  if duration&lt;0 or duration&gt;60 or duration~=duration then self.last.Text='Ostatnia próba: nieobsługiwany czas interakcji.';return end
  self.active={prompt=closest,character=model,untilAt=now+duration+.1}
  self.state.Text=self.ui:t('Przytrzymuję „Steal”…')
  local ok,err=pcall(function()closest:InputHoldBegin()end)
  if not ok then self:setEnabled(false,'Gra nie przyjęła próby AutoSteal.');self.runtime.errors('AutoSteal',err)end
 end

 function A:stopAll()self:setEnabled(false);if self.quickTools then self.quickTools:reset()end end
 function A:unload()
  if not self.alive then return end
  self:stopAll();self.alive=false;self.runtime:close();table.clear(self.shown)
  if _G.KubiHubRuntime==self then _G.KubiHubRuntime=nil end
 end
 return A
end
end)()(M)

-- SOURCE: src/core/Locale.lua
M.Locale=(function()
local L={}
L.codes={'PL','EN','RU','UK','ZH','ES','DE','PT','FR','IT'}
L.names={PL='Polski',EN='English',RU='Русский',UK='Українська',ZH='简体中文',ES='Español',DE='Deutsch',PT='Português',FR='Français',IT='Italiano'}
local rows={
 ['Tryb trasy']={'Route mode','Режим маршрута','Режим маршруту','路线模式','Modo de ruta','Routenmodus','Modo de rota','Mode de parcours','Modalità percorso'},
 ['Przejście']={'Crossing','Проезд','Проїзд','穿越','Recorrido','Durchfahrt','Travessia','Traversée','Attraversamento'},
 ['Teleport szybki']={'Quick teleport','Быстрый телепорт','Швидкий телепорт','快速传送','Teletransporte rápido','Schnellteleport','Teleporte rápido','Téléportation rapide','Teletrasporto rapido'},
 ['Trasa wyścigu']={'Race route','Маршрут гонки','Маршрут перегонів','竞赛路线','Ruta de carrera','Rennstrecke','Rota de corrida','Parcours de course','Percorso gara'},
 ['Zapisz start']={'Save start','Сохранить старт','Зберегти старт','保存起点','Guardar salida','Start speichern','Salvar largada','Enregistrer le départ','Salva partenza'},
 ['Dodaj checkpoint']={'Add checkpoint','Добавить точку','Додати точку','添加检查点','Añadir punto de control','Checkpoint hinzufügen','Adicionar checkpoint','Ajouter un point de passage','Aggiungi checkpoint'},
 ['Przenieś do startu']={'Go to start','Перейти к старту','Перейти до старту','前往起点','Ir a la salida','Zum Start','Ir para a largada','Aller au départ','Vai alla partenza'},
 ['Przejedź zapisane checkpointy']={'Run saved checkpoints','Пройти сохранённые точки','Пройти збережені точки','通过已保存的检查点','Recorrer puntos guardados','Gespeicherte Checkpoints abfahren','Percorrer checkpoints salvos','Parcourir les points enregistrés','Percorri i checkpoint salvati'},
 ['Wyczyść trasę']={'Clear route','Очистить маршрут','Очистити маршрут','清空路线','Borrar ruta','Route löschen','Limpar rota','Effacer le parcours','Cancella percorso'},
 ['Checkpointy']={'Checkpoints','Контрольные точки','Контрольні точки','检查点','Puntos de control','Checkpoints','Checkpoints','Points de passage','Checkpoint'},
 ['Jazda zatrzymana.']={'Ride stopped.','Езда остановлена.','Їзду зупинено.','骑行已停止。','Conducción detenida.','Fahrt angehalten.','Pilotagem parada.','Conduite arrêtée.','Guida interrotta.'},
 ['AutoSteal wyłączony.']={'AutoSteal is off.','Автокража выключена.','Автокрадіжку вимкнено.','自动偷取已关闭。','Robo automático desactivado.','AutoSteal ist aus.','AutoSteal desativado.','AutoSteal désactivé.','AutoSteal disattivato.'},
 ['Czekam na „Steal” w zasięgu.']={'Waiting for a nearby Steal prompt.','Ожидание кнопки Steal поблизости.','Очікування кнопки Steal поблизу.','等待附近的 Steal 按钮。','Esperando una acción Steal cercana.','Warte auf eine Steal-Aktion in Reichweite.','Aguardando o botão Steal próximo.','En attente d’une action Steal à proximité.','In attesa di un comando Steal vicino.'},
 ['Przytrzymuję „Steal”…']={'Holding Steal…','Удерживаю Steal…','Утримую Steal…','正在按住 Steal…','Manteniendo Steal…','Halte Steal gedrückt…','Segurando Steal…','Maintien de Steal…','Tengo premuto Steal…'},
 ['Krótka przerwa przed kolejną próbą.']={'Waiting before the next attempt.','Пауза перед следующей попыткой.','Пауза перед наступною спробою.','等待下一次尝试。','Pausa antes del próximo intento.','Pause vor dem nächsten Versuch.','Pausa antes da próxima tentativa.','Pause avant le prochain essai.','Pausa prima del prossimo tentativo.'},
 ['Wyłączona']={'Off','Выкл.','Вимкнено','关闭','Desactivada','Aus','Desativada','Désactivé','Disattivato'},
 ['Szukam przedmiotów']={'Looking for items','Ищу предметы','Шукаю предмети','正在查找物品','Buscando objetos','Suche Gegenstände','Buscando itens','Recherche d’objets','Cerco oggetti'},
 ['Pełna torba — czekam']={'Bag full — waiting','Сумка полна — ожидание','Сумка повна — очікування','背包已满，等待中','Bolsa llena — en espera','Tasche voll — warte','Bolsa cheia — aguardando','Sac plein — en attente','Borsa piena — in attesa'},
 ['Lecę do przedmiotu']={'Flying to the item','Лечу к предмету','Лечу до предмета','正在飞向物品','Volando al objeto','Fliege zum Gegenstand','Voando até o item','Vol vers l’objet','Volo verso l’oggetto'},
 ['Idę do przedmiotu']={'Walking to the item','Иду к предмету','Іду до предмета','正在走向物品','Caminando al objeto','Gehe zum Gegenstand','Caminhando até o item','Marche vers l’objet','Cammino verso l’oggetto'},
 ['Pauza']={'Paused','Пауза','Пауза','暂停','En pausa','Pausiert','Pausado','En pause','In pausa'},
 ['Stan']={'Status','Состояние','Стан','状态','Estado','Status','Estado','État','Stato'},
 ['Wybierz język']={'Choose a language','Выберите язык','Виберіть мову','选择语言','Elige el idioma','Sprache auswählen','Escolha o idioma','Choisissez la langue','Scegli la lingua'},
 ['Społeczność KUBI HUB']={'KUBI HUB Community','Сообщество KUBI HUB','Спільнота KUBI HUB','KUBI HUB 社区','Comunidad KUBI HUB','KUBI HUB Community','Comunidade KUBI HUB','Communauté KUBI HUB','Community KUBI HUB'},
 ['Dołącz na Discordzie lub zasubskrybuj kanał na YouTube. Kod PRO znajdziesz u twórcy.']={'Join Discord or subscribe on YouTube. Get the PRO code from the creator.','Вступите в Discord или подпишитесь на YouTube. Код PRO можно получить у автора.','Приєднуйтеся до Discord або підпишіться на YouTube. Код PRO можна отримати в автора.','加入 Discord 或订阅 YouTube。向作者获取 PRO 代码。','Únete a Discord o suscríbete en YouTube. Pide el código PRO al creador.','Tritt Discord bei oder abonniere YouTube. Den PRO-Code gibt es beim Ersteller.','Entre no Discord ou inscreva-se no YouTube. Obtenha o código PRO com o criador.','Rejoins Discord ou abonne-toi sur YouTube. Obtiens le code PRO auprès du créateur.','Entra su Discord o iscriviti su YouTube. Chiedi il codice PRO al creatore.'},
