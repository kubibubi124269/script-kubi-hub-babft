start(M)

local Players=game:GetService('Players')
local function attach(player)
 if not game:GetService('RunService'):IsStudio() then return end
 local gui=player:WaitForChild('PlayerGui');if gui:FindFirstChild('KubiHubTestClient') then return end
 local client=script.Parent.KubiHubTestClient:Clone();client.Disabled=false;client.Parent=gui
end
Players.PlayerAdded:Connect(attach);for _,player in ipairs(Players:GetPlayers()) do task.spawn(attach,player) end
