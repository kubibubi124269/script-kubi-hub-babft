local U=require('../src/core/Util')
local Runtime=require('../src/core/Runtime')(U)
local Config=require('../src/config/Config')(U)
local Inventory=require('../src/modules/inventory/Inventory')(U)
local Schema=require('../src/schematics/Schema')(U,Inventory)
local Shapes=require('../src/schematics/LegacyShapes')
local Worm=require('../src/schematics/WormMK2')(Schema)
local Bomb=require('../src/schematics/DynamiteStack')(Schema)
local Library=require('../src/schematics/Library')(U,Schema,Shapes,require('../src/schematics/LegacyPlans'),Worm,Bomb)
local Farm=require('../src/modules/farm/Controller')(U)
local Builder=require('../src/modules/builder/Controller')(U,Schema,Inventory)
local Adapter=require('../src/core/Adapter')(U)
local Layout=require('../src/ui/Layout');local Nav=require('../src/ui/Navigation')
local total=0;local failed=0
local function test(name,fn)local ok,e=pcall(fn);total+=1;if not ok then failed+=1;print('FAIL '..name..': '..tostring(e)) else print('PASS '..name) end end
local function eq(a,b)assert(a==b,tostring(a)..' ~= '..tostring(b))end
local function near(a,b)assert(math.abs(a-b)<1e-7)end
local log={add=function()end,error=function()end};local now=0;local queue={}
local function spawn(fn)table.insert(queue,fn)end
local function flush()local q=queue;queue={};for _,fn in ipairs(q) do fn() end end
local function runtime()return Runtime.new(function()return now end,function(_,e)error(e)end)end
local sample=assert(Schema.fromLegacy('sample','Example',{{kind='WoodBlock',x=0,y=0,z=0},{kind='WoodBlock',x=2,y=0,z=0}}))
test('inventory separates titanium from 3000 metal',function()
 local s=U.copy(sample);s.elements[1].material='TitaniumBlock';s.elements[1].size={2,2,80};s.elements[2].material='MetalBlock'
 local c=Inventory.compare(s,Inventory.snapshot({MetalBlock=3000,TitaniumBlock=20},'fixture'));eq(c.enough,false);eq(c.rows[2].id,'TitaniumBlock');eq(c.rows[2].missing,20)
end)
test('unknown inventory never becomes zero',function()local c=Inventory.compare(sample,Inventory.snapshot(nil));eq(c.unknown,true);eq(c.rows[1].have,nil);eq(c.rows[1].missing,nil);assert(Inventory.describe(c):find('NIE ODCZYTANO',1,true))end)
test('one seat means one required even when 29 available',function()local c=Inventory.compare(Bomb(3000),Inventory.snapshot({Seat=29,Dynamite=1,WoodBlock=3000}));eq(c.enough,true);for _,r in ipairs(c.rows) do if r.id=='Seat' then eq(r.required,1);eq(r.have,29);eq(r.missing,0) end end end)
test('dynamite is not TNT and payload is exactly 3000',function()local s=Bomb(3000);local c=Inventory.requirements(s);eq(#s.elements,3002);eq(c.Dynamite,1);eq(c.TNT,nil);eq(c.Seat,1);eq(c.WoodBlock,3000);for i=3,#s.elements do eq(s.elements[i].position[1],0);eq(s.elements[i].position[2],4);eq(s.elements[i].position[3],0)end end)
test('WORM is connected, has driver and 14 native hinge definitions',function()local s=Worm();assert(Schema.validate(s));eq(Inventory.requirements(s).Servo,14);local n=0;for _,e in ipairs(s.elements)do if e.class=='VehicleSeat' then n+=1;eq(e.id,s.driver)end end;eq(n,1)end)
test('missing WORM joint rejects disconnected graph',function()local s=Worm();table.remove(s.connections,1);assert(not Schema.validate(s))end)
test('duplicate element IDs rejected',function()local s=U.copy(sample);s.elements[2].id=s.elements[1].id;assert(not Schema.validate(s))end)
test('unknown joint endpoint rejected',function()local s=U.copy(sample);s.connections={{id='w',a='missing',b=s.elements[1].id,kind='Weld'}};assert(not Schema.validate(s))end)
test('NaN coordinates rejected',function()local s=U.copy(sample);s.elements[1].position[1]=0/0;assert(not Schema.validate(s))end)
test('negative size and unknown material rejected',function()local s=U.copy(sample);s.elements[1].size[1]=-1;assert(not Schema.validate(s));s=U.copy(sample);s.elements[1].material='FakeTitanium';assert(not Schema.validate(s))end)
test('bounds include rotated corners',function()local s=U.copy(sample);table.remove(s.elements,2);s.elements[1].size={10,2,2};s.elements[1].rotation={0,90,0};local b=Schema.bounds(s);near(b.size[1],2);near(b.size[3],10)end)
test('transform preserves immutable original',function()local s=Schema.transform(sample,{mirrorX=true,material='MetalBlock'});eq(sample.elements[2].position[1],2);eq(s.elements[2].position[1],-2);eq(sample.elements[1].material,'WoodBlock')end)
test('unsafe mechanical reflection blocked',function()assert(not Schema.transform(Worm(),{mirrorX=true}))end)
test('JSON format roundtrip preserves hinge control data',function()local s=Worm();local imported=assert(Schema.import(U.copy(s)));eq(#s.connections,#imported.connections);for i,c in ipairs(s.connections)do eq(c.id,imported.connections[i].id);eq(c.role,imported.connections[i].role)end end)
test('LP_BUILD imported mechanics remain flagged',function()local s=assert(Schema.import({Servo={{Position={0,2,0},BindTable={{1}}}}}));eq(s.importedMechanics,true)end)
test('library reports all invalid projects and keeps builtins immutable',function()local l=Library.new();eq(#l.errors,0);assert(#l:list()>40);local ok=l:save(Worm());eq(ok,false);print('LIBRARY_COUNT '..#l:list())end)
test('circle has no duplicate closing endpoint',function()local p=Shapes.circle({radius=12,segments=40,layers=3});eq(#p,120);assert(math.abs(p[1].x-p[40].x)+math.abs(p[1].z-p[40].z)>.01)end)
test('filled circle centre occurs once per layer',function()local p=Shapes.circle({radius=6,layers=2,filled=true});local n=0;for _,e in ipairs(p)do if e.x==0 and e.z==0 then n+=1 end end;eq(n,2)end)
test('config clamps finite values and rejects invalid type',function()local c=assert(Config.validate({ui={width=99999},movement={walk=-50}}));eq(c.ui.width,1200);eq(c.movement.walk,8);assert(not Config.validate({farm={profile='FAKE'}}));assert(not Config.validate({ui={width=0/0}}));eq(Config.validate({}).ui.compact,false)end)
test('profile names reject traversal and Windows reserved names',function()for _,s in ipairs({'../main','C:\\secret','CON','com1','a/b','',string.rep('a',25)})do eq(Config.profileName(s),false)end;assert(Config.profileName('my-profile_2'))end)
test('config invalid import is atomic and backup restores',function()
 local stored={};local codec={encode=function(v)stored.good=U.copy(v);return 'good'end,decode=function(s)if s=='bad' then error('invalid JSON')end;return U.copy(stored.good)end}
 local c=Config.new(codec,{label='test',write=function()end,read=function()return 'bad'end,backup=function()return 'good'end},log);c.data.ui.theme='PURPLE';c:export();assert(not c:import('bad'));eq(c.data.ui.theme,'PURPLE');c.data.ui.theme='BLUE';assert(c:load('a'));eq(c.data.ui.theme,'PURPLE');assert(c:rollback());eq(c.data.ui.theme,'BLUE')
end)
test('six tabs preserve all routes and search uses every word',function()eq(#Nav.order,6);eq(Nav.resolve('DEBUG'),'SETTINGS');eq(Nav.resolve('MOVEMENT'),'PRO');eq(Nav.resolve('SCHEMATICS'),'SHAPES');assert(Nav.matches(' circle  warstwy ','Circle Maker warstwy materiał'));assert(not Nav.matches('circle fly','Circle Maker warstwy'))end)
test('layout remains within 320, 760 and 1280 pixel screens',function()for _,w in ipairs({320,760,1280})do local l=Layout.compute(w,600,960,650,false);assert(l.width<=w-8);assert(l.contentX+l.contentWidth<=l.width);assert(l.contentHeight>100);assert(l.contentWidth>=250 or w==320)end end)
test('runtime closes real mock connections and prevents later events',function()local callbacks={};local signal={Connect=function(_,fn)local c={Connected=true};function c:Disconnect()self.Connected=false end;table.insert(callbacks,{c,fn});return c end};local rt=runtime();local n=0;rt:connect(signal,function()n+=1 end);callbacks[1][2]();eq(n,1);rt:close();eq(callbacks[1][1].Connected,false);callbacks[1][2]();eq(n,1);eq(rt:counts().connections,0)end)
test('runtime does not release another owner or race outstanding jobs',function()local rt=runtime();assert(rt:acquire('Builder'));eq(rt:acquire('Farm'),false);rt:release('Farm');eq(rt.lock,'Builder');rt:job('Builder',function()return true end,spawn);rt:release('Builder');eq(rt:acquire('Farm'),false);flush();assert(rt:acquire('Farm'))end)
local function farmFixture()
 now=0;queue={};local rt=runtime();local ad={capabilities={farm=true},minFarmInterval=.3,cancel=function()end,farmStep=function(_,stage)return {ok=true,stage=stage,completed=stage==2}end};local settings={profile='SONIC',retryLimit=1,stopAfter=0};return Farm.new(rt,ad,settings,log,spawn),ad,rt
end
test('farm has one controller and pause blocks further dispatch',function()local f= farmFixture();assert(f:start());eq(f:start(),false);f:tick();assert(f:pause());flush();f:tick();eq(f.state,'PAUSED');eq(#queue,0);assert(f:resume());now=1;f:tick();eq(#queue,1)end)
test('farm STOP ignores delayed server receipt',function()local f=farmFixture();f:start();f:tick();f:stop();flush();f:tick();eq(f.stage,0);eq(f.stats.completed,0);eq(f.state,'STOPPED')end)
test('farm counts confirmed cycles and measured duration',function()local f=farmFixture();eq(f:summary().average,nil);f:start();f:tick();flush();now=.2;f:tick();now=.6;f:tick();flush();now=.8;f:tick();eq(f.stats.completed,1);near(f:summary().average,.8)end)
test('farm retry count is bounded and records failures',function()local f,ad=farmFixture();ad.farmStep=function()return {ok=false,error='Server rejected'}end;f:start();f:tick();flush();f:tick();eq(f.state,'RETRY');now=2;f:tick();flush();f:tick();eq(f.state,'ERROR');eq(f.stats.failed,2)end)
test('late failure while paused cannot restart the farm',function()local f,ad=farmFixture();ad.farmStep=function()return {ok=false,error='Rejected'}end;f:start();f:tick();f:pause();flush();f:tick();eq(f.state,'PAUSED');now=20;f:tick();eq(#queue,0);assert(f:resume());f:tick();eq(#queue,1)end)
test('farm profiles differ and server minimum is respected',function()local prev=10;for _,name in ipairs({'NORMAL','FAST','TURBO','HYPER','LIGHTNING','SONIC'})do assert(Farm.profiles[name]<prev);prev=Farm.profiles[name]end;local f,ad=farmFixture();ad.minFarmInterval=2;f:start();f:tick();flush();f:tick();eq(f.nextAt,2)end)
local function builderFixture()
 now=0;queue={};local rt=runtime();local ad={capabilities={build=true,mechanics=true},zone={size={120,200,120}},chunkSize=1,cancel=function()end,newId=function()return 'build_id'end,beginBuild=function()return {ok=true,transaction='tx'}end,placeChunk=function(_,_,first)return {ok=true,ids={sample.elements[first].id}}end,commitBuild=function()return {ok=true,count=2,connected=true}end,buildStatus=function()return {ok=true,state='cancelled'}end}
 local b=Builder.new(rt,ad,log,spawn);assert(b:select(sample));return b,ad,rt,Inventory.snapshot({WoodBlock=100},'fixture')
end
test('preview has no fake placed progress and absent API blocks build',function()local b,ad,_,inv=builderFixture();eq(b.placed,0);ad.capabilities.build=nil;eq(b:start(inv),false);eq(#queue,0)end)
test('builder uses exact receipts, commits, releases lock',function()local b,_,rt,inv=builderFixture();assert(b:start(inv));for _=1,8 do flush();b:tick()end;eq(b.state,'COMPLETED');eq(b.placed,2);eq(rt.lock,nil)end)
test('wrong receipt stops at zero and never commits',function()local b,ad,_,inv=builderFixture();ad.placeChunk=function()return {ok=true,ids={'WRONG'}}end;b:start(inv);for _=1,4 do flush();b:tick()end;eq(b.state,'ERROR');eq(b.placed,0)end)
test('cancel waits for stale begin then authoritative cancellation',function()local b,_,rt,inv=builderFixture();b:start(inv);b:cancel();eq(rt.lock,'Builder');flush();b:tick();eq(b.state,'CANCELLING');b:tick();flush();b:tick();eq(b.state,'CANCELLED');eq(rt.lock,nil)end)
test('commit wins race is reported as actually completed',function()local b,ad,_,inv=builderFixture();ad.buildStatus=function()return {ok=true,state='committed',count=2}end;b:start(inv);for _=1,3 do flush();b:tick()end;eq(b.state,'COMMITTING');b:cancel();flush();b:tick();b:tick();flush();b:tick();eq(b.state,'COMPLETED');eq(b.placed,2)end)
test('builder undo redo preserves source geometry',function()local b=builderFixture();local options=U.copy(b.options);options.mirrorX=true;assert(b:edit(options));eq(b.schema.elements[2].position[1],-2);assert(b:undo());eq(b.schema.elements[2].position[1],2);assert(b:redo());eq(b.source.elements[2].position[1],2)end)
test('explosive overlap plan stays assistant only',function()local b,_,_,inv=builderFixture();assert(b:select(Bomb(3)));eq(b:start(inv),false);eq(#queue,0)end)
test('adapter timeout retains in-flight guard',function()
 now=0;queue={};local a=Adapter.new({userId=1,placeId=2,clock=function()return now end,spawn=spawn,wait=function(dt)now+=dt end,alive=function()return true end});a.remote={InvokeServer=function()return {ok=true}end};local r=a:inventory();eq(r.ok,false);assert(a.pending);eq(a:inventory().ok,false);flush();eq(a.pending,nil)
end)
test('adapter rejects another user identity in hello',function()
 local a=Adapter.new({userId=1,placeId=2,clock=function()return 0 end,spawn=function(fn)fn()end,wait=function()end,alive=function()return true end});local replica={FindFirstChild=function(_,name)return {IsA=function()return true end,InvokeServer=function()return {ok=true,authorized=true,protocol=1,userId=3,placeId=2,session='s'}end}end};eq(a:connect(replica),false);eq(a.session,nil)
end)
print(string.format('RESULT %d passed / %d failed / %d total',total-failed,failed,total));assert(failed==0,'Test failures')
