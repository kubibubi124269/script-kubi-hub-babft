test('export includes global yaw and preserves native hinge axes',function()
 local s=Worm();local out=assert(Schema.bakeYaw(s,90));local expected=U.rotate(s.elements[1].position,{0,90,0});for i=1,3 do near(out.elements[1].position[i],expected[i])end
 for i,c in ipairs(s.connections)do if c.kind=='Hinge'then local axis=U.rotate(c.axis,{0,90,0});for j=1,3 do near(out.connections[i].axis[j],axis[j])end end end
 eq(s.elements[1].rotation[2],0);assert(Schema.validate(out))
end)
test('baked yaw composes existing XYZ rotations including gimbal lock',function()
 for _,rotation in ipairs({{10,20,30},{90,0,45},{0,90,10},{0,-90,0},{-35,62,120}})do
  for _,yaw in ipairs({0,45,90,180,270})do local s=U.copy(sample);s.elements[1].rotation=rotation;local out=assert(Schema.bakeYaw(s,yaw));local m=U.matrix(out.elements[1].rotation)
   for i,v in ipairs({{1,0,0},{0,1,0},{0,0,1}})do local expected=U.rotate(U.rotate(v,rotation),{0,yaw,0});local actual=U.rotate(v,out.elements[1].rotation);for j=1,3 do near(actual[j],expected[j])end end
  end
 end
end)
