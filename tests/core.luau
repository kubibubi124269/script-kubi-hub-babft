local Config=require('../src/config/Config')(U,Inventory)
local Schema=require('../src/schematics/Schema')(U,Inventory)
local Shapes=require('../src/schematics/LegacyShapes')
local Worm=require('../src/schematics/WormMK2')(Schema)
local Bomb=require('../src/schematics/DynamiteStack')(Schema)
local Library=require('../src/schematics/Library')(U,Schema,Shapes,require('../src/schematics/LegacyPlans'),Worm,Bomb)
